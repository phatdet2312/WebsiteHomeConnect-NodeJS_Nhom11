<div style="background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:40px 0 30px;">
  <div class="container" style="max-width:1000px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <h1 style="font-size:1.8rem;font-weight:800;color:white;margin:0 0 6px;"><i class="fas fa-file-invoice-dollar me-3" style="opacity:.8;"></i>Lịch sử Hóa đơn</h1>
        <p style="color:rgba(255,255,255,.8);margin:0;font-size:.9rem;">Quản lý toàn bộ giao dịch thanh toán Hợp đồng</p>
      </div>
      <a href="/thanh-toan-hop-dong" class="btn-hc-primary" style="background:rgba(255,255,255,0.2); border:1px solid rgba(255,255,255,0.4); color:white;">
        <i class="fas fa-cubes me-2"></i>Xem loại thanh toán
      </a>
    </div>
  </div>
</div>

<div class="container py-4" style="max-width:1000px;">
    <div class="filter-bar">
        <button class="filter-btn active" data-filter="all">Tất cả</button>
        <button class="filter-btn" data-filter="ok">Thành công</button>
        <button class="filter-btn" data-filter="wait">Đang / Chờ xử lý</button>
        <button class="filter-btn" data-filter="fail">Thất bại / Đã hủy</button>
    </div>
 
    <div id="loadingState" class="text-center py-5">
        <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải dữ liệu...</p></div>
    </div>
  
    <div id="invoiceList" class="d-none" style="display:flex;flex-direction:column;gap:16px;"></div>
</div>

<style>
.filter-bar { display:flex; gap:10px; margin-bottom:24px; padding-bottom:16px; border-bottom:1px solid var(--border-light); overflow-x:auto; }
.filter-btn { background:var(--bg-white); border:1px solid var(--border-light); padding:8px 16px; border-radius:20px; font-size:.85rem; font-weight:600; color:var(--text-muted); cursor:pointer; transition:all .2s; white-space:nowrap; }
.filter-btn:hover { border-color:var(--primary); color:var(--primary); }
.filter-btn.active { background:var(--primary); color:white; border-color:var(--primary); }

.inv-card { background:var(--bg-white); border-radius:16px; border:1px solid var(--border-light); box-shadow:var(--shadow-sm); overflow:hidden; }
.inv-header { padding:20px 24px; display:flex; align-items:center; justify-content:space-between; background:var(--bg-white); cursor:pointer; transition:background .2s; }
.inv-header:hover { background:var(--bg-soft); }
.inv-icon { width:48px; height:48px; border-radius:12px; background:var(--bg-soft); display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:var(--primary); flex-shrink:0; }
.inv-id { font-size:1.1rem; font-weight:800; color:var(--text); margin-bottom:4px; }
.inv-date { font-size:.8rem; color:var(--text-muted); font-weight:500; }
.inv-amount { font-size:1.25rem; font-weight:900; color:var(--primary); text-align:right; margin-bottom:6px; }

.status-badge { display:inline-block; padding:4px 12px; border-radius:20px; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.05em; }
.badge-ok { background:#dcfce7; color:#15803d; }
.badge-wait { background:#fef9c3; color:#a16207; }
.badge-fail { background:#fee2e2; color:#b91c1c; }

.inv-body { padding:24px; background:var(--bg-soft); border-top:1px solid var(--border-light); display:none; }
.inv-table { width:100%; font-size:.85rem; background:white; border-radius:12px; overflow:hidden; border:1px solid var(--border-light); }
.inv-table th { padding:12px; background:var(--bg-soft); color:var(--text-muted); font-weight:700; border-bottom:1px solid var(--border-light); }
.inv-table td { padding:12px; border-bottom:1px solid var(--border-light); font-weight:600; vertical-align: middle; }
.inv-table tr:last-child td { border-bottom:none; }

.timeline { position:relative; margin-top:10px; padding-left:20px; }
.timeline-item { position:relative; padding-bottom:20px; }
.timeline-item::before { content:''; position:absolute; left:-20px; top:4px; width:12px; height:12px; border-radius:50%; background:var(--primary); border:2px solid white; box-shadow:0 0 0 2px var(--primary-light); z-index:2; }
.timeline-item::after { content:''; position:absolute; left:-15px; top:16px; bottom:-4px; width:2px; background:var(--border-light); z-index:1; }
.timeline-item:last-child::after { display:none; }
.timeline-item:last-child { padding-bottom:0; }
.tl-time { font-size:.75rem; color:var(--text-muted); font-weight:600; margin-bottom:2px; }
.tl-status { font-size:.9rem; font-weight:800; color:var(--text); }
.tl-note { font-size:.8rem; color:var(--text-secondary); margin-top:4px; background:white; padding:8px 12px; border-radius:8px; border:1px solid var(--border-light); display:inline-block;}
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
let globalInvoices = [];

fetch('/hoa-don-hop-dong/api/history')
  .then(r => r.json())
  .then(res => {
    document.getElementById('loadingState').classList.add('d-none');
    const el = document.getElementById('invoiceList');
    el.classList.remove('d-none');

    if(!res.success || !res.data.length){
      el.innerHTML = `<div class="hc-empty"><div class="empty-icon"><i class="fas fa-box-open"></i></div><div class="empty-title">Chưa có giao dịch nào</div></div>`;
      return;
    }
    
    globalInvoices = res.data;
    renderInvoices('all');
  });

function renderInvoices(filterType) {
    const el = document.getElementById('invoiceList');
    let filtered = globalInvoices;

    if(filterType === 'ok') filtered = globalInvoices.filter(i => i.trangThaiHienTai.toLowerCase().includes('đã thanh toán') || i.trangThaiHienTai.toLowerCase().includes('thành công'));
    else if(filterType === 'wait') filtered = globalInvoices.filter(i => i.trangThaiHienTai.toLowerCase().includes('đang') || i.trangThaiHienTai.toLowerCase().includes('chờ'));
    else if(filterType === 'fail') filtered = globalInvoices.filter(i => i.trangThaiHienTai.toLowerCase().includes('hủy') || i.trangThaiHienTai.toLowerCase().includes('thất bại') || i.trangThaiHienTai.toLowerCase().includes('lỗi'));

    if(!filtered.length) {
        el.innerHTML = `<div class="text-center py-5 text-muted">Không có hóa đơn nào phù hợp với bộ lọc.</div>`;
        return;
    }

    el.innerHTML = filtered.map((hd, idx) => {
        let typeClass = 'badge-wait';
        let iconHtml = '<i class="fas fa-hourglass-half"></i>';
        
        if(hd.trangThaiHienTai.toLowerCase().includes('đã thanh toán') || hd.trangThaiHienTai.toLowerCase().includes('thành công')) {
            typeClass = 'badge-ok';
            iconHtml = '<i class="fas fa-check-circle text-success"></i>';
        } else if(hd.trangThaiHienTai.toLowerCase().includes('hủy') || hd.trangThaiHienTai.toLowerCase().includes('thất bại')) {
            typeClass = 'badge-fail';
            iconHtml = '<i class="fas fa-times-circle text-danger"></i>';
        }

        const tableRows = hd.chiTiet.map(ct => `
            <tr>
                <td>${ct.tenLoaiTT} <br><small style="color:var(--text-muted);font-weight:500;">${ct.viTri}</small></td>
                <td>${ct.tenKy}</td>
                <td style="text-align:center;">${ct.sl}</td>
                <td style="text-align:right;color:var(--primary);">${Number(ct.donGia).toLocaleString('vi-VN')} ₫</td>
            </tr>
        `).join('');

        const timelineHtml = hd.lichSu.map(ls => `
            <div class="timeline-item">
                <div class="tl-time">${new Date(ls.thoiGian).toLocaleString('vi-VN')}</div>
                <div class="tl-status">${ls.trangThai}</div>
                ${ls.ghiChu ? `<div class="tl-note">${ls.ghiChu}</div>` : ''}
            </div>
        `).join('');

        return `
        <div class="inv-card">
            <div class="inv-header" onclick="$('#body_${hd.maHDHD}').slideToggle()">
                <div style="display:flex;align-items:center;gap:16px;">
                    <div class="inv-icon">${iconHtml}</div>
                    <div>
                        <div class="inv-id">HÓA ĐƠN #${hd.maHDHD}</div>
                        <div class="inv-date">${new Date(hd.ngayThanhToan).toLocaleString('vi-VN')} • <i class="fas fa-credit-card mx-1"></i> ${hd.phuongThuc}</div>
                    </div>
                </div>
                <div style="text-align:right;">
                    <div class="inv-amount">${hd.tongTien.toLocaleString('vi-VN')} ₫</div>
                    <span class="status-badge ${typeClass}">${hd.trangThaiHienTai}</span>
                </div>
            </div>
            
            <div class="inv-body" id="body_${hd.maHDHD}">
                <div class="row g-4">
                    <div class="col-md-7">
                        <h6 style="font-weight:800;color:var(--text);margin-bottom:16px;"><i class="fas fa-list-ul me-2 text-primary"></i>Chi tiết thanh toán</h6>
                        <table class="inv-table">
                            <thead><tr><th>Loại TT</th><th>Kỳ</th><th style="text-align:center;">SL</th><th style="text-align:right;">Đơn giá</th></tr></thead>
                            <tbody>${tableRows}</tbody>
                        </table>
                    </div>
                    <div class="col-md-5">
                        <h6 style="font-weight:800;color:var(--text);margin-bottom:16px;"><i class="fas fa-history me-2 text-primary"></i>Nhật ký giao dịch</h6>
                        <div class="timeline">${timelineHtml}</div>
                    </div>
                </div>
            </div>
        </div>
        `;
    }).join('');
}

$('.filter-btn').on('click', function() {
    $('.filter-btn').removeClass('active');
    $(this).addClass('active');
    renderInvoices($(this).data('filter'));
});
</script>