<!-- views/admin/quanLySucKhoe/display.ejs -->
<div class="admin-page-header">
  <div><h4>Chi tiết Chỉ số Sức khỏe <span style="color:var(--primary);">#<%= item.MaChiSo %></span></h4><p><%= item.TenChiSo %></p></div>
  <a href="/admin/quan-ly-suc-khoe" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
</div>
<div style="max-width:500px;display:flex;flex-direction:column;gap:14px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-heartbeat me-2" style="color:#dc2626;"></i>Thông tin</div>
    </div>
    <div style="padding:20px 24px;">
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
        <span style="background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;">#<%= item.MaChiSo %></span>
        <span style="background:#e0f2fe;color:#0369a1;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><%= item.GiaTri %> <%= item.DonVi || '' %></span>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div>
          <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Khách hàng</div>
          <% if (item.KhachHang) { %>
            <a href="/admin/quan-ly-suc-khoe/khach-hang/<%= item.KhachHang.MaKH %>" style="font-weight:700;color:var(--primary);text-decoration:none;font-size:.95rem;"><%= item.KhachHang.TenKH %></a>
          <% } else { %>
            <div style="font-weight:600;color:var(--text);">KH#<%= item.MaKH %></div>
          <% } %>
        </div>
        <div>
          <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Ngày ghi</div>
          <div style="font-weight:600;color:var(--text);"><%= item.NgayRecord ? new Date(item.NgayRecord).toLocaleDateString('vi-VN') : '—' %></div>
        </div>
        <div style="grid-column:span 2;">
          <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:4px;">Tên chỉ số</div>
          <div style="font-size:1.1rem;font-weight:800;color:var(--text);"><%= item.TenChiSo %></div>
        </div>
      </div>
    </div>
  </div>
  <% if (item.KhachHang) { %>
  <a href="/admin/quan-ly-suc-khoe/khach-hang/<%= item.KhachHang.MaKH %>" class="btn-ghost" style="align-self:flex-start;">
    <i class="fas fa-list me-2"></i>Xem tất cả chỉ số của khách hàng này
  </a>
  <% } %>
</div>
