
<!-- views/admin/banner/add.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Thêm Banner mới</h4>
    <p>Tạo banner quảng cáo cho trang chủ</p>
  </div>
  <a href="/admin/banner" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
</div>

<% if (errors && errors.length > 0) { %>
<div class="hc-toast hc-toast-danger" style="position:static;margin-bottom:16px;">
  <i class="fas fa-exclamation-circle"></i>
  <div><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
</div>
<% } %>

<div style="max-width:640px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-images me-2" style="color:#ca8a04;"></i>Thông tin Banner</div>
    </div>
    <div style="padding:24px;">
      <form method="POST" action="/admin/banner/add" enctype="multipart/form-data">
        <div style="margin-bottom:16px;">
          <label class="filter-label">Tên Banner <span style="color:var(--danger);">*</span></label>
          <input type="text" name="TenAQC" class="hc-input" placeholder="Nhập tên banner..."
            value="<%= item ? item.TenAQC : '' %>" required>
        </div>
        <div style="margin-bottom:16px;">
          <label class="filter-label">Hình ảnh Banner</label>
          <input type="file" name="UrlAnh" class="hc-input" accept="image/*" onchange="previewImage(this)" style="padding:8px 14px;">
          <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">Định dạng: JPG, PNG, GIF, WebP. Tối đa 5MB.</div>
          <div id="imgPreviewBox" style="display:none;margin-top:12px;">
            <img id="imgPreview" src="" alt="Preview" style="max-width:300px;max-height:150px;object-fit:contain;border-radius:var(--radius-md);border:1.5px solid var(--border);">
          </div>
        </div>
        <div style="margin-bottom:24px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:.875rem;font-weight:600;color:var(--text);">
            <input type="checkbox" name="TTHienThi" id="ttHienThi" checked
              style="accent-color:var(--primary);width:17px;height:17px;">
            Hiển thị banner trên trang chủ
          </label>
        </div>
        <div style="display:flex;gap:10px;">
          <button type="submit" class="btn-hc-primary"><i class="fas fa-save me-2"></i>Lưu Banner</button>
          <a href="/admin/banner" class="btn-ghost"><i class="fas fa-times me-2"></i>Hủy</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function previewImage(input) {
  const preview = document.getElementById('imgPreview');
  const box = document.getElementById('imgPreviewBox');
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => { preview.src = e.target.result; box.style.display = 'block'; };
    reader.readAsDataURL(input.files[0]);
  } else { box.style.display = 'none'; }
}
</script>
