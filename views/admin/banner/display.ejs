<!-- views/admin/banner/display.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Chi tiết Banner <span style="color:var(--primary);">#<%= item.MaAQC %></span></h4>
    <p><%= item.TenAQC %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/banner/update/<%= item.MaAQC %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/banner" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>

<div style="max-width:640px;display:flex;flex-direction:column;gap:16px;">
  <div class="table-card" style="overflow:hidden;">
    <% if (item.UrlAnh) { %>
      <div style="background:#0a1628;padding:20px;text-align:center;">
        <img src="<%= item.UrlAnh %>" alt="<%= item.TenAQC %>"
          style="max-height:240px;max-width:100%;object-fit:contain;border-radius:var(--radius-md);">
      </div>
    <% } else { %>
      <div style="background:var(--bg-soft);padding:48px;text-align:center;">
        <i class="fas fa-images" style="font-size:3rem;color:var(--text-muted);opacity:.3;display:block;margin-bottom:12px;"></i>
        <p style="color:var(--text-muted);font-size:.84rem;margin:0;">Chưa có hình ảnh</p>
      </div>
    <% } %>
    <div style="padding:20px 24px;">
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
        <span style="background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;">#<%= item.MaAQC %></span>
        <% if (item.TTHienThi) { %>
          <span style="background:#dcfce7;color:#15803d;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-eye me-1"></i>Đang hiển thị</span>
        <% } else { %>
          <span style="background:var(--bg-soft);color:var(--text-muted);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:600;"><i class="fas fa-eye-slash me-1"></i>Đang ẩn</span>
        <% } %>
      </div>
      <div>
        <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;">Tên Banner</div>
        <div style="font-size:1.2rem;font-weight:800;color:var(--text);"><%= item.TenAQC %></div>
      </div>
    </div>
  </div>

  <div style="display:flex;gap:10px;">
    <a href="/admin/banner/update/<%= item.MaAQC %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/banner/delete/<%= item.MaAQC %>" class="btn-ghost" style="color:var(--danger);border-color:var(--danger);"><i class="fas fa-trash me-2"></i>Xóa</a>
    <a href="/admin/banner" class="btn-ghost" style="margin-left:auto;"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
