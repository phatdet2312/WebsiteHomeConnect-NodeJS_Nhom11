<!-- views/admin/danhMucNoiThat/display.ejs -->
<div class="admin-page-header">
  <div><h4>Chi tiết Danh mục <span style="color:var(--primary);">#<%= item.MaDMNT %></span></h4><p><%= item.TenDMNT %></p></div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/danh-muc-noi-that/update/<%= item.MaDMNT %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/danh-muc-noi-that" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
<div style="max-width:500px;display:flex;flex-direction:column;gap:14px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-couch me-2" style="color:#7c3aed;"></i>Thông tin</div>
    </div>
    <div style="padding:20px 24px;">
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:16px;">
        <span style="background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;">#<%= item.MaDMNT %></span>
        <% if (item.TTHienThi) { %>
          <span style="background:#dcfce7;color:#15803d;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-eye me-1"></i>Hiển thị</span>
        <% } else { %>
          <span style="background:var(--bg-soft);color:var(--text-muted);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:600;"><i class="fas fa-eye-slash me-1"></i>Đang ẩn</span>
        <% } %>
        <% if (item.TTDeXuat) { %>
          <span style="background:#fef9c3;color:#a16207;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-star me-1"></i>Đề xuất</span>
        <% } %>
      </div>
      <div>
        <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;">Tên Danh mục</div>
        <div style="font-size:1.15rem;font-weight:800;color:var(--text);"><%= item.TenDMNT %></div>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;">
    <a href="/admin/danh-muc-noi-that/update/<%= item.MaDMNT %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/danh-muc-noi-that/delete/<%= item.MaDMNT %>" class="btn-ghost" style="color:var(--danger);border-color:var(--danger);"><i class="fas fa-trash me-2"></i>Xóa</a>
    <a href="/admin/danh-muc-noi-that" class="btn-ghost" style="margin-left:auto;"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
