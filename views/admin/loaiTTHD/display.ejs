<!-- views/admin/loaiTTHD/display.ejs -->
<div class="admin-page-header">
  <div><h4>Chi tiết Loại Tiến trình <span style="color:var(--primary);">#<%= item.MaLoaiTT %></span></h4><p><%= item.TenLoaiTT %></p></div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/loai-tt-hd/update/<%= item.MaLoaiTT %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/loai-tt-hd" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
<div style="max-width:500px;display:flex;flex-direction:column;gap:14px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-list-alt me-2" style="color:#0061ff;"></i>Thông tin</div>
    </div>
    <div style="padding:20px 24px;">
      <% if (item.UrlIcon) { %>
        <div style="text-align:center;margin-bottom:20px;">
          <img src="<%= item.UrlIcon %>" alt="<%= item.TenLoaiTT %>" style="width:80px;height:80px;object-fit:cover;border-radius:16px;border:1.5px solid var(--border-light);">
        </div>
      <% } %>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
        <span style="background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;">#<%= item.MaLoaiTT %></span>
        <% if (item.TTHienThi) { %>
          <span style="background:#dcfce7;color:#15803d;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-eye me-1"></i>Hiển thị</span>
        <% } else { %>
          <span style="background:var(--bg-soft);color:var(--text-muted);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:600;"><i class="fas fa-eye-slash me-1"></i>Đang ẩn</span>
        <% } %>
      </div>
      <div>
        <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;">Tên Loại</div>
        <div style="font-size:1.15rem;font-weight:800;color:var(--text);"><%= item.TenLoaiTT %></div>
      </div>
    </div>
  </div>
  <div style="display:flex;gap:10px;">
    <a href="/admin/loai-tt-hd/update/<%= item.MaLoaiTT %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/loai-tt-hd/delete/<%= item.MaLoaiTT %>" class="btn-ghost" style="color:var(--danger);border-color:var(--danger);"><i class="fas fa-trash me-2"></i>Xóa</a>
    <a href="/admin/loai-tt-hd" class="btn-ghost" style="margin-left:auto;"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
