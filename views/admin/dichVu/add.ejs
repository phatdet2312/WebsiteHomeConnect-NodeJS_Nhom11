<div class="admin-page-header">
  <div>
    <h4>Thêm Dịch vụ mới</h4>
    <p>Tạo dịch vụ trong hệ thống hoàn toàn qua API</p>
  </div>
  <a href="/admin/dich-vu" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
</div>

<div style="max-width:600px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-plus-circle me-2" style="color:#7c3aed;"></i>Thông tin dịch vụ</div>
    </div>
    <div style="padding:24px;">
      <form id="addForm" onsubmit="submitForm(event)">
        <div style="margin-bottom:16px;">
          <label class="filter-label">Tên Dịch vụ <span style="color:var(--danger);">*</span></label>
          <input type="text" id="TenDV" name="TenDV" class="hc-input" placeholder="Nhập tên dịch vụ..." required>
        </div>
        <div style="margin-bottom:16px;">
          <label class="filter-label">Icon Dịch vụ</label>
          <input type="file" id="UrlIcon" name="UrlIcon" class="hc-input" accept="image/*" onchange="previewIcon(this)" style="padding:8px 14px;">
          <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">Khuyến nghị ảnh vuông (VD: 64x64px).</div>
          <div id="iconPreviewBox" style="display:none;margin-top:12px;">
            <img id="iconPreview" src="" alt="Preview" style="width:80px;height:80px;object-fit:cover;border-radius:var(--radius-md);border:1.5px dashed var(--primary);">
          </div>
        </div>
        <div style="margin-bottom:24px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:.875rem;font-weight:600;color:var(--text);">
            <input type="checkbox" id="TTHienThi" name="TTHienThi" checked style="accent-color:var(--primary);width:18px;height:18px;">
            Hiển thị công khai trên Website
          </label>
        </div>
        <div style="display:flex;gap:10px;">
            <button type="submit" id="submitBtn" class="btn-hc-primary"><i class="fas fa-save me-2"></i>Lưu Dịch Vụ</button>
            <a href="/admin/dich-vu" class="btn-ghost"><i class="fas fa-times me-2"></i>Hủy</a>
        </div>
      </form>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
function previewIcon(input) {
  const preview = document.getElementById('iconPreview');
  const box = document.getElementById('iconPreviewBox');
  if (input.files && input.files[0]) {
    const reader = new FileReader();
    reader.onload = e => { preview.src = e.target.result; box.style.display = 'block'; };
    reader.readAsDataURL(input.files[0]);
  } else { box.style.display = 'none'; }
}

async function submitForm(e) {
    e.preventDefault();

    const result = await Swal.fire({
        title: 'Xác nhận thêm mới?',
        text: "Dịch vụ sẽ được tạo và lưu vào hệ thống.",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#0061ff',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
    });

    if (!result.isConfirmed) return;

    const btn = document.getElementById('submitBtn');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang lưu...';
    btn.disabled = true;

    const formData = new FormData();
    formData.append('TenDV', document.getElementById('TenDV').value.trim());
    formData.append('TTHienThi', document.getElementById('TTHienThi').checked);
    
    const fileInput = document.getElementById('UrlIcon');
    if(fileInput.files.length > 0) formData.append('UrlIcon', fileInput.files[0]);

    try {
        const res = await fetch('/admin/dich-vu/api/add', { method: 'POST', body: formData });
        const data = await res.json();
        
        if (data.success) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: data.message, showConfirmButton: false, timer: 1500 }).then(() => {
                window.location.href = '/admin/dich-vu';
            });
        } else {
            throw new Error(data.message);
        }
    } catch(err) {
        Swal.fire('Lỗi!', err.message, 'error');
        btn.innerHTML = '<i class="fas fa-save me-2"></i>Lưu Dịch Vụ';
        btn.disabled = false;
    }
}
</script>
<style>.filter-label { display:block; font-size:.72rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:5px; }</style>