<div class="admin-page-header">
  <div>
    <h4>Chi tiết Dịch vụ <span style="color:var(--primary);">#<%= id %></span></h4>
    <p id="headerTitle">Đang tải...</p>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/dich-vu/update/<%= id %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Sửa</a>
    <a href="/admin/dich-vu" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>

<div id="loadingArea" style="padding:40px; text-align:center;">
    <i class="fas fa-circle-notch fa-spin fa-3x" style="color:var(--primary);"></i>
</div>

<div id="detailArea" style="max-width:560px;display:none;flex-direction:column;gap:16px;">
  <div class="table-card" style="overflow:hidden;">
    <div style="height:100px; background:linear-gradient(135deg, var(--primary), #8b5cf6);"></div>
    <div style="padding:0 24px 24px; position:relative; text-align:center; margin-top:-40px;">
        <div id="iconContainer" style="width:80px;height:80px;margin:0 auto 16px;border-radius:16px;background:#fff;padding:4px;box-shadow:0 4px 15px rgba(0,0,0,0.1);">
            <img id="detailIcon" src="https://via.placeholder.com/80" style="width:100%;height:100%;object-fit:cover;border-radius:12px;">
        </div>
        <div id="statusBadge" style="position:absolute; top:50px; right:24px;"></div>
        
        <h3 id="detailName" style="font-weight:800; color:var(--text); font-size:1.4rem; margin-bottom:4px;"></h3>
        <p style="color:var(--text-muted); font-size:.85rem; font-weight:600;"><i class="fas fa-hashtag me-1"></i><span id="detailId"></span></p>
    </div>
    
    <div style="border-top:1px solid var(--border-light); padding:16px 24px; display:flex; justify-content:space-around; background:var(--bg-soft);">
        <div style="text-align:center;">
            <div style="font-size:.7rem;color:var(--text-muted);font-weight:700;text-transform:uppercase;">Ngày tạo</div>
            <div style="font-weight:600;font-size:.9rem;color:var(--text);" id="detailCreated">Không rõ</div>
        </div>
        <div style="width:1px; background:var(--border-light);"></div>
        <div style="text-align:center;">
            <div style="font-size:.7rem;color:var(--text-muted);font-weight:700;text-transform:uppercase;">Căn hộ đang dùng</div>
            <div style="font-weight:800;font-size:1.1rem;color:var(--primary);"><a href="/admin/ct-dich-vu/chi-tiet/<%= id %>" style="text-decoration:none;"><i class="fas fa-link me-1"></i>Xem</a></div>
        </div>
    </div>
  </div>

  <div style="display:flex;gap:10px;">
    <button onclick="deleteThis()" class="btn-hc-primary" style="background:var(--danger);border-color:var(--danger);"><i class="fas fa-trash me-2"></i>Xóa Dịch Vụ</button>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
const serviceId = "<%= id %>";

document.addEventListener('DOMContentLoaded', async () => {
    try {
        const res = await fetch('/admin/dich-vu/api/detail/' + serviceId);
        const json = await res.json();
        
        if(!json.success) throw new Error(json.message);
        const data = json.data;

        document.getElementById('headerTitle').textContent = data.TenDV;
        document.getElementById('detailName').textContent = data.TenDV;
        document.getElementById('detailId').textContent = data.MaDV;
        
        if (data.UrlIcon) {
            document.getElementById('detailIcon').src = data.UrlIcon;
        } else {
            document.getElementById('iconContainer').innerHTML = `<div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--bg-soft);border-radius:12px;"><i class="fas fa-concierge-bell fa-2x text-muted"></i></div>`;
        }

        const badge = document.getElementById('statusBadge');
        if (data.TTHienThi) {
            badge.innerHTML = `<span style="background:#dcfce7;color:#15803d;padding:5px 14px;border-radius:20px;font-size:.75rem;font-weight:700;box-shadow:0 2px 5px rgba(21,128,61,0.2);"><i class="fas fa-check-circle me-1"></i>Đang hiển thị</span>`;
        } else {
            badge.innerHTML = `<span style="background:#f1f5f9;color:#64748b;padding:5px 14px;border-radius:20px;font-size:.75rem;font-weight:700;border:1px solid #cbd5e1;"><i class="fas fa-eye-slash me-1"></i>Đang ẩn</span>`;
        }

        document.getElementById('loadingArea').style.display = 'none';
        document.getElementById('detailArea').style.display = 'flex';
        
    } catch(err) {
        Swal.fire('Lỗi', err.message, 'error').then(() => window.location.href = '/admin/dich-vu');
    }
});

function deleteThis() {
    Swal.fire({
        title: 'Xác nhận xóa?',
        text: 'Thao tác không thể khôi phục',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        confirmButtonText: 'Xóa ngay'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const res = await fetch(`/admin/dich-vu/api/delete/${serviceId}`, { method: 'POST' });
            const data = await res.json();
            if(data.success) {
                Swal.fire('Đã xóa!', '', 'success').then(() => window.location.href = '/admin/dich-vu');
            } else Swal.fire('Lỗi', data.message, 'error');
        }
    });
}
</script>