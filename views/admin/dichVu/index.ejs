<div class="admin-page-header">
    <div>
        <h4>Quản lý Dịch vụ</h4>
        <p>Tổng: <span id="totalItemsDisplay">0</span> dịch vụ</p>
    </div>
    <a href="/admin/dich-vu/add" class="btn-hc-primary"><i class="fas fa-plus me-2"></i>Thêm mới</a>
</div>

<div class="table-card mb-3">
    <div class="table-card-header">
        <div class="table-card-title"><i class="fas fa-filter me-2" style="color:var(--primary);"></i>Bộ lọc & Tìm kiếm</div>
    </div>
    <div style="padding:16px 20px;">
        <div class="row g-2 align-items-end position-relative">
            <div class="col-md-5 position-relative">
                <label class="filter-label">Tìm kiếm</label>
                <input type="text" id="searchInput" class="hc-input" placeholder="Nhập từ khóa tìm kiếm..." autocomplete="off">
                <div id="suggestionBox" class="suggestion-dropdown" style="display:none; position:absolute; top:100%; left:0; right:0; background:#fff; box-shadow:0 10px 25px rgba(0,0,0,0.1); border-radius:8px; z-index:100; margin-top:5px; border:1px solid var(--border-light); overflow:hidden;"></div>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Trạng thái</label>
                <select id="statusFilter" class="hc-select">
                    <option value="tatCa">Tất cả</option>
                    <option value="batHienThi" selected>Hiển thị</option>
                    <option value="tatHienThi">Đang ẩn</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Sắp xếp</label>
                <select id="sortFilter" class="hc-select">
                    <option value="macDinh">Mặc định (Mới nhất)</option>
                    <option value="aDenZ">Tên A-Z</option>
                    <option value="zDenA">Tên Z-A</option>
                </select>
            </div>
            <div class="col-md-1">
                <button type="button" onclick="loadData()" class="btn-hc-primary w-100" style="justify-content:center;padding:9px;"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="table-card-header">
        <div style="display:flex;align-items:center;gap:10px;">
            <input type="checkbox" id="selectAllChk" style="accent-color:var(--primary);width:16px;height:16px;">
            <label for="selectAllChk" style="cursor:pointer;font-weight:600;">Chọn tất cả</label>
        </div>
        <div style="display:flex;gap:10px;">
            <button type="button" class="btn-tbl btn-tbl-edit" id="btnBulkHide" style="display:none;"><i class="fas fa-eye-slash"></i> Ẩn</button>
            <button type="button" class="btn-tbl btn-tbl-view" id="btnBulkShow" style="display:none;"><i class="fas fa-eye"></i> Hiện</button>
            <button type="button" class="btn-tbl btn-tbl-delete" id="btnBulkDelete" style="display:none;"><i class="fas fa-trash"></i> Xóa</button>
        </div>
    </div>
    
    <div id="searchMessageArea" style="display:none; background:#fffbe8; border-bottom:1px solid #fde68a; padding:12px 20px; color:#92400e; font-weight:600; font-size:.85rem;"></div>

    <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;min-width:500px;">
            <thead>
                <tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
                    <th style="padding:12px 16px;width:40px;"></th>
                    <th style="padding:12px 16px;font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Mã DV</th>
                    <th style="padding:12px 16px;font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Tên Dịch vụ</th>
                    <th style="padding:12px 16px;font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;text-align:center;">Icon</th>
                    <th style="padding:12px 16px;font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;text-align:center;">Trạng thái</th>
                    <th style="padding:12px 16px;font-size:.75rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;text-align:right;">Thao tác</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr><td colspan="6" style="padding:40px;text-align:center;"><i class="fas fa-circle-notch fa-spin fa-2x text-muted"></i></td></tr>
            </tbody>
        </table>
    </div>
</div>

<div id="paginationArea" style="display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:16px;"></div>

<style>
.filter-label { display:block; font-size:.72rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:5px; }
.suggestion-item { padding:10px 15px; display:flex; align-items:center; gap:10px; cursor:pointer; transition:background .2s; border-bottom:1px solid #eee; }
.suggestion-item:last-child { border-bottom:none; }
.suggestion-item:hover { background:#f8fafc; }
.pg-btn { display:inline-flex; align-items:center; justify-content:center; min-width:34px; height:34px; padding:0 10px; border-radius:8px; border:1.5px solid var(--border); background:var(--bg-white); color:var(--text-secondary); font-size:.82rem; font-weight:600; text-decoration:none; cursor:pointer; transition:all .2s;}
.pg-btn:hover { border-color:var(--primary); color:var(--primary); }
.pg-btn.active { background:var(--primary); border-color:var(--primary); color:white; }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
let currentPage = 1;

document.addEventListener('DOMContentLoaded', () => {
    loadData();

    document.getElementById('statusFilter').addEventListener('change', () => { currentPage = 1; loadData(); });
    document.getElementById('sortFilter').addEventListener('change', () => { currentPage = 1; loadData(); });
    
    const searchInput = document.getElementById('searchInput');
    const suggestionBox = document.getElementById('suggestionBox');
    
    searchInput.addEventListener('input', async (e) => {
        const val = e.target.value.trim();
        if(val.length === 0) { suggestionBox.style.display = 'none'; return; }
        
        try {
            const res = await fetch(`/admin/dich-vu/api/suggestions?term=${encodeURIComponent(val)}&status=${document.getElementById('statusFilter').value}`);
            const data = await res.json();
            if(data.success && data.data.length > 0) {
                suggestionBox.innerHTML = data.data.map(d => `
                    <div class="suggestion-item" onclick="selectSuggestion('${d.TenDV}')">
                        <img src="${d.UrlIcon || 'https://via.placeholder.com/32'}" style="width:32px;height:32px;object-fit:cover;border-radius:4px;border:1px solid #ddd;">
                        <div style="font-size:.85rem;font-weight:600;color:#333;">${d.TenDV}</div>
                    </div>
                `).join('');
                suggestionBox.style.display = 'block';
            } else {
                suggestionBox.style.display = 'none';
            }
        } catch(err) { console.log(err); }
    });

    document.addEventListener('click', (e) => {
        if(!searchInput.contains(e.target) && !suggestionBox.contains(e.target)) {
            suggestionBox.style.display = 'none';
        }
    });

    document.getElementById('selectAllChk').addEventListener('change', (e) => {
        document.querySelectorAll('.row-check').forEach(chk => chk.checked = e.target.checked);
        toggleBulkButtons();
    });

    document.getElementById('btnBulkDelete').addEventListener('click', () => bulkAction('delete'));
    document.getElementById('btnBulkHide').addEventListener('click', () => bulkAction('hide'));
    document.getElementById('btnBulkShow').addEventListener('click', () => bulkAction('show'));
});

function selectSuggestion(name) {
    document.getElementById('searchInput').value = name;
    document.getElementById('suggestionBox').style.display = 'none';
    currentPage = 1;
    loadData();
}

async function loadData() {
    const search = document.getElementById('searchInput').value;
    const status = document.getElementById('statusFilter').value;
    const sort = document.getElementById('sortFilter').value;
    const tbody = document.getElementById('tableBody');
    const msgArea = document.getElementById('searchMessageArea');

    tbody.innerHTML = `<tr><td colspan="6" style="padding:40px;text-align:center;"><i class="fas fa-circle-notch fa-spin fa-2x text-muted"></i></td></tr>`;
    
    try {
        const res = await fetch(`/admin/dich-vu/api/list?page=${currentPage}&search=${encodeURIComponent(search)}&status=${status}&sort=${sort}`);
        const result = await res.json();

        if(!result.success) throw new Error(result.message);

        document.getElementById('totalItemsDisplay').innerText = result.totalItems;

        if(result.message) {
            msgArea.style.display = 'block';
            msgArea.innerHTML = `<i class="fas fa-info-circle me-2"></i>${result.message} <span style="font-weight:400;">Dưới đây là một số dịch vụ gợi ý.</span>`;
            if(result.suggestions && result.suggestions.length > 0) result.data = result.suggestions;
        } else {
            msgArea.style.display = 'none';
        }

        renderTable(result.data);
        renderPagination(result.totalPages);
        document.getElementById('selectAllChk').checked = false;
        toggleBulkButtons();

    } catch (err) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding:40px;text-align:center;color:var(--danger);"><i class="fas fa-exclamation-triangle fa-2x mb-2"></i><br>Lỗi tải dữ liệu: ${err.message}</td></tr>`;
    }
}

function renderTable(data) {
    const tbody = document.getElementById('tableBody');
    if(!data || data.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" style="padding:40px;text-align:center;color:var(--text-muted);"><i class="fas fa-concierge-bell fa-3x" style="opacity:.2;margin-bottom:12px;"></i><br>Không có dịch vụ nào</td></tr>`;
        return;
    }

    tbody.innerHTML = data.map(item => `
        <tr style="border-bottom:1px solid var(--border-light);transition:background .2s;" onmouseover="this.style.background='var(--bg-soft)'" onmouseout="this.style.background=''">
            <td style="padding:12px 16px;"><input type="checkbox" value="${item.MaDV}" class="row-check" onchange="toggleBulkButtons()" style="accent-color:var(--primary);width:16px;height:16px;"></td>
            <td style="padding:12px 16px;"><span class="sb-badge">#${item.MaDV}</span></td>
            <td style="padding:12px 16px;font-weight:600;color:var(--text);">${item.TenDV}</td>
            <td style="padding:12px 16px;text-align:center;">
                ${item.UrlIcon 
                    ? `<img src="${item.UrlIcon}" style="width:36px;height:36px;object-fit:cover;border-radius:8px;border:1px solid var(--border);">` 
                    : `<i class="fas fa-concierge-bell" style="color:var(--text-muted);font-size:1.4rem;"></i>`}
            </td>
            <td style="padding:12px 16px;text-align:center;">
                <span style="cursor:pointer;" onclick="toggleStatus(${item.MaDV}, ${item.TTHienThi})" class="badge ${item.TTHienThi ? 'bg-success' : 'bg-secondary'}">
                    ${item.TTHienThi ? '<i class="fas fa-eye me-1"></i>Hiển thị' : '<i class="fas fa-eye-slash me-1"></i>Đang ẩn'}
                </span>
            </td>
            <td style="padding:12px 16px;text-align:right;">
                <div class="hc-card-actions" style="justify-content:flex-end;">
                    <a href="/admin/dich-vu/display/${item.MaDV}" class="btn-tbl btn-tbl-view" title="Xem"><i class="fas fa-eye"></i></a>
                    <a href="/admin/dich-vu/update/${item.MaDV}" class="btn-tbl btn-tbl-edit" title="Sửa"><i class="fas fa-edit"></i></a>
                    <button onclick="deleteSingle(${item.MaDV}, '${item.TenDV}')" class="btn-tbl btn-tbl-delete" title="Xóa"><i class="fas fa-trash"></i></button>
                </div>
            </td>
        </tr>
    `).join('');
}

function renderPagination(totalPages) {
    const area = document.getElementById('paginationArea');
    if(totalPages <= 1) { area.innerHTML = ''; return; }
    
    let html = '';
    if(currentPage > 1) html += `<button onclick="changePage(${currentPage - 1})" class="pg-btn"><i class="fas fa-chevron-left"></i></button>`;
    for(let i=1; i<=totalPages; i++) {
        html += `<button onclick="changePage(${i})" class="pg-btn ${currentPage === i ? 'active' : ''}">${i}</button>`;
    }
    if(currentPage < totalPages) html += `<button onclick="changePage(${currentPage + 1})" class="pg-btn"><i class="fas fa-chevron-right"></i></button>`;
    area.innerHTML = html;
}

function changePage(p) { currentPage = p; loadData(); }

function toggleBulkButtons() {
    const checked = document.querySelectorAll('.row-check:checked').length;
    const isAny = checked > 0;
    document.getElementById('btnBulkDelete').style.display = isAny ? 'inline-flex' : 'none';
    document.getElementById('btnBulkHide').style.display = isAny ? 'inline-flex' : 'none';
    document.getElementById('btnBulkShow').style.display = isAny ? 'inline-flex' : 'none';
}

// XÓA 1
function deleteSingle(id, name) {
    Swal.fire({
        title: 'Xác nhận xóa?',
        html: `Bạn có chắc muốn xóa dịch vụ <b style="color:var(--danger)">${name}</b> không?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Có, Xóa!',
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const res = await fetch(`/admin/dich-vu/api/delete/${id}`, { method: 'POST' });
                const data = await res.json();
                if(data.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: data.message, showConfirmButton: false, timer: 1500 });
                    loadData();
                } else throw new Error(data.message);
            } catch(err) { Swal.fire('Lỗi!', err.message, 'error'); }
        }
    });
}

// ĐỔI TRẠNG THÁI 1
async function toggleStatus(id, currentStatus) {
    try {
        const formData = new URLSearchParams();
        formData.append('status', !currentStatus);
        
        const res = await fetch(`/admin/dich-vu/api/change-status/${id}`, {
            method: 'POST',
            headers: {'Content-Type': 'application/x-www-form-urlencoded'},
            body: formData.toString()
        });
        const data = await res.json();
        if(data.success) loadData();
        else Swal.fire('Lỗi!', data.message, 'error');
    } catch(err) { Swal.fire('Lỗi!', err.message, 'error'); }
}

// HÀNH ĐỘNG HÀNG LOẠT (BULK) - ĐÃ FIX LỖI OBJECT SHORTHAND
function bulkAction(actionType) {
    const ids = Array.from(document.querySelectorAll('.row-check:checked')).map(cb => cb.value);
    if(ids.length === 0) return;

    let title, text, confirmColor, confirmText, endpoint, bodyData;

    if (actionType === 'delete') {
        title = 'Xóa hàng loạt?';
        text = `Bạn đang chuẩn bị xóa <b>${ids.length}</b> dịch vụ. Thao tác không thể hoàn tác!`;
        confirmColor = '#dc2626'; 
        confirmText = 'Xóa ngay!';
        endpoint = '/admin/dich-vu/api/delete-multiple';
        bodyData = new URLSearchParams({ ids: ids.join(',') });
    } else {
        const isShow = actionType === 'show';
        title = isShow ? 'Hiện hàng loạt?' : 'Ẩn hàng loạt?';
        text = `Bạn có chắc muốn ${isShow ? 'HIỂN THỊ' : 'ẨN'} <b>${ids.length}</b> dịch vụ này?`;
        confirmColor = isShow ? '#10b981' : '#f59e0b';
        confirmText = 'Đồng ý!';
        endpoint = '/admin/dich-vu/api/update-status-batch';
        bodyData = new URLSearchParams({ ids: ids.join(','), status: isShow });
    }

    Swal.fire({
        title: title, 
        html: text, 
        icon: 'question', 
        showCancelButton: true,
        confirmButtonColor: confirmColor, // Đã fix tên biến
        cancelButtonColor: '#6b7280', 
        confirmButtonText: confirmText,   // Đã fix tên biến
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const res = await fetch(endpoint, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/x-www-form-urlencoded'},
                    body: bodyData.toString()
                });
                const data = await res.json();
                if(data.success) {
                    Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: data.message, showConfirmButton: false, timer: 1500 });
                    loadData();
                } else throw new Error(data.message);
            } catch(err) { Swal.fire('Lỗi!', err.message, 'error'); }
        }
    });
}
</script>