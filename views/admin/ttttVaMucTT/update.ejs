<!-- views/admin/ttttVaMucTT/update.ejs -->
<div class="admin-page-header">
  <div><h4>Cập nhật Mức Thanh toán <span style="color:var(--primary);">#<%= item.MaMucTT %></span></h4><p><%= item.Ten %></p></div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/tttt-muc-tt/display/<%= item.MaMucTT %>" class="btn-ghost"><i class="fas fa-eye me-2"></i>Xem</a>
    <a href="/admin/tttt-muc-tt" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
<% if (errors && errors.length > 0) { %>
<div class="hc-toast hc-toast-danger" style="position:static;margin-bottom:16px;">
  <i class="fas fa-exclamation-circle"></i>
  <div><% errors.forEach(e => { %><div><%= e %></div><% }) %></div>
</div>
<% } %>
<div style="max-width:560px;">
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-tasks me-2" style="color:#0061ff;"></i>Thông tin</div>
    </div>
    <div style="padding:24px;">
      <form method="POST" action="/admin/tttt-muc-tt/update/<%= item.MaMucTT %>">
        <div style="margin-bottom:16px;">
          <label class="filter-label">Mã Mức TT</label>
          <input type="text" class="hc-input" value="<%= item.MaMucTT %>" disabled style="opacity:.6;cursor:not-allowed;">
        </div>
        <div style="margin-bottom:16px;">
          <label class="filter-label">Tên Mức thanh toán <span style="color:var(--danger);">*</span></label>
          <input type="text" name="Ten" class="hc-input" value="<%= item.Ten %>" required>
        </div>
        <div style="margin-bottom:20px;">
          <label class="filter-label">Mức độ (%) <span style="color:var(--danger);">*</span></label>
          <% const md = item.MucDo || 0; %>
          <% const initColor = md >= 80 ? '#16a34a' : md >= 50 ? '#ca8a04' : '#dc2626'; %>
          <input type="number" name="MucDo" class="hc-input" min="1" max="100"
            value="<%= item.MucDo || '' %>" required
            oninput="updateProgress(this.value)" style="margin-bottom:10px;">
          <div style="background:var(--bg-soft);border-radius:var(--radius-md);padding:14px;">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px;">
              <div style="flex:1;height:10px;background:var(--border-light);border-radius:5px;overflow:hidden;">
                <div id="progressBar" style="height:100%;width:<%= md %>%;background:<%= initColor %>;border-radius:5px;transition:width .3s,background .3s;"></div>
              </div>
              <span id="progressVal" style="font-size:.82rem;font-weight:700;color:var(--text);min-width:40px;text-align:right;"><%= md %>%</span>
            </div>
            <div style="font-size:.72rem;color:var(--text-muted);">Phần trăm giá trị hợp đồng cần thanh toán</div>
          </div>
        </div>
        <div style="margin-bottom:24px;">
          <label style="display:flex;align-items:center;gap:10px;cursor:pointer;font-size:.875rem;font-weight:600;color:var(--text);">
            <input type="checkbox" name="TTHienThi" <%= item.TTHienThi ? 'checked' : '' %> style="accent-color:var(--primary);width:17px;height:17px;">Hiển thị
          </label>
        </div>
        <div style="display:flex;gap:10px;">
          <button type="submit" class="btn-hc-primary"><i class="fas fa-save me-2"></i>Cập nhật</button>
          <a href="/admin/tttt-muc-tt" class="btn-ghost"><i class="fas fa-times me-2"></i>Hủy</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script>
function updateProgress(val) {
  const v = Math.min(100, Math.max(0, parseInt(val) || 0));
  const bar = document.getElementById('progressBar');
  bar.style.width = v + '%';
  bar.style.background = v >= 80 ? '#16a34a' : v >= 50 ? '#ca8a04' : '#dc2626';
  document.getElementById('progressVal').textContent = v + '%';
}
</script>
