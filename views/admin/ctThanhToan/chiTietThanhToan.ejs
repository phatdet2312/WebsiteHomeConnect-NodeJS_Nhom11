<script>
const maLoaiTT = parseInt("<%= loaiTT.MaLoaiTT %>");
let masterData = [];
let metadata = { toaNhas: [], tangs: [], kys: [], trangThais: [] };
let openAccordions = [];

document.addEventListener('DOMContentLoaded', async () => {
    await fetchMetadata();
    await fetchWorkspaceData();
    setupAssignFilters();
});

function getStatusBadge(status) {
    if (!status) return 'st-chua';
    const s = status.toLowerCase();
    if(s.includes('đã thanh toán') || s.includes('hoàn thành')) return 'st-da';
    if(s.includes('đang') || s.includes('chờ')) return 'st-dang';
    if(s.includes('hủy') || s.includes('lỗi') || s.includes('thất bại')) return 'st-huy';
    return 'st-chua';
}

async function fetchMetadata() {
    const res = await fetch('/admin/ct-thanh-toan/api/metadata');
    const json = await res.json();
    if(json.success) {
        metadata = json;
        renderCircleKy();
        fillFilters();
    }
}

async function fetchWorkspaceData(isSilent = false) {
    if (!isSilent) {
        document.getElementById('loader').style.display = 'block';
        document.getElementById('mainData').style.display = 'none';
    } else {
        openAccordions = Array.from(document.querySelectorAll('.child-row'))
                              .filter(row => row.style.display === 'table-row')
                              .map(row => parseInt(row.id.split('_')[1]));
    }
    
    const res = await fetch('/admin/ct-thanh-toan/api/workspace-data/' + maLoaiTT);
    const json = await res.json();
    
    if(json.success) {
        masterData = json.data;
        renderMainTable();
        calcTotal();
        document.getElementById('countCanHo').textContent = masterData.length;
        
        if (!isSilent) {
            document.getElementById('loader').style.display = 'none';
            document.getElementById('mainData').style.display = 'block';
        } else {
            openAccordions.forEach(id => toggleAccordion(id, true));
        }
    }
}

function renderCircleKy() {
    const cont = document.getElementById('circleKyContainer');
    if(!metadata.kys.length) { cont.innerHTML = '<span class="text-muted">Chưa có kỳ.</span>'; return; }
    cont.innerHTML = metadata.kys.map(k => `
        <div class="ky-circle-item">
            <strong>#${k.maKyTT}</strong>
            <div class="ten-ky" title="${k.tenKyTT}">${k.tenKyTT}</div>
            <div class="ky-actions">
                <button class="btn-circle-action bg-edit" onclick="editKy(${k.maKyTT}, '${k.tenKyTT}')"><i class="fas fa-pen"></i></button>
                <button class="btn-circle-action bg-del" onclick="deleteKy(${k.maKyTT})"><i class="fas fa-times"></i></button>
            </div>
        </div>
    `).join('');
}

async function addKyPrompt() {
    const { value: tenKy } = await Swal.fire({ title: 'Tên kỳ mới', input: 'text', showCancelButton: true });
    if(tenKy) {
        const res = await fetch('/admin/ct-thanh-toan/api/ky/thao-tac', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({action:'add', tenKyTT:tenKy}) });
        const data = await res.json();
        if(data.success) { 
            await fetchMetadata(); 
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã thêm', showConfirmButton: false, timer: 1500 }); 
        } else Swal.fire('Lỗi', data.message, 'error');
    }
}

async function editKy(id, oldName) {
    const { value: tenKy } = await Swal.fire({ title: 'Sửa Tên Kỳ', input: 'text', inputValue: oldName, showCancelButton: true });
    if(tenKy && tenKy !== oldName) {
        const res = await fetch('/admin/ct-thanh-toan/api/ky/thao-tac', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({action:'edit', maKyTT:id, tenKyTT:tenKy}) });
        if((await res.json()).success) { 
            await fetchMetadata(); 
            fetchWorkspaceData(true);
        }
    }
}

function deleteKy(id) {
    Swal.fire({
        title: 'Xóa kỳ thanh toán?',
        text: 'Kỳ này sẽ bị xóa hoàn toàn khỏi hệ thống nếu chưa có căn hộ nào sử dụng.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Có, Xóa!',
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const res = await fetch('/admin/ct-thanh-toan/api/ky/thao-tac', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify({action:'delete', maKyTT:id}) });
            const data = await res.json();
            if(data.success) { 
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã xóa kỳ', showConfirmButton: false, timer: 1500 });
                await fetchMetadata(); 
                fetchWorkspaceData(true); 
            }
            else Swal.fire('Cảnh báo', data.message, 'warning');
        }
    });
}

function renderMainTable() {
    const tbody = document.getElementById('tableBody');
    if(!masterData.length) {
        tbody.innerHTML = `<tr><td colspan="5" style="padding:40px;text-align:center;color:#888;"><i class="fas fa-box-open fa-2x mb-2 opacity-50"></i><br>Chưa có căn hộ nào được gán loại thanh toán này.</td></tr>`;
        return;
    }

    let html = '';
    masterData.forEach(row => {
        const ttMoiNhat = row.tenTrangThai || 'Chưa thanh toán';
        html += `
            <tr class="parent-row" data-ma="${row.maCanHo}" data-toa="${row.tenToaNha}" data-tang="${row.tenTang}" onclick="toggleAccordion(${row.maCanHo})">
                <td style="padding:15px; color:#10b981;"><i id="icon_${row.maCanHo}" class="fas fa-chevron-right"></i></td>
                <td style="padding:15px;">
                    <div style="font-weight:800;font-size:1rem;color:var(--text);">${row.tenCanHo}</div>
                    <div style="font-size:.8rem;color:var(--text-muted);"><i class="fas fa-map-marker-alt me-1"></i>${row.tenTang && row.tenToaNha ? `Tầng ${row.tenTang} - ${row.tenToaNha}` : 'Chưa xác định'}</div>
                </td>
                <td style="padding:15px; font-weight:700; color:var(--text);"><span style="background:#dcfce7; color:#10b981; padding:2px 8px; border-radius:5px;">${row.danhSachKy ? row.danhSachKy.length : 0} kỳ</span></td>
                <td style="padding:15px;">
                    <div style="font-weight:700;">${row.kyMoiNhat ? row.kyMoiNhat.tenKyTT : '?'}</div>
                    <div style="color:var(--danger); font-size:.8rem; font-weight:600;">${row.kyMoiNhat ? Number(row.kyMoiNhat.gia).toLocaleString() : 0}đ</div>
                </td>
                <td style="padding:15px;">
                    <span class="status-badge ${getStatusBadge(ttMoiNhat)}">${ttMoiNhat}</span>
                    <div style="font-size:.7rem; color:var(--text-muted); margin-top:4px;">${row.tenKHThanhToan || '?'} (${row.tenPhuongThuc || '—'})</div>
                </td>
            </tr>
            <tr class="child-row" id="child_${row.maCanHo}">
                <td colspan="5" class="child-content">
                    <table class="child-table">
                        <thead style="background:#f8fafc;">
                            <tr>
                                <th>Kỳ TT</th><th>Giá Tiền</th><th>Hạn Chót</th><th>Ghi chú</th><th>Trạng thái</th><th>Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${row.danhSachKy ? row.danhSachKy.map(ky => `
                                <tr>
                                    <td><b style="color:#10b981;">${ky.tenKyTT}</b></td>
                                    <td><input type="number" id="gia_${row.maCanHo}_${ky.maKyTT}" value="${ky.gia}" class="hc-input" style="padding:4px; height:30px; width:110px;"></td>
                                    <td><input type="date" id="han_${row.maCanHo}_${ky.maKyTT}" value="${ky.ngayDenHan || ''}" class="hc-input" style="padding:4px; height:30px; width:130px;"></td>
                                    <td><input type="text" id="note_${row.maCanHo}_${ky.maKyTT}" value="${ky.ghiChu || ''}" class="hc-input" style="padding:4px; height:30px;"></td>
                                    <td>
                                        <div style="font-size:.75rem; font-weight:700;" class="${getStatusBadge(ky.trangThaiKy).replace('st-','text-')}">${ky.trangThaiHienThi || '—'}</div>
                                        ${ky.ngayThayDoi ? `<div style="font-size:.7rem;color:#888;">${ky.ngayThayDoi}</div>` : ''}
                                    </td>
                                    <td>
                                        <div style="display:flex;gap:5px;">
                                            <button onclick="confirmSaveInline(${row.maCanHo}, ${ky.maKyTT})" class="btn-tbl btn-tbl-edit" title="Lưu thông tin"><i class="fas fa-save"></i></button>
                                            <button onclick="confirmDeleteCT(${row.maCanHo}, ${ky.maKyTT})" class="btn-tbl btn-tbl-delete" title="Xóa dòng này"><i class="fas fa-trash"></i></button>
                                            <button onclick="openInvoice(${row.maCanHo}, ${ky.maKyTT}, '${ky.tenKyTT}')" class="btn-tbl btn-tbl-view" style="color:#10b981;border-color:#10b981;background:#dcfce7;" title="Hóa đơn / Trạng thái"><i class="fas fa-file-invoice-dollar"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            `).join('') : ''}
                        </tbody>
                    </table>
                </td>
            </tr>
        `;
    });
    tbody.innerHTML = html;
}

function toggleAccordion(id, forceOpen = false) {
    const tr = document.getElementById('child_' + id);
    const icon = document.getElementById('icon_' + id);
    if (!tr || !icon) return;

    if(tr.style.display === 'table-row' && !forceOpen) {
        tr.style.display = 'none'; 
        icon.className = 'fas fa-chevron-right';
    } else {
        tr.style.display = 'table-row'; 
        icon.className = 'fas fa-chevron-down';
    }
}

function fillFilters() {
    document.getElementById('filterKy').innerHTML = `<option value="0">Kỳ mới nhất</option>` + metadata.kys.map(k => `<option value="${k.maKyTT}">${k.tenKyTT}</option>`).join('');
    document.getElementById('filterToa').innerHTML = `<option value="">Tất cả Tòa</option>` + metadata.toaNhas.map(t => `<option value="${t.maToaNha}">${t.tenToaNha}</option>`).join('');
    document.getElementById('filterTang').innerHTML = `<option value="">Tất cả Tầng</option>` + metadata.tangs.map(t => `<option value="${t.maTang}">${t.tenTang}</option>`).join('');
}

function calcTotal() {
    let total = 0;
    const fKy = parseInt(document.getElementById('filterKy').value);
    const fToa = document.getElementById('filterToa').value;
    const fTang = document.getElementById('filterTang').value;

    document.querySelectorAll('.parent-row').forEach(row => {
        const ma = parseInt(row.getAttribute('data-ma'));
        const toa = row.getAttribute('data-toa');
        const tang = row.getAttribute('data-tang');
        
        let match = true;
        if(fToa && toa !== fToa) match = false;
        if(fTang && tang !== fTang) match = false;

        const dataRow = masterData.find(d => d.maCanHo === ma);
        if(match && dataRow) {
            let kyHopLe = fKy === 0 ? dataRow.kyMoiNhat : dataRow.danhSachKy.find(k => k.maKyTT === fKy);
            if(kyHopLe) total += parseInt(kyHopLe.gia) || 0;
            else match = false;
        }

        row.style.display = match ? 'table-row' : 'none';
        const child = document.getElementById('child_' + ma);
        if(!match && child.style.display === 'table-row') toggleAccordion(ma);
    });

    document.getElementById('totalFeeDisplay').textContent = total.toLocaleString() + 'đ';
}

function confirmSaveInline(maCanHo, maKyTT) {
    Swal.fire({
        title: 'Lưu thay đổi?',
        text: 'Cập nhật Giá, Hạn chót và Ghi chú?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Đồng ý lưu',
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const gia = document.getElementById(`gia_${maCanHo}_${maKyTT}`).value;
            const han = document.getElementById(`han_${maCanHo}_${maKyTT}`).value;
            const note = document.getElementById(`note_${maCanHo}_${maKyTT}`).value;

            const res = await fetch('/admin/ct-thanh-toan/api/cap-nhat-inline', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maLoaiTT, maCanHo, maKyTT, gia, ngayDenHan: han, ghiChu: note })
            });
            const json = await res.json();
            if(json.success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã lưu thành công', showConfirmButton: false, timer: 1500 });
                fetchWorkspaceData(true); 
            } else Swal.fire('Lỗi', json.message, 'error');
        }
    });
}

function confirmDeleteCT(maCanHo, maKyTT) {
    Swal.fire({
        title: 'Xóa phân bổ?',
        text: 'Thao tác này sẽ gỡ kỳ thanh toán này khỏi căn hộ!',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#dc2626',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Xóa ngay',
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const res = await fetch('/admin/ct-thanh-toan/api/xoa-ct', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maLoaiTT, maCanHo, maKyTT })
            });
            const json = await res.json();
            if(json.success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Đã xóa', showConfirmButton: false, timer: 1500 });
                fetchWorkspaceData(true);
            }
            else Swal.fire('Cảnh báo', json.message, 'warning');
        }
    });
}

// XEM HÓA ĐƠN
async function openInvoice(maCanHo, maKyTT, tenKy) {
    document.getElementById('invoiceModal').style.display = 'flex';
    const content = document.getElementById('invoiceContent');
    content.innerHTML = `<div style="text-align:center; padding:40px;"><i class="fas fa-circle-notch fa-spin fa-2x text-success"></i><br>Đang tải hóa đơn...</div>`;
    
    const res = await fetch(`/admin/ct-thanh-toan/api/chi-tiet-thanh-toan?maLoaiTT=${maLoaiTT}&maCanHo=${maCanHo}&maKyTT=${maKyTT}`);
    const json = await res.json();
    
    if(!json.success || !json.daThanhToan) {
        content.innerHTML = `<div style="text-align:center; padding:40px; color:#888;"><i class="bi bi-info-circle-fill fa-3x text-warning mb-3"></i><br>Căn hộ chưa có dữ liệu thanh toán Hợp đồng cho kỳ này.</div>`;
        return;
    }

    let html = `<h4 style="text-align:center; color:#10b981; font-weight:800; margin-bottom:20px;">Hóa đơn ${tenKy}</h4>`;
    json.hoaDons.forEach(hd => {
        html += `
        <div style="background:#fff; border-radius:12px; border:1px solid #e2e8f0; padding:20px; margin-bottom:15px; box-shadow:0 4px 6px rgba(0,0,0,0.02);">
            <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px dashed #e2e8f0; padding-bottom:10px; margin-bottom:15px;">
                <b style="font-size:1.1rem; color:var(--text);">Hóa đơn #${hd.maHDHD}</b>
                <span class="badge-status ${hd.trangThaiMau === 'success' ? 'st-da' : 'st-dang'}">${hd.trangThai}</span>
            </div>
            <div class="row mb-3">
                <div class="col-6"><span style="color:#64748b; font-size:.9rem;"><i class="fas fa-clock me-1"></i>Ngày TT:</span> <b>${hd.ngayThanhToan}</b></div>
                <div class="col-6 text-end"><span style="color:#64748b; font-size:.9rem;"><i class="fas fa-money-bill-wave me-1"></i>Tổng:</span> <b style="color:var(--danger); font-size:1.1rem;">${Number(hd.tongTien).toLocaleString()}đ</b></div>
            </div>
            <div style="background:#f1f5f9; padding:15px; border-radius:8px; margin-bottom:15px; border:1px solid #e2e8f0;">
                <b style="font-size:.85rem; color:#10b981; margin-bottom:10px; display:block;"><i class="fas fa-bolt me-1"></i>Cập nhật trạng thái nhanh</b>
                <div style="display:flex; gap:10px;">
                    <select id="statusSelect_${hd.maHDHD}" class="hc-select" style="flex:1;">
                        ${metadata.trangThais ? metadata.trangThais.map(tt => `<option value="${tt.maTT}">${tt.tenTT}</option>`).join('') : ''}
                    </select>
                    <input type="text" id="statusNote_${hd.maHDHD}" class="hc-input" placeholder="Ghi chú..." style="flex:2;">
                    <button onclick="confirmUpdateInvoiceStatus(${hd.maHDHD})" class="btn-tt-primary" style="padding:0 15px;"><i class="fas fa-check"></i> Lưu</button>
                </div>
            </div>
            <div style="font-size:.85rem;">
                <b style="display:block; margin-bottom:8px; color:var(--text-muted);">Lịch sử giao dịch:</b>
                ${hd.lichSu.map(ls => `
                    <div style="display:flex; justify-content:space-between; border-left:2px solid #10b981; padding-left:10px; margin-bottom:5px;">
                        <span><b style="color:#475569;">${ls.trangThai}</b> <br><small style="color:#94a3b8;">${ls.ghiChu}</small></span>
                        <span style="color:#64748b; font-size:.75rem;">${ls.thoiGian}</span>
                    </div>
                `).join('')}
            </div>
        </div>`;
    });
    content.innerHTML = html;
}

function confirmUpdateInvoiceStatus(maHDHD) {
    const maTT = document.getElementById('statusSelect_' + maHDHD).value;
    const ghiChu = document.getElementById('statusNote_' + maHDHD).value;
    if(!maTT) return;

    Swal.fire({
        title: 'Cập nhật trạng thái hóa đơn?',
        text: 'Trạng thái hóa đơn sẽ được thay đổi và lưu vào lịch sử.',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
    }).then(async (result) => {
        if(result.isConfirmed) {
            const res = await fetch('/admin/ct-thanh-toan/api/cap-nhat-trang-thai-hoa-don', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ maHDHD, maTT, ghiChu })
            });
            const json = await res.json();
            if(json.success) {
                Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: 'Cập nhật trạng thái thành công', showConfirmButton: false, timer: 1500 });
                document.getElementById('invoiceModal').style.display = 'none';
                fetchWorkspaceData(true); 
            } else Swal.fire('Lỗi', json.message, 'error');
        }
    });
}

// GÁN KỲ HÀNG LOẠT MODAL
function openAssignModal() {
    document.getElementById('modalKySelect').innerHTML = metadata.kys.map(k => `<option value="${k.maKyTT}">${k.tenKyTT}</option>`).join('');
    document.getElementById('modalFilterToa').innerHTML = `<option value="">-- Lọc Tòa --</option>` + metadata.toaNhas.map(t => `<option value="${t.maToaNha}">${t.tenToaNha}</option>`).join('');
    loadAssignApps();
    document.getElementById('assignModal').style.display = 'flex';
}

function setupAssignFilters() {
    document.getElementById('modalFilterToa').addEventListener('change', async (e) => {
        const maToa = e.target.value;
        const res = await fetch('/admin/ct-thanh-toan/api/lay-tang?maToaNha=' + maToa);
        const json = await res.json();
        document.getElementById('modalFilterTang').innerHTML = `<option value="">-- Lọc Tầng --</option>` + json.data.map(t => `<option value="${t.maTang}">${t.tenTang}</option>`).join('');
        loadAssignApps();
    });
    document.getElementById('modalFilterTang').addEventListener('change', loadAssignApps);
}

async function loadAssignApps() {
    const maToa = document.getElementById('modalFilterToa').value;
    const maTang = document.getElementById('modalFilterTang').value;
    const res = await fetch(`/admin/ct-thanh-toan/api/lay-can-ho?maToaNha=${maToa}&maTang=${maTang}`);
    const json = await res.json();
    
    document.getElementById('appTableBody').innerHTML = json.data.map(ch => `
        <tr style="border-bottom:1px solid #f1f5f9;">
            <td style="padding:10px 15px; width:40px;"><input type="checkbox" class="app-chk" value="${ch.maCanHo}" style="accent-color:#10b981;width:16px;height:16px;"></td>
            <td style="padding:10px 15px;"><b>${ch.tenCanHo}</b> <div style="font-size:.7rem;color:#888;">${ch.tenToaNha} - Tầng ${ch.tenTang}</div></td>
            <td style="padding:10px 15px;"><input type="number" id="oGia_${ch.maCanHo}" class="hc-input" style="height:30px;padding:4px;width:120px;" placeholder="Theo giá chung"></td>
            <td style="padding:10px 15px;"><input type="date" id="oHan_${ch.maCanHo}" class="hc-input" style="height:30px;padding:4px;"></td>
        </tr>
    `).join('');
}

function toggleAllApp(source) {
    document.querySelectorAll('.app-chk').forEach(c => c.checked = source.checked);
}

function confirmBatchAssign() {
    const checked = Array.from(document.querySelectorAll('.app-chk:checked')).map(c => c.value);
    if(checked.length === 0) return Swal.fire('Lỗi', 'Chưa chọn căn hộ nào', 'error');

    Swal.fire({
        title: 'Xác nhận gán?',
        text: `Bạn đang chuẩn bị phân bổ kỳ thanh toán cho ${checked.length} căn hộ.`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#10b981',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Đồng ý gán',
        cancelButtonText: 'Hủy'
    }).then((result) => {
        if(result.isConfirmed) submitBatchAssign(checked);
    });
}

async function submitBatchAssign(checked) {
    const btn = document.getElementById('btnThucThiGan');
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang gán...';
    btn.disabled = true;

    const bodyData = {
        maLoaiTT: maLoaiTT,
        maKyTT: document.getElementById('modalKySelect').value,
        danhSachCanHo: checked,
        giaList: checked.map(id => document.getElementById(`oGia_${id}`).value || document.getElementById('modalGiaChung').value || 0),
        ngayDenHanList: checked.map(id => document.getElementById(`oHan_${id}`).value || document.getElementById('modalHanChung').value || ''),
        ghiChuList: checked.map(() => document.getElementById('modalNoteChung').value || '')
    };

    const res = await fetch('/admin/ct-thanh-toan/api/gan-ky-hang-loat', { 
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(bodyData) 
    });
    const json = await res.json();
    
    if(json.success) {
        Swal.fire('Thành công', json.message, 'success');
        closeModal('assignModal');
        fetchWorkspaceData(true); 
    } else Swal.fire('Lỗi', json.message, 'error');
    
    btn.innerHTML = '<i class="fas fa-check me-2"></i>Thực thi gán';
    btn.disabled = false;
}

function closeModal(id) { document.getElementById(id).style.display = 'none'; }
document.addEventListener('keydown', (e) => {
    if(e.key === "Escape") document.querySelectorAll('.custom-modal').forEach(m => m.style.display = 'none');
});
</script>