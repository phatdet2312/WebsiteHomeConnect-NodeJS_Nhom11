        <div class="c-modal-header" style="background:linear-gradient(135deg, #10b981, #047857); color:#fff;">
            <h5 style="margin:0; font-weight:800;"><i class="bi bi-receipt me-2"></i>Chi tiết & Trạng thái Hợp đồng</h5>
