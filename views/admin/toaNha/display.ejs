<!-- views/admin/toaNha/display.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Chi tiết Tòa nhà <span style="color:var(--primary);">#<%= item.MaToaNha %></span></h4>
    <p><%= item.TenToaNha %></p>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/toa-nha/update/<%= item.MaToaNha %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/toa-nha" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>
</div>
 
<div style="display:flex;flex-direction:column;gap:16px;max-width:800px;">

  <!-- Info card -->
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-building me-2" style="color:var(--primary);"></i>Thông tin</div>
    </div>
    <div style="padding:20px 24px;">
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:20px;">
        <span style="background:var(--primary-light);color:var(--primary);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;">#<%= item.MaToaNha %></span>
        <% if (item.TTHienThi) { %>
          <span style="background:#dcfce7;color:#15803d;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-eye me-1"></i>Hiển thị</span>
        <% } else { %>
          <span style="background:var(--bg-soft);color:var(--text-muted);padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:600;"><i class="fas fa-eye-slash me-1"></i>Đang ẩn</span>
        <% } %>
        <% if (item.TTDeXuat) { %>
          <span style="background:#fef9c3;color:#a16207;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:700;"><i class="fas fa-star me-1"></i>Đề xuất</span>
        <% } %>
        <% if (soTang !== undefined) { %>
          <span style="background:#ede9fe;color:#7c3aed;padding:4px 12px;border-radius:8px;font-size:.8rem;font-weight:600;"><i class="fas fa-layer-group me-1"></i><%= soTang %> tầng</span>
        <% } %>
      </div>
      <div>
        <div style="font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;">Tên Tòa nhà</div>
        <div style="font-size:1.2rem;font-weight:800;color:var(--text);"><%= item.TenToaNha %></div>
      </div>
    </div>
  </div>

  <!-- Floors table -->
  <% if (tangList && tangList.length > 0) { %>
  <div class="table-card">
    <div class="table-card-header">
      <div class="table-card-title"><i class="fas fa-layer-group me-2" style="color:#7c3aed;"></i>Danh sách tầng (<%= tangList.length %>)</div>
      <a href="/admin/tang/add" class="btn-tbl btn-tbl-view"><i class="fas fa-plus me-1"></i>Thêm tầng</a>
    </div>
    <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
            <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Mã</th>
            <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Tên tầng</th>
            <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Số hành lang</th>
            <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:center;">Trạng thái</th>
          </tr>
        </thead>
        <tbody>
          <% tangList.forEach(tang => { %>
          <tr style="border-bottom:1px solid var(--border-light);">
            <td style="padding:11px 16px;"><span style="background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:6px;font-size:.72rem;font-weight:700;">#<%= tang.MaTang %></span></td>
            <td style="padding:11px 16px;font-weight:600;color:var(--text);"><%= tang.TenTang %></td>
            <td style="padding:11px 16px;color:var(--text-muted);"><%= tang.SoHanhLang || '—' %></td>
            <td style="padding:11px 16px;text-align:center;">
              <% if (tang.TTHienThi) { %>
                <span style="background:#dcfce7;color:#15803d;padding:2px 9px;border-radius:20px;font-size:.72rem;font-weight:700;">Hiện</span>
              <% } else { %>
                <span style="background:var(--bg-soft);color:var(--text-muted);padding:2px 9px;border-radius:20px;font-size:.72rem;font-weight:600;">Ẩn</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Actions -->
  <div style="display:flex;gap:10px;">
    <a href="/admin/toa-nha/update/<%= item.MaToaNha %>" class="btn-hc-primary"><i class="fas fa-edit me-2"></i>Chỉnh sửa</a>
    <a href="/admin/toa-nha/delete/<%= item.MaToaNha %>" class="btn-ghost" style="color:var(--danger);border-color:var(--danger);"><i class="fas fa-trash me-2"></i>Xóa</a>
    <a href="/admin/toa-nha" class="btn-ghost" style="margin-left:auto;"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
  </div>

</div>
