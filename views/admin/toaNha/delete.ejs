<!-- views/admin/toaNha/delete.ejs -->
<div style="max-width:480px;margin:0 auto;">
  <div class="table-card" style="overflow:hidden;">
    <div style="background:linear-gradient(135deg,#dc2626,#b91c1c);padding:24px;text-align:center;">
      <div style="width:60px;height:60px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 12px;">
        <i class="fas fa-trash-alt" style="font-size:1.4rem;color:white;"></i>
      </div>
      <h5 style="color:white;font-weight:800;margin:0;font-size:1.1rem;">Xác nhận xóa tòa nhà</h5>
    </div>
    <div style="padding:28px;text-align:center;">
      <div style="width:80px;height:80px;background:var(--bg-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;">
        <i class="fas fa-building" style="font-size:2rem;color:var(--text-muted);opacity:.5;"></i>
      </div>
      <p style="color:var(--text-muted);font-size:.875rem;margin-bottom:6px;">Bạn có chắc muốn xóa tòa nhà?</p>
      <p style="font-weight:800;font-size:1.1rem;color:var(--text);margin-bottom:12px;"><%= item.TenToaNha %></p>
      <span style="background:var(--primary-light);color:var(--primary);padding:3px 12px;border-radius:6px;font-size:.75rem;font-weight:700;display:inline-block;margin-bottom:20px;">#<%= item.MaToaNha %></span>
 
      <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:var(--radius-md);padding:14px 16px;text-align:left;margin-bottom:24px;">
        <p style="color:#b91c1c;font-size:.84rem;margin:0;line-height:1.5;">
          <i class="fas fa-exclamation-triangle me-2"></i>
          <strong>Lưu ý:</strong> Xóa tòa nhà có thể ảnh hưởng đến các tầng và căn hộ liên quan!
        </p>
      </div>

      <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
        <a href="/admin/toa-nha" class="btn-ghost"><i class="fas fa-times me-2"></i>Hủy</a>
        <form method="POST" action="/admin/toa-nha/delete/<%= item.MaToaNha %>" style="display:inline;">
          <button type="submit" class="btn-hc-primary" style="background:#dc2626;border-color:#dc2626;">
            <i class="fas fa-trash me-2"></i>Xác nhận xóa
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
