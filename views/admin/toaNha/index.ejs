<!-- views/admin/toaNha/index.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Quản lý Tòa nhà</h4>
    <p>Tổng: <%= totalItems || 0 %> tòa nhà</p>
  </div>
  <a href="/admin/toa-nha/add" class="btn-hc-primary"><i class="fas fa-plus me-2"></i>Thêm mới</a>
</div>

<!-- Filter -->
<div class="table-card mb-3">
  <div class="table-card-header">
    <div class="table-card-title"><i class="fas fa-filter me-2" style="color:var(--primary);"></i>Bộ lọc</div>
  </div>
  <div style="padding:16px 20px;">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-5">
        <label class="filter-label">Tìm kiếm</label>
        <input type="text" name="search" class="hc-input" placeholder="Tên tòa nhà..." value="<%= search || '' %>">
      </div>
      <div class="col-md-3">
        <label class="filter-label">Trạng thái</label>
        <select name="status" class="hc-select">
          <option value="">Tất cả</option>
          <option value="true" <%= (status === 'true') ? 'selected' : '' %>>Hiển thị</option>
          <option value="false" <%= (status === 'false') ? 'selected' : '' %>>Ẩn</option>
        </select>
      </div>
      <div class="col-md-1">
        <button type="submit" class="btn-hc-primary w-100" style="justify-content:center;padding:9px;"><i class="fas fa-search"></i></button>
      </div>
      <div class="col-md-1">
        <a href="/admin/toa-nha" class="btn-ghost w-100" style="justify-content:center;padding:9px;font-size:.8rem;"><i class="fas fa-times"></i></a>
      </div>
    </form>
  </div>
</div>

<form id="bulkForm" method="POST" action="/admin/toa-nha/delete-multiple">
<div class="table-card">
  <div class="table-card-header">
    <div style="display:flex;align-items:center;gap:10px;">
      <input type="checkbox" id="selectAllChk" onchange="selectAll(this.checked)" style="accent-color:var(--primary);width:16px;height:16px;">
      <label for="selectAllChk" class="table-card-title" style="cursor:pointer;">Chọn tất cả</label>
      <span style="font-size:.78rem;color:var(--text-muted);">Hiển thị <%= items ? items.length : 0 %> / <%= totalItems || 0 %></span>
    </div>
    <button type="submit" class="btn-tbl btn-tbl-delete" onclick="return confirm('Xóa các tòa nhà đã chọn?')">
      <i class="fas fa-trash"></i>Xóa đã chọn
    </button>
  </div>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;min-width:600px;">
      <thead>
        <tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
          <th style="padding:10px 16px;width:40px;"></th>
          <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Mã</th>
          <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Tên Tòa nhà</th>
          <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:center;">Hiển thị</th>
          <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:center;">Đề xuất</th>
          <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:center;">Thao tác</th>
        </tr>
      </thead>
      <tbody>
        <% if (!items || items.length === 0) { %>
          <tr><td colspan="6" style="padding:48px;text-align:center;color:var(--text-muted);">
            <i class="fas fa-building fa-3x" style="opacity:.2;display:block;margin-bottom:12px;"></i>
            Không tìm thấy tòa nhà nào
          </td></tr>
        <% } %>
        <% if (items) { items.forEach(item => { %>
        <tr style="border-bottom:1px solid var(--border-light);transition:background .15s;" onmouseover="this.style.background='var(--bg-soft)'" onmouseout="this.style.background=''">
          <td style="padding:12px 16px;"><input type="checkbox" name="ids" value="<%= item.MaToaNha %>" class="row-check" style="accent-color:var(--primary);width:16px;height:16px;"></td>
          <td style="padding:12px 16px;"><span style="background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:6px;font-size:.72rem;font-weight:700;">#<%= item.MaToaNha %></span></td>
          <td style="padding:12px 16px;font-weight:600;color:var(--text);"><i class="fas fa-building me-2" style="color:var(--text-muted);"></i><%= item.TenToaNha %></td>
          <td style="padding:12px 16px;text-align:center;">
            <% if (item.TTHienThi) { %>
              <span style="background:#dcfce7;color:#15803d;padding:2px 9px;border-radius:20px;font-size:.72rem;font-weight:700;">Hiện</span>
            <% } else { %>
              <span style="background:var(--bg-soft);color:var(--text-muted);padding:2px 9px;border-radius:20px;font-size:.72rem;font-weight:600;">Ẩn</span>
            <% } %>
          </td>
          <td style="padding:12px 16px;text-align:center;">
            <% if (item.TTDeXuat) { %>
              <i class="fas fa-star" style="color:#f59e0b;" title="Đề xuất"></i>
            <% } else { %>
              <i class="far fa-star" style="color:var(--text-muted);"></i>
            <% } %>
          </td>
          <td style="padding:12px 16px;">
            <div class="hc-card-actions">
              <a href="/admin/toa-nha/display/<%= item.MaToaNha %>" class="btn-tbl btn-tbl-view"><i class="fas fa-eye"></i></a>
              <a href="/admin/toa-nha/update/<%= item.MaToaNha %>" class="btn-tbl btn-tbl-edit"><i class="fas fa-edit"></i></a>
              <a href="/admin/toa-nha/delete/<%= item.MaToaNha %>" class="btn-tbl btn-tbl-delete"><i class="fas fa-trash"></i></a>
            </div>
          </td>
        </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>
</form>

<% if (totalPages > 1) { %>
<div style="display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:16px;">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage-1 %>&search=<%= search||'' %>&status=<%= status||'' %>" class="pg-btn"><i class="fas fa-chevron-left"></i></a>
  <% } %>
  <% for (let i = 1; i <= totalPages; i++) { %>
    <a href="?page=<%= i %>&search=<%= search||'' %>&status=<%= status||'' %>" class="pg-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
  <% } %>
  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage+1 %>&search=<%= search||'' %>&status=<%= status||'' %>" class="pg-btn"><i class="fas fa-chevron-right"></i></a>
  <% } %>
</div>
<% } %>

<style>
.filter-label { display:block; font-size:.72rem; font-weight:600; color:var(--text-secondary); text-transform:uppercase; letter-spacing:.04em; margin-bottom:5px; }
.pg-btn { display:inline-flex; align-items:center; justify-content:center; min-width:34px; height:34px; padding:0 10px; border-radius:8px; border:1.5px solid var(--border); background:var(--bg-white); color:var(--text-secondary); font-size:.82rem; font-weight:600; text-decoration:none; transition:var(--transition-fast); }
.pg-btn:hover { border-color:var(--primary); color:var(--primary); }
.pg-btn.active { background:var(--primary); border-color:var(--primary); color:white; }
</style>
<script>
function selectAll(checked) { document.querySelectorAll('.row-check').forEach(cb => cb.checked = checked); }
</script>
