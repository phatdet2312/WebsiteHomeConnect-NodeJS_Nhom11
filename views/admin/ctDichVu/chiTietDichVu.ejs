<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

<style>
/* CSS Tái cấu trúc chuẩn C# Layout */
.content-wrapper { padding: 20px 0; width: 100%; overflow-x: hidden; }

/* FIX LỖI CSS GRID BLOWOUT TẠI ĐÂY */
.service-detail-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 24px; margin-bottom: 24px; width: 100%; }
.card-block { background: #fff; border-radius: 16px; padding: 24px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light); min-width: 0; }
.info-service { background: linear-gradient(135deg, #ffffff, #f8fafc); min-width: 0; }
.ky-circle-container { height: 100%; min-width: 0; /* Ép không cho phình to ra ngoài */ }
.ky-circle-card { background: #fff; border-radius: 16px; padding: 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.03); border: 1px solid var(--border-light); height: 100%; display: flex; flex-direction: column; min-width: 0; overflow: hidden; /* Cắt phần tràn */ }
.ky-circle-scroll { display: flex; gap: 15px; overflow-x: auto; padding: 10px 5px 20px 5px; flex: 1; align-items: center; width: 100%; scrollbar-width: thin; }

.card-title { font-size: 1.1rem; font-weight: 800; color: var(--text); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
.info-pair { display: flex; justify-content: space-between; margin-bottom: 12px; border-bottom: 1px dashed #eee; padding-bottom: 8px; }
.info-label { font-weight: 600; color: var(--text-muted); font-size: .9rem; }
.info-value { font-weight: 800; color: var(--primary); font-size: .95rem; }

/* Vòng tròn danh sách Kỳ */
.ky-circle-scroll::-webkit-scrollbar { height: 8px; }
.ky-circle-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 10px; }
.ky-circle-scroll::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 10px; }
.ky-circle-item { min-width: 100px; height: 100px; border-radius: 50%; background: #f1f5f9; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; border: 2px solid transparent; transition: 0.3s; flex-shrink: 0; /* Giữ vòng tròn không bị móp */ }
.ky-circle-item:hover { border-color: var(--primary); background: #e0e7ff; box-shadow: 0 5px 15px rgba(67, 56, 202, 0.2); }
.ky-circle-item strong { font-size: 1.2rem; color: var(--primary); }
.ky-circle-item .ten-ky { font-size: .75rem; font-weight: 700; color: var(--text-muted); text-align: center; padding: 0 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 90px; }
.ky-actions { position: absolute; top: -5px; right: -5px; display: none; gap: 5px; }
.ky-circle-item:hover .ky-actions { display: flex; }
.btn-circle-action { width: 24px; height: 24px; border-radius: 50%; border: none; color: #fff; display: flex; align-items: center; justify-content: center; font-size: .7rem; cursor: pointer; }
.bg-edit { background: #f59e0b; } .bg-del { background: #dc2626; }

/* Accordion Table */
.parent-row { cursor: pointer; transition: background 0.2s; }
.parent-row:hover { background: #f8fafc; }
.child-row { display: none; background: #f8fafc; }
.child-content { padding: 15px 40px 20px 55px; border-bottom: 2px solid var(--border-light); }
.child-table { width: 100%; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); overflow: hidden; border: 1px solid #e2e8f0; }
.child-table th, .child-table td { padding: 12px; font-size: .85rem; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }

/* Trạng thái Badge */
.st-chua { background: #f1f5f9; color: #64748b; }
.st-dang { background: #fef3c7; color: #b45309; }
.st-da { background: #dcfce7; color: #15803d; }
.st-huy { background: #fee2e2; color: #b91c1c; }
.status-badge { padding: 4px 10px; border-radius: 20px; font-size: .75rem; font-weight: 700; display: inline-block; }

/* Tổng phí Footer */
.tong-phi-row-new td { background: #f8fafc; padding: 15px 20px; border-top: 2px solid var(--primary); }
.tong-phi-container-new { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
.filter-group-compact { display: flex; gap: 15px; flex-wrap: wrap; }
.filter-item label { font-size: .75rem; font-weight: 700; color: var(--text-muted); margin-right: 5px; }
.filter-select-compact { border: 1px solid #cbd5e1; border-radius: 6px; padding: 4px 8px; font-size: .8rem; outline: none; }
.tong-phi-final { font-size: 1.2rem; font-weight: 800; color: var(--danger); display: flex; align-items: center; gap: 10px; }

/* Modals */
.custom-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1050; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
.custom-modal-content { background: #fff; width: 90%; max-width: 900px; border-radius: 16px; overflow: hidden; box-shadow: 0 10px 40px rgba(0,0,0,0.2); animation: slideDown 0.3s ease; display: flex; flex-direction: column; max-height: 90vh; }
.c-modal-header { padding: 15px 24px; background: var(--bg-soft); border-bottom: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; }
.c-modal-body { padding: 24px; overflow-y: auto; flex: 1; }
.c-modal-footer { padding: 15px 24px; background: var(--bg-soft); border-top: 1px solid var(--border-light); display: flex; justify-content: flex-end; gap: 10px; }
@keyframes slideDown { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
</style>

