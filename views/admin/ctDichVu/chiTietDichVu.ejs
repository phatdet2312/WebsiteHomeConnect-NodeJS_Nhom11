            <a href="/admin/ct-dich-vu" class="btn-ghost"><i class="fas fa-times"></i> Đóng</a>
        </div>
    </div>

    <div id="loader" style="padding:50px;text-align:center;">
        <i class="fas fa-circle-notch fa-spin fa-2x text-primary"></i><br><b class="mt-2 d-block text-muted">Đang phân tích dữ liệu...</b>
    </div>

    <div id="mainData" style="display:none;">
        <div class="service-detail-grid">
            <div class="card-block info-service">
