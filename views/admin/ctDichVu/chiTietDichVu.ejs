        <div style="display:flex;gap:10px;">
            <button onclick="openKyModal()" class="btn-hc-primary" style="background:#f59e0b; border-color:#f59e0b;"><i class="fas fa-calendar-alt me-2"></i>Quản lý Kỳ</button>
