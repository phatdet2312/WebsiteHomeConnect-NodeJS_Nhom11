                        <tr style="background:#f8fafc; border-bottom:1px solid #e2e8f0; text-align:left;">
                            <th style="padding:15px; width:40px;"></th>
                            <th style="padding:15px; font-size:.8rem; color:#64748b; text-transform:uppercase;">Căn hộ</th>
                            <th style="padding:15px; font-size:.8rem; color:#64748b; text-transform:uppercase;">Tổng Kỳ</th>
                            <th style="padding:15px; font-size:.8rem; color:#64748b; text-transform:uppercase;">Kỳ Mới Nhất</th>
                            <th style="padding:15px; font-size:.8rem; color:#64748b; text-transform:uppercase;">Trạng Thái KMN</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody"></tbody>
                    <tfoot>
                        <tr class="tong-phi-row-new">
                            <td colspan="5">
                                <div class="tong-phi-container-new">
                                    <div class="filter-group-compact">
                                        <div class="filter-item">
                                            <label>Kỳ:</label>
                                            <select id="filterKy" class="filter-select-compact" onchange="calcTotal()"><option value="0">Kỳ mới nhất</option></select>
