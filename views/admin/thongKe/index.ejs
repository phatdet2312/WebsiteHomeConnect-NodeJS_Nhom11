<!-- views/admin/thongKe/index.ejs -->
<div class="admin-page-header">
  <div><h4>Thống kê tổng quan</h4><p>Dashboard phân tích kinh doanh</p></div>
  <div style="display:flex;gap:8px;">
    <a href="/admin/thong-ke/doanh-thu" class="btn-ghost"><i class="fas fa-file-invoice-dollar me-2"></i>Doanh thu</a>
    <a href="/admin/thong-ke/hop-dong" class="btn-ghost"><i class="fas fa-file-contract me-2"></i>Hợp đồng</a>
    <a href="/admin/thong-ke/can-ho" class="btn-ghost"><i class="fas fa-home me-2"></i>Căn hộ</a>
  </div>
</div>

<div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải dữ liệu...</p></div>
</div>

<div id="mainContent" class="d-none">
    <div style="display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:24px;">
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#e8f0ff;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-users" style="font-size:1.2rem;color:#0061ff;"></i></div>
            <div id="statKH" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">Khách hàng</div>
        </div>
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#dcfce7;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-home" style="font-size:1.2rem;color:#16a34a;"></i></div>
            <div id="statCH" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">Căn hộ</div>
        </div>
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#fef9c3;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-clock" style="font-size:1.2rem;color:#ca8a04;"></i></div>
            <div id="statCD" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">HĐ chờ duyệt</div>
        </div>
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#dcfce7;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-check-circle" style="font-size:1.2rem;color:#16a34a;"></i></div>
            <div id="statDK" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">HĐ đã ký</div>
        </div>
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#fee2e2;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-times-circle" style="font-size:1.2rem;color:#dc2626;"></i></div>
            <div id="statDH" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">HĐ đã hủy</div>
        </div>
        <div class="table-card" style="text-align:center;padding:16px 12px;">
            <div style="width:44px;height:44px;background:#ede9fe;border-radius:12px;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;"><i class="fas fa-chart-pie" style="font-size:1.2rem;color:#7c3aed;"></i></div>
            <div id="statTotal" style="font-size:1.5rem;font-weight:800;color:var(--text);line-height:1;">-</div>
            <div style="font-size:.72rem;color:var(--text-muted);margin-top:4px;">Tổng căn hộ</div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;margin-bottom:16px;">
        <div class="table-card">
            <div class="table-card-header"><div class="table-card-title"><i class="fas fa-chart-line me-2" style="color:#16a34a;"></i>Doanh thu theo tháng (12 tháng gần nhất)</div></div>
            <div style="padding:16px 20px;"><canvas id="revenueChart" height="240"></canvas></div>
        </div>
        <div class="table-card">
            <div class="table-card-header"><div class="table-card-title"><i class="fas fa-chart-pie me-2" style="color:#7c3aed;"></i>Tỷ lệ sử dụng căn hộ</div></div>
            <div style="padding:16px 20px;text-align:center;">
                <canvas id="occupancyChart" height="200"></canvas>
                <div style="display:flex;justify-content:center;gap:10px;margin-top:12px;flex-wrap:wrap;">
                    <span id="lblDaSuDung" style="background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">- Đã sử dụng</span>
                    <span id="lblChuaSuDung" style="background:var(--bg-soft);color:var(--text-muted);padding:3px 10px;border-radius:20px;font-size:.75rem;font-weight:700;">- Chưa sử dụng</span>
                </div>
            </div>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <div class="table-card">
            <div class="table-card-header"><div class="table-card-title"><i class="fas fa-building me-2" style="color:#0061ff;"></i>Doanh thu theo Tòa nhà</div></div>
            <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;">
                    <thead><tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Tòa nhà</th>
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right;">Số HĐ</th>
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right;">Doanh thu</th>
                    </tr></thead>
                    <tbody id="doanhThuToaNhaBody"></tbody>
                </table>
            </div>
        </div>
        <div class="table-card">
            <div class="table-card-header"><div class="table-card-title"><i class="fas fa-trophy me-2" style="color:#ca8a04;"></i>Top Căn hộ theo HĐ</div></div>
            <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;">
                    <thead><tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">#</th>
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Căn hộ</th>
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:center;">Số HĐ</th>
                        <th style="padding:8px 14px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right;">Tổng giá trị</th>
                    </tr></thead>
                    <tbody id="topCanHoBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

fetch('/admin/thong-ke/api/dashboard')
    .then(r => r.json())
    .then(res => {
        if (!res.success) return alert('Lỗi tải dữ liệu');
        const data = res.data;
        document.getElementById('loadingState').classList.add('d-none');
        document.getElementById('mainContent').classList.remove('d-none');

        // Binds Stats
        document.getElementById('statKH').textContent = data.stats.tongKH;
        document.getElementById('statCH').textContent = data.stats.tongCanHo;
        document.getElementById('statCD').textContent = data.stats.tongHDDangKy;
        document.getElementById('statDK').textContent = data.stats.tongHDDaKy;
        document.getElementById('statDH').textContent = data.stats.tongHDHuy;
        document.getElementById('statTotal').textContent = data.tyLeCanHo.tong || 0;

        // Binds Bảng Tòa Nhà
        const bToaNha = document.getElementById('doanhThuToaNhaBody');
        if (data.doanhThuToaNha.length) {
            bToaNha.innerHTML = data.doanhThuToaNha.map(r => `
                <tr style="border-bottom:1px solid var(--border-light);">
                    <td style="padding:9px 14px;font-weight:600;font-size:.85rem;color:var(--text);">${esc(r.TenToaNha)}</td>
                    <td style="padding:9px 14px;text-align:right;font-size:.85rem;">${r.soHopDong}</td>
                    <td style="padding:9px 14px;text-align:right;font-weight:700;color:#16a34a;font-size:.82rem;">${r.tongDoanhThu ? Number(r.tongDoanhThu).toLocaleString('vi-VN') : '0'}đ</td>
                </tr>`).join('');
        } else { bToaNha.innerHTML = '<tr><td colspan="3" class="text-center p-3 text-muted">Chưa có dữ liệu</td></tr>'; }

        // Binds Bảng Căn Hộ
        const bCanHo = document.getElementById('topCanHoBody');
        if (data.topCanHo.length) {
            bCanHo.innerHTML = data.topCanHo.map((r, i) => `
                <tr style="border-bottom:1px solid var(--border-light);">
                    <td style="padding:9px 14px;"><span style="background:${i<3?'#fef9c3':'var(--bg-soft)'};color:${i<3?'#a16207':'var(--text-muted)'};padding:2px 7px;border-radius:6px;font-size:.75rem;font-weight:700;">${i+1}</span></td>
                    <td style="padding:9px 14px;font-weight:600;font-size:.85rem;color:var(--text);">${esc(r.TenCanHo)}</td>
                    <td style="padding:9px 14px;text-align:center;font-size:.85rem;">${r.soHopDong}</td>
                    <td style="padding:9px 14px;text-align:right;font-weight:700;color:#16a34a;font-size:.82rem;">${r.tongGiaTri ? Number(r.tongGiaTri).toLocaleString('vi-VN') : '0'}đ</td>
                </tr>`).join('');
        } else { bCanHo.innerHTML = '<tr><td colspan="4" class="text-center p-3 text-muted">Chưa có dữ liệu</td></tr>'; }

        // Vẽ Biểu Đồ Doanh Thu
        new Chart(document.getElementById('revenueChart'), {
            type: 'bar',
            data: {
                labels: data.doanhThuTheoThang.map(r => r.period),
                datasets: [{ label: 'Doanh thu (đ)', data: data.doanhThuTheoThang.map(r => r.tongDoanhThu || 0), backgroundColor: 'rgba(0,97,255,0.7)', borderColor: '#0061ff', borderWidth: 1, borderRadius: 4 }]
            },
            options: { responsive: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
        });

        // Vẽ Biểu Đồ Trạng Thái
        document.getElementById('lblDaSuDung').textContent = `${data.tyLeCanHo.daSuDung || 0} Đã sử dụng`;
        document.getElementById('lblChuaSuDung').textContent = `${data.tyLeCanHo.chuaSuDung || 0} Chưa sử dụng`;
        new Chart(document.getElementById('occupancyChart'), {
            type: 'doughnut',
            data: {
                labels: ['Đã sử dụng', 'Chưa sử dụng'],
                datasets: [{ data: [data.tyLeCanHo.daSuDung || 0, data.tyLeCanHo.chuaSuDung || 0], backgroundColor: ['#16a34a','#e5e7eb'], borderWidth: 0 }]
            },
            options: { responsive: true, cutout: '65%' }
        });
    });
</script>