<!-- views/admin/thongKe/doanhThu.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Báo cáo Doanh thu</h4>
    <p>Tổng: <strong><%= total %></strong> hợp đồng &mdash; <span style="color:#16a34a;font-weight:700;"><%= tongTien ? Number(tongTien).toLocaleString('vi-VN') + ' đ' : '0 đ' %></span></p>
  </div>
  <a href="/admin/thong-ke" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Tổng quan</a>
</div>
<div class="table-card mb-3">
  <div class="table-card-header"><div class="table-card-title"><i class="fas fa-filter me-2" style="color:var(--primary);"></i>Bộ lọc</div></div>
  <div style="padding:16px 20px;">
    <form method="GET" class="row g-2 align-items-end">
      <div class="col-md-3"><label class="filter-label">Từ ngày</label><input type="date" name="tuNgay" class="hc-input" value="<%= tuNgay %>"></div>
      <div class="col-md-3"><label class="filter-label">Đến ngày</label><input type="date" name="denNgay" class="hc-input" value="<%= denNgay %>"></div>
      <div class="col-md-1"><button type="submit" class="btn-hc-primary w-100" style="justify-content:center;padding:9px;"><i class="fas fa-search"></i></button></div>
      <div class="col-md-1"><a href="/admin/thong-ke/doanh-thu" class="btn-ghost w-100" style="justify-content:center;padding:9px;"><i class="fas fa-times"></i></a></div>
    </form>
  </div>
</div>
<div class="table-card">
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Mã HĐ</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Khách hàng</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Căn hộ</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Tòa nhà / Tầng</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;">Ngày lập</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:.04em;text-align:right;">Giá trị HĐ</th>
      </tr></thead>
      <tbody>
        <% if (!items || items.length === 0) { %>
          <tr><td colspan="6" style="padding:48px;text-align:center;color:var(--text-muted);"><i class="fas fa-chart-bar fa-3x" style="opacity:.2;display:block;margin-bottom:12px;"></i>Không có dữ liệu</td></tr>
        <% } %>
        <% if (items) { items.forEach(item => { %>
        <tr style="border-bottom:1px solid var(--border-light);" onmouseover="this.style.background='var(--bg-soft)'" onmouseout="this.style.background=''">
          <td style="padding:12px 16px;"><span style="background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:6px;font-size:.72rem;font-weight:700;">#<%= item.MaHopDong %></span></td>
          <td style="padding:12px 16px;font-weight:600;color:var(--text);font-size:.875rem;"><%= item.TenKH || '—' %></td>
          <td style="padding:12px 16px;font-size:.85rem;color:var(--text-secondary);"><%= item.TenCanHo || '—' %></td>
          <td style="padding:12px 16px;">
            <span style="background:var(--bg-soft);padding:2px 8px;border-radius:5px;font-size:.75rem;color:var(--text-muted);">
              <i class="fas fa-building me-1"></i><%= item.TenToaNha || '' %><% if (item.TenTang) { %> / Tầng <%= item.TenTang %><% } %>
            </span>
          </td>
          <td style="padding:12px 16px;font-size:.8rem;color:var(--text-muted);">
            <%= item.NgayLap ? new Date(item.NgayLap).toLocaleDateString('vi-VN') : '—' %>
          </td>
          <td style="padding:12px 16px;text-align:right;font-weight:700;color:#16a34a;font-size:.875rem;">
            <%= item.GiaThoaThuan ? Number(item.GiaThoaThuan).toLocaleString('vi-VN') + ' đ' : '—' %>
          </td>
        </tr>
        <% }) } %>
      </tbody>
    </table>
  </div>
</div>
<% if (totalPages > 1) { %><div style="display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:16px;">
  <a href="?page=<%= currentPage-1 %>&tuNgay=<%= tuNgay %>&denNgay=<%= denNgay %>" class="pg-btn" <%= currentPage===1?'style="pointer-events:none;opacity:.5;"':'' %>><i class="fas fa-chevron-left"></i></a>
  <% for (let i=1;i<=totalPages;i++) { %><a href="?page=<%= i %>&tuNgay=<%= tuNgay %>&denNgay=<%= denNgay %>" class="pg-btn <%= currentPage===i?'active':'' %>"><%= i %></a><% } %>
  <a href="?page=<%= currentPage+1 %>&tuNgay=<%= tuNgay %>&denNgay=<%= denNgay %>" class="pg-btn" <%= currentPage===totalPages?'style="pointer-events:none;opacity:.5;"':'' %>><i class="fas fa-chevron-right"></i></a>
</div><% } %>
<style>.filter-label{display:block;font-size:.72rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px;}.pg-btn{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;padding:0 10px;border-radius:8px;border:1.5px solid var(--border);background:var(--bg-white);color:var(--text-secondary);font-size:.82rem;font-weight:600;text-decoration:none;}.pg-btn:hover{border-color:var(--primary);color:var(--primary);}.pg-btn.active{background:var(--primary);border-color:var(--primary);color:white;}</style>
