<!-- views/admin/thongKe/doanhThu.ejs -->
<div class="admin-page-header">
  <div>
    <h4>Báo cáo Doanh thu</h4>
    <p id="headerSummary">Đang tính toán...</p>
  </div>
  <a href="/admin/thong-ke" class="btn-ghost"><i class="fas fa-arrow-left me-2"></i>Tổng quan</a>
</div>

<div class="table-card mb-3">
  <div class="table-card-header"><div class="table-card-title"><i class="fas fa-filter me-2" style="color:var(--primary);"></i>Bộ lọc</div></div>
  <div style="padding:16px 20px;">
    <form id="filterForm" class="row g-2 align-items-end">
      <div class="col-md-3"><label class="filter-label">Từ ngày</label><input type="date" id="tuNgay" class="hc-input"></div>
      <div class="col-md-3"><label class="filter-label">Đến ngày</label><input type="date" id="denNgay" class="hc-input"></div>
      <div class="col-md-1"><button type="submit" class="btn-hc-primary w-100" style="justify-content:center;padding:9px;"><i class="fas fa-search"></i></button></div>
      <div class="col-md-1"><button type="button" onclick="location.href='/admin/thong-ke/doanh-thu'" class="btn-ghost w-100" style="justify-content:center;padding:9px;"><i class="fas fa-times"></i></button></div>
    </form>
  </div>
</div>

<div class="table-card">
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;">
      <thead><tr style="background:var(--bg-soft);border-bottom:1px solid var(--border-light);">
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Mã HĐ</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Khách hàng</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Căn hộ</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Tòa nhà / Tầng</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;">Ngày lập</th>
        <th style="padding:10px 16px;font-size:.72rem;font-weight:700;color:var(--text-muted);text-transform:uppercase;text-align:right;">Giá trị HĐ</th>
      </tr></thead>
      <tbody id="doanhThuBody">
         <tr><td colspan="6" class="text-center p-4"><div class="hc-spinner"></div></td></tr>
      </tbody>
    </table>
  </div>
</div>
<div id="pagination" style="display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:16px;"></div>

<style>.filter-label{display:block;font-size:.72rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:.04em;margin-bottom:5px;}.pg-btn{display:inline-flex;align-items:center;justify-content:center;min-width:34px;height:34px;padding:0 10px;border-radius:8px;border:1.5px solid var(--border);background:var(--bg-white);color:var(--text-secondary);font-size:.82rem;font-weight:600;text-decoration:none;cursor:pointer;}.pg-btn:hover{border-color:var(--primary);color:var(--primary);}.pg-btn.active{background:var(--primary);border-color:var(--primary);color:white;}</style>

<script>
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

const urlParams = new URLSearchParams(window.location.search);
document.getElementById('tuNgay').value = urlParams.get('tuNgay') || '';
document.getElementById('denNgay').value = urlParams.get('denNgay') || '';

document.getElementById('filterForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const t = document.getElementById('tuNgay').value;
    const d = document.getElementById('denNgay').value;
    window.location.href = `/admin/thong-ke/doanh-thu?page=1${t?'&tuNgay='+t:''}${d?'&denNgay='+d:''}`;
});

fetch('/admin/thong-ke/api/doanh-thu' + window.location.search)
    .then(r => r.json())
    .then(res => {
        if (!res.success) return alert('Lỗi tải dữ liệu');
        const data = res.data;
        const tt = data.tongTien ? Number(data.tongTien).toLocaleString('vi-VN') + ' đ' : '0 đ';
        document.getElementById('headerSummary').innerHTML = `Tổng: <strong>${data.total}</strong> hợp đồng &mdash; <span style="color:#16a34a;font-weight:700;">${tt}</span>`;

        const body = document.getElementById('doanhThuBody');
        if (!data.items.length) {
            body.innerHTML = '<tr><td colspan="6" style="padding:48px;text-align:center;color:var(--text-muted);"><i class="fas fa-chart-bar fa-3x" style="opacity:.2;display:block;margin-bottom:12px;"></i>Không có dữ liệu</td></tr>';
            return;
        }

        body.innerHTML = data.items.map(item => `
            <tr style="border-bottom:1px solid var(--border-light);">
                <td style="padding:12px 16px;"><span style="background:var(--primary-light);color:var(--primary);padding:2px 8px;border-radius:6px;font-size:.72rem;font-weight:700;">#${item.MaHopDong}</span></td>
                <td style="padding:12px 16px;font-weight:600;color:var(--text);font-size:.875rem;">${esc(item.TenKH || '—')}</td>
                <td style="padding:12px 16px;font-size:.85rem;color:var(--text-secondary);">${esc(item.TenCanHo || '—')}</td>
                <td style="padding:12px 16px;"><span style="background:var(--bg-soft);padding:2px 8px;border-radius:5px;font-size:.75rem;color:var(--text-muted);"><i class="fas fa-building me-1"></i>${esc(item.TenToaNha || '')} ${item.TenTang ? '/ Tầng '+item.TenTang : ''}</span></td>
                <td style="padding:12px 16px;font-size:.8rem;color:var(--text-muted);">${item.NgayLap ? new Date(item.NgayLap).toLocaleDateString('vi-VN') : '—'}</td>
                <td style="padding:12px 16px;text-align:right;font-weight:700;color:#16a34a;font-size:.875rem;">${item.GiaThoaThuan ? Number(item.GiaThoaThuan).toLocaleString('vi-VN') + ' đ' : '—'}</td>
            </tr>
        `).join('');

        if (data.totalPages > 1) {
            let pg = '';
            const t = urlParams.get('tuNgay') || ''; const d = urlParams.get('denNgay') || '';
            const q = `${t?'&tuNgay='+t:''}${d?'&denNgay='+d:''}`;
            const cPage = parseInt(urlParams.get('page')) || 1;
            
            if (cPage > 1) pg += `<a href="?page=${cPage-1}${q}" class="pg-btn"><i class="fas fa-chevron-left"></i></a>`;
            for (let i=1; i<=data.totalPages; i++) pg += `<a href="?page=${i}${q}" class="pg-btn ${cPage===i?'active':''}">${i}</a>`;
            if (cPage < data.totalPages) pg += `<a href="?page=${cPage+1}${q}" class="pg-btn"><i class="fas fa-chevron-right"></i></a>`;
            document.getElementById('pagination').innerHTML = pg;
        }
    });
</script>