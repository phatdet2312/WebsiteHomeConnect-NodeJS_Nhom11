<!-- views/admin/pttt/delete.ejs -->
<div style="max-width:460px;margin:0 auto;">
  <div class="table-card" style="overflow:hidden;">
    <div style="background:linear-gradient(135deg,#dc2626,#b91c1c);padding:24px;text-align:center;">
      <div style="width:56px;height:56px;background:rgba(255,255,255,.2);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 10px;">
        <i class="fas fa-trash-alt" style="font-size:1.3rem;color:white;"></i>
      </div>
      <h5 style="color:white;font-weight:800;margin:0;font-size:1rem;">Xác nhận xóa phương thức thanh toán</h5>
    </div>
    <div style="padding:24px;text-align:center;">
      <div style="width:64px;height:64px;background:var(--bg-soft);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 14px;">
        <i class="fas fa-credit-card" style="font-size:1.6rem;color:var(--text-muted);opacity:.5;"></i>
      </div>
      <p style="color:var(--text-muted);font-size:.875rem;margin-bottom:4px;">Bạn có chắc muốn xóa?</p>
      <p style="font-weight:800;font-size:1.05rem;color:var(--text);margin-bottom:10px;"><%= item.TenPT %></p>
      <span style="background:var(--primary-light);color:var(--primary);padding:3px 10px;border-radius:6px;font-size:.75rem;font-weight:700;display:inline-block;margin-bottom:18px;">#<%= item.MaPT %></span>
      <div style="background:#fef2f2;border:1.5px solid #fecaca;border-radius:var(--radius-md);padding:12px 14px;text-align:left;margin-bottom:20px;">
        <p style="color:#b91c1c;font-size:.82rem;margin:0;"><i class="fas fa-exclamation-triangle me-2"></i>Thao tác này không thể hoàn tác!</p>
      </div>
      <div style="display:flex;justify-content:center;gap:10px;flex-wrap:wrap;">
        <a href="/admin/pttt" class="btn-ghost"><i class="fas fa-times me-2"></i>Hủy</a>
        <form method="POST" action="/admin/pttt/delete/<%= item.MaPT %>" style="display:inline;">
          <button type="submit" class="btn-hc-primary" style="background:#dc2626;border-color:#dc2626;"><i class="fas fa-trash me-2"></i>Xác nhận xóa</button>
        </form>
      </div>
    </div>
  </div>
</div>
