<!-- views/layouts/admin.ejs -->

<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — Admin' : 'Admin — HomeConnect' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/design-system.css">
  <style>
    /* Admin-only overrides */
    .sb-badge {
      background: rgba(0,97,255,.3); color: #93c5fd;
      padding: 2px 7px; border-radius: 20px; font-size: .68rem; font-weight: 600;
      margin-left: auto;
    }
    .hc-card-actions { display: flex; align-items: center; gap: 6px; }
    .btn-tbl { padding: 5px 12px; font-size: .78rem; border-radius: 8px; font-weight: 500; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; transition: var(--transition-fast); border: 1.5px solid; }
    .btn-tbl-view   { color: var(--primary); border-color: var(--primary); background: var(--primary-light); }
    .btn-tbl-edit   { color: var(--warning); border-color: var(--warning); background: var(--warning-light); }
    .btn-tbl-delete { color: var(--danger);  border-color: var(--danger);  background: var(--danger-light); }
    .btn-tbl:hover  { opacity: .85; transform: translateY(-1px); }
    .admin-page-header {
      display: flex; align-items: center; justify-content: space-between;
      margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
    }
    .admin-page-header h4 { font-size: 1.2rem; font-weight: 700; margin: 0; color: var(--text); }
    .admin-page-header p  { font-size: .82rem; color: var(--text-muted); margin: 2px 0 0; }
    .table-card { background: var(--bg-white); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); border: 1px solid var(--border-light); overflow: hidden; }
    .table-card-header {
      padding: 16px 20px; display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid var(--border-light); background: var(--bg-soft); gap: 12px; flex-wrap: wrap;
    }
    .table-card-title { font-size: .92rem; font-weight: 700; color: var(--text); }
    .img-thumb { width: 44px; height: 36px; object-fit: cover; border-radius: 6px; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
    .status-on  { background: var(--success); }
    .status-off { background: var(--text-muted); }
  </style>
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body class="hc-admin-body">

  <!-- ── SIDEBAR ── -->
  <nav class="hc-sidebar" id="adminSidebar">
    <a class="sb-brand" href="/admin/dashboard">
      <div class="sb-brand-icon"><i class="fas fa-home"></i></div>
      <div>
        <div class="sb-brand-text">HomeConnect</div>
        <div class="sb-brand-sub">Admin Panel</div>
      </div>
    </a>

    <!-- Overview -->
    <div class="sb-section">T&#7893;ng quan</div>
    <a class="sb-link <%= currentPath.startsWith('/admin/dashboard') ? 'active' : '' %>" href="/admin/dashboard">
      <i class="fas fa-chart-line"></i> B&#7843;ng &#273;i&#7873;u khi&#7875;n
    </a>

        <!-- Real estate -->
    <div class="sb-section">B&#7845;t &#273;&#7897;ng s&#7843;n</div>
    <a class="sb-link <%= currentPath.startsWith('/admin/toa-nha') ? 'active' : '' %>" href="/admin/toa-nha">
      <i class="fas fa-building"></i> T&#242;a nh&#224;
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/tang') ? 'active' : '' %>" href="/admin/tang">
      <i class="fas fa-layer-group"></i> T&#7847;ng
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/can-ho') ? 'active' : '' %>" href="/admin/can-ho">
      <i class="fas fa-home"></i> C&#259;n h&#7897;
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/danh-muc-noi-that') ? 'active' : '' %>" href="/admin/danh-muc-noi-that">
      <i class="fas fa-couch"></i> N&#7897;i th&#7845;t
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/hien-trang') ? 'active' : '' %>" href="/admin/hien-trang">
      <i class="fas fa-star-half-alt"></i> Hi&#7879;n tr&#7841;ng
    </a>


        <!-- Contracts & Payments -->
    <div class="sb-section">H&#7907;p &#273;&#7891;ng &amp; TT</div>
    <a class="sb-link <%= currentPath.startsWith('/admin/hop-dong') ? 'active' : '' %>" href="/admin/hop-dong">
      <i class="fas fa-file-contract"></i> H&#7907;p &#273;&#7891;ng
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/ct-thanh-toan') ? 'active' : '' %>" href="/admin/ct-thanh-toan">
      <i class="fas fa-credit-card"></i> Chi ti&#7871;t TT
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/loai-tt-hd') ? 'active' : '' %>" href="/admin/loai-tt-hd">
      <i class="fas fa-tags"></i> Lo&#7841;i thanh to&#225;n
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/pttt') ? 'active' : '' %>" href="/admin/pttt">
      <i class="fas fa-wallet"></i> Ph&#432;&#417;ng th&#7913;c TT
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/trang-thai') ? 'active' : '' %>" href="/admin/trang-thai">
      <i class="fas fa-traffic-light"></i> Tr&#7841;ng th&#225;i
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/tttt-muc-tt') ? 'active' : '' %>" href="/admin/tttt-muc-tt">
      <i class="fas fa-percentage"></i> M&#7913;c thanh to&#225;n
    </a>


    <!-- Services -->
    <div class="sb-section">D&#7883;ch v&#7909;</div>
    <a class="sb-link <%= currentPath.startsWith('/admin/dich-vu') ? 'active' : '' %>" href="/admin/dich-vu">
      <i class="fas fa-concierge-bell"></i> D&#7883;ch v&#7909;
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/ct-dich-vu') ? 'active' : '' %>" href="/admin/ct-dich-vu">
      <i class="fas fa-tasks"></i> CT D&#7883;ch v&#7909;
    </a>

    <!-- Management -->
    <div class="sb-section">Qu&#7843;n l&#253;</div>
    <a class="sb-link <%= currentPath.startsWith('/admin/banner') ? 'active' : '' %>" href="/admin/banner">
      <i class="fas fa-images"></i> Banner
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/quan-ly-nguoi-dung') ? 'active' : '' %>" href="/admin/quan-ly-nguoi-dung">
      <i class="fas fa-users"></i> Ng&#432;&#7901;i d&#249;ng
    </a>
    <a class="sb-link <%= currentPath.startsWith('/admin/quan-ly-suc-khoe') ? 'active' : '' %>" href="/admin/quan-ly-suc-khoe">
      <i class="fas fa-heartbeat"></i> S&#7913;c kh&#7887;e
    </a>

    <!-- Footer -->
    <div class="sb-footer">
      <% if (user) { %>
        <div class="sb-user">
          <div class="sb-user-avatar"><%= (user.HoTen || user.UserName || 'A').charAt(0).toUpperCase() %></div>
          <div style="flex:1;min-width:0;">
            <div class="sb-user-name"><%= user.HoTen || user.UserName %></div>
            <div class="sb-user-role">Qu&#7843;n tr&#7883; vi&#234;n</div>
          </div>
        </div>
      <% } %>
      <a href="/" class="sb-link" style="border-radius:var(--radius-sm);margin-bottom:4px;border-left:none;">
        <i class="fas fa-external-link-alt"></i> Xem website
      </a>
      <a href="/auth/logout" class="sb-link" style="border-radius:var(--radius-sm);color:rgba(252,165,165,.8);border-left:none;">
        <i class="fas fa-sign-out-alt"></i> &#272;&#259;ng xu&#7845;t
      </a>
    </div>
  </nav>

  <!-- ── MAIN ── -->
  <div class="hc-main" id="adminMain">

    <!-- Topbar -->
    <div class="hc-topbar">
      <button class="btn-icon d-xl-none me-2" onclick="toggleAdminSidebar()" style="border:none;background:none;font-size:1.1rem;color:var(--text-secondary);">
        <i class="fas fa-bars"></i>
      </button>
      <div style="flex:1;">
        <% if (typeof title !== 'undefined') { %>
          <div class="tb-title"><%= title %></div>
        <% } %>
      </div>
      <div class="d-flex align-items-center gap-2">
        <a href="/" class="btn-ghost" style="font-size:.8rem;padding:6px 12px;">
          <i class="fas fa-globe"></i>
          <span class="d-none d-md-inline">Website</span>
        </a>
        <% if (user) { %>
          <div class="d-flex align-items-center gap-2 ps-2" style="border-left:1px solid var(--border);">
            <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#4f46e5);display:flex;align-items:center;justify-content:center;color:white;font-size:.8rem;font-weight:700;">
              <%= (user.HoTen || user.UserName || 'A').charAt(0).toUpperCase() %>
            </div>
            <div class="d-none d-md-block">
              <div style="font-size:.82rem;font-weight:600;color:var(--text)"><%= user.HoTen || user.UserName %></div>
              <div style="font-size:.72rem;color:var(--text-muted)">Admin</div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Flash Messages -->
    <div class="hc-toast-area" id="adminToasts">
      <% if (success_msg && success_msg.length > 0) { %>
        <div class="hc-toast hc-toast-success">
          <i class="fas fa-check-circle" style="color:var(--success);font-size:1rem;flex-shrink:0;margin-top:2px;"></i>
          <span style="font-size:.875rem;color:var(--text)"><%= success_msg %></span>
          <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;margin-left:auto;padding:0;">&#10005;</button>
        </div>
      <% } %>
      <% if (error_msg && error_msg.length > 0) { %>
        <div class="hc-toast hc-toast-danger">
          <i class="fas fa-exclamation-circle" style="color:var(--danger);font-size:1rem;flex-shrink:0;margin-top:2px;"></i>
          <span style="font-size:.875rem;color:var(--text)"><%= error_msg %></span>
          <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;margin-left:auto;padding:0;">&#10005;</button>
        </div>
      <% } %>
    </div>

    <!-- Page Content -->
    <div class="hc-page-content">
      <%- body %>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h5 class="modal-title fw-bold" style="font-size:1rem;">X&#225;c nh&#7853;n thao t&#225;c</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body pt-2" id="confirmModalBody" style="color:var(--text-secondary);font-size:.9rem;">B&#7841;n c&#243; ch&#7855;c mu&#7889;n th&#7921;c hi&#7879;n thao t&#225;c n&#224;y?</div>
        <div class="modal-footer border-0 pt-2">
          <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">H&#7911;y</button>
          <button type="button" class="btn btn-danger btn-sm" id="confirmModalBtn">X&#225;c nh&#7853;n</button>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Sidebar toggle (mobile)
    function toggleAdminSidebar() {
      document.getElementById('adminSidebar').classList.toggle('show');
    }
    // Close sidebar on outside click (mobile)
    document.addEventListener('click', e => {
      const sb = document.getElementById('adminSidebar');
      if (sb.classList.contains('show') && !sb.contains(e.target)) {
        sb.classList.remove('show');
      }
    });
    // Auto dismiss toasts
    setTimeout(() => {
      document.querySelectorAll('.hc-toast').forEach(t => {
        t.style.transition = 'opacity .4s';
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 400);
      });
    }, 5000);
    // Confirm modal
    function confirmAction(msg, formId) {
      document.getElementById('confirmModalBody').textContent = msg;
      document.getElementById('confirmModalBtn').onclick = () => document.getElementById(formId).submit();
      new bootstrap.Modal(document.getElementById('confirmModal')).show();
    }
    // Keep-alive
    setInterval(() => fetch('/keep-alive', {method:'POST'}).catch(()=>{}), 45000);
    // Highlight active sidebar link
    const cp = window.location.pathname;
    document.querySelectorAll('.hc-sidebar .sb-link').forEach(l => {
      if (l.getAttribute('href') !== '/admin/dashboard' && cp.startsWith(l.getAttribute('href'))) {
        l.classList.add('active');
      }
    });
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
