<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="is-auth" content="<%= isAuthenticated ? 'true' : 'false' %>">
  <title><%= typeof title !== 'undefined' ? title : 'HomeConnect' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="stylesheet" href="/css/design-system.css">
  <%- typeof extraStyles !== 'undefined' ? extraStyles : '' %>
</head>
<body>

  <header class="hc-navbar" id="mainNav">
    <div class="navbar-container">

      <a href="/" class="nav-brand">
        <div class="brand-icon"><i class="fas fa-home"></i></div>
        <span>HomeConnect</span>
      </a>

      <nav class="nav-links d-none d-lg-flex">
        <a href="/" class="nav-link<%= currentPath==='/' ? ' active' : '' %>">
          <i class="fas fa-home me-1" style="font-size:.7rem;"></i>Trang chủ
        </a>
        <a href="/kham-pha" class="nav-link<%= currentPath.startsWith('/kham-pha') ? ' active' : '' %>">
          <i class="fas fa-search me-1" style="font-size:.7rem;"></i>Khám phá
        </a>
        <a href="/dich-vu" class="nav-link<%= currentPath.startsWith('/dich-vu') ? ' active' : '' %>">
          <i class="fas fa-concierge-bell me-1" style="font-size:.7rem;"></i>Dịch vụ
        </a>
        <% if (isAuthenticated) { %>
          <a href="/can-ho" class="nav-link<%= currentPath.startsWith('/can-ho') ? ' active' : '' %>">
            <i class="fas fa-file-contract me-1" style="font-size:.7rem;"></i>Hợp đồng
          </a>
          <a href="/quan-ly-lich" class="nav-link<%= currentPath.startsWith('/quan-ly-lich') ? ' active' : '' %>">
            <i class="fas fa-calendar-alt me-1" style="font-size:.7rem;"></i>Lịch
          </a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <a href="/gio-hang" class="cart-btn">
          <i class="fas fa-shopping-bag"></i>
        </a>

        <% if (isAuthenticated && user) { %>
          <% const roles = (user.dataValues && user.dataValues.roles) || []; %>
          <% if (roles.includes('Admin') || roles.includes('Employee') || user.IsSuperAdmin) { %>
            <a href="/admin/dashboard" class="btn-ghost d-none d-md-inline-flex" style="padding:7px 13px;font-size:.8rem;">
              <i class="fas fa-cog"></i> Admin
            </a>
          <% } %>

          <div class="dropdown">
            <button class="user-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" style="border:none;">
              <div class="user-avatar"><%= (user.HoTen || user.UserName || 'U').charAt(0).toUpperCase() %></div>
              <span class="d-none d-md-inline" style="max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.875rem;font-weight:500;">
                <%= user.HoTen || user.UserName %>
              </span>
              <i class="fas fa-chevron-down" style="font-size:.65rem;opacity:.6;"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
              <li>
                <div style="padding:10px 14px 8px;border-bottom:1px solid var(--border-light);margin-bottom:4px;">
                  <div style="font-weight:700;font-size:.875rem;"><%= user.HoTen || user.UserName %></div>
                  <div style="font-size:.78rem;color:var(--text-muted);"><%= user.Email || '' %></div>
                </div>
              </li>
              <li><a class="dropdown-item" href="/auth/change-password"><i class="fas fa-key me-2 text-muted"></i>Đổi mật khẩu</a></li>
              <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="fas fa-sign-out-alt me-2"></i>Đăng xuất</a></li>
            </ul>
          </div>
        <% } else { %>
          <a href="/auth/login" class="btn-ghost">Đăng nhập</a>
          <a href="/auth/register" class="btn-hc-primary btn-primary">Đăng ký</a>
        <% } %>

        <button class="btn-icon d-lg-none" id="mobileMenuBtn" onclick="toggleMobileMenu()">
          <i class="fas fa-bars"></i>
        </button>
      </div>
    </div>

    <div id="mobileNav" style="display:none;border-top:1px solid var(--border-light);background:var(--bg-white);">
      <div style="padding:12px 20px;display:flex;flex-direction:column;gap:4px;">
        <a href="/" class="nav-link" style="padding:10px 12px;">🏠 Trang chủ</a>
      </div>
    </div>
  </header>

  <div class="hc-toast-area" id="toastArea">
    <% if (success_msg && success_msg.length > 0) { %>
      <div class="hc-toast hc-toast-success">
        <i class="fas fa-check-circle" style="color:var(--success);font-size:1rem;flex-shrink:0;margin-top:2px;"></i>
        <span style="font-size:.875rem;color:var(--text)"><%= success_msg %></span>
        <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;margin-left:auto;font-size:.9rem;padding:0;">&#10005;</button>
      </div>
    <% } %>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="hc-toast hc-toast-danger">
        <i class="fas fa-exclamation-circle" style="color:var(--danger);font-size:1rem;flex-shrink:0;margin-top:2px;"></i>
        <span style="font-size:.875rem;color:var(--text)"><%= error_msg %></span>
        <button onclick="this.parentElement.remove()" style="background:none;border:none;color:var(--text-muted);cursor:pointer;margin-left:auto;font-size:.9rem;padding:0;">&#10005;</button>
      </div>
    <% } %>
  </div>

  <main><%- body %></main>

  <footer class="hc-footer">
    <div class="container" style="max-width:1320px;">
      <div class="row g-5">
        <div class="col-lg-4 col-md-6">
          <div class="footer-brand">
            <div style="width:32px;height:32px;background:linear-gradient(135deg,var(--primary),#4f46e5);border-radius:8px;display:flex;align-items:center;justify-content:center;color:white;font-size:.9rem;"><i class="fas fa-home"></i></div>
            HomeConnect
          </div>
          <p class="footer-desc">Hệ thống quản lý và giao dịch bất động sản hiện đại. Tìm kiếm, mua bán và quản lý căn hộ một cách thông minh.</p>
          <div class="social-links mt-4">
            <a href="#"><i class="fab fa-facebook-f"></i></a>
            <a href="#"><i class="fab fa-instagram"></i></a>
            <a href="#"><i class="fab fa-youtube"></i></a>
            <a href="#"><i class="fab fa-linkedin-in"></i></a>
          </div>
        </div>
        <div class="col-lg-2 col-md-6 col-6">
          <h6 class="footer-heading">Khám phá</h6>
          <ul class="footer-links">
            <li><a href="/">Trang chủ</a></li>
          </ul>
        </div>
        <div class="col-lg-2 col-md-6 col-6">
          <h6 class="footer-heading">Tài khoản</h6>
          <ul class="footer-links">
            <li><a href="/auth/login">Đăng nhập</a></li>
            <li><a href="/auth/register">Đăng ký</a></li>
          </ul>
        </div>
        <div class="col-lg-4 col-md-6">
          <h6 class="footer-heading">Liên hệ</h6>
          <div class="footer-contact"><i class="fas fa-map-marker-alt"></i>123 Đường ABC, Quận 1, TP. HCM</div>
          <div class="footer-contact"><i class="fas fa-phone"></i>1800 xxxx (Miễn phí)</div>
          <div class="footer-contact"><i class="fas fa-envelope"></i>support@homeconnect.vn</div>
          <div class="footer-contact"><i class="fas fa-clock"></i>Thứ 2 – Thứ 6: 8:00 – 18:00</div>
        </div>
      </div>
      <hr class="footer-divider">
      <div class="footer-bottom">
        <span>&copy; 2025 HomeConnect. All rights reserved.</span>
        <div class="d-flex align-items-center gap-3">
          <a href="/privacy" style="color:rgba(255,255,255,.35);font-size:.8rem;">Chính sách bảo mật</a>
          <span class="footer-badge">v2.0</span>
        </div>
      </div>
    </div>
  </footer>

  <button class="hc-chat-fab" onclick="toggleChat()" title="Tư vấn AI">
    <i class="fas fa-robot"></i>
  </button>
  <div class="hc-chat-panel" id="chatPanel">
    <div class="hc-chat-header">
      <div>
        <div class="ch-title">🤖 AI Tư vấn HomeConnect</div>
        <div style="font-size:.72rem;opacity:.7;margin-top:1px;">Trợ lý thông minh 24/7</div>
      </div>
      <button class="ch-close" onclick="toggleChat()">&#10005;</button>
    </div>
    <div class="hc-chat-messages" id="chatMessages">
      <div class="msg-bot"><span>Xin chào! Tôi là trợ lý AI của HomeConnect. Tôi có thể giúp bạn tìm căn hộ phù hợp. Bạn cần tư vấn gì?</span></div>
    </div>
    <div class="hc-chat-input">
      <input type="text" id="chatInput" placeholder="Nhập câu hỏi..." onkeydown="if(event.key==='Enter')sendChat()">
      <button onclick="sendChat()"><i class="fas fa-paper-plane"></i></button>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Navbar scroll effect
    window.addEventListener('scroll', () => {
      document.getElementById('mainNav').classList.toggle('scrolled', window.scrollY > 20);
    });
    // Mobile menu
    function toggleMobileMenu() {
      const m = document.getElementById('mobileNav');
      m.style.display = m.style.display === 'none' ? 'block' : 'none';
    }
    // Auto dismiss toasts
    setTimeout(() => {
      document.querySelectorAll('.hc-toast').forEach(t => {
        t.style.transition = 'opacity .4s';
        t.style.opacity = '0';
        setTimeout(() => t.remove(), 400);
      });
    }, 5000);
    // Chat
    function toggleChat() { document.getElementById('chatPanel').classList.toggle('show'); }
    async function sendChat() {
      const inp = document.getElementById('chatInput');
      const msg = inp.value.trim();
      if (!msg) return;
      const msgs = document.getElementById('chatMessages');
      msgs.innerHTML += `<div class="msg-user"><span>${msg}</span></div>`;
      inp.value = '';
      msgs.innerHTML += `<div class="msg-bot" id="typing"><span>...</span></div>`;
      msgs.scrollTop = msgs.scrollHeight;
      try {
        const r = await fetch('/api/chat-gemini', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({message:msg}) });
        const d = await r.json();
        document.getElementById('typing').innerHTML = `<span>${d.message||'Có lỗi xảy ra'}</span>`;
      } catch(e) {
        document.getElementById('typing').innerHTML = '<span>Xin lỗi, không kết nối được AI.</span>';
      }
      msgs.scrollTop = msgs.scrollHeight;
    }
    // Keep-alive
    setInterval(() => fetch('/keep-alive',{method:'POST'}).catch(()=>{}), 45000);
  </script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>