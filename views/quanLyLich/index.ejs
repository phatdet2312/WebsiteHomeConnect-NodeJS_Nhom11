function deleteEvt(id) {
    Swal.fire({ title: 'Xóa sự kiện này?', text: 'Bạn không thể khôi phục lại!', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa', cancelButtonText: 'Hủy', confirmButtonColor: '#dc2626' })
    .then(async (r) => {
        if(r.isConfirmed) {
            const res = await fetch(`/quan-ly-lich/api/su-kien/${id}`, {method:'DELETE'});
            const data = await res.json();
            if(data.success) { 
