}

function openEditCal(id) {
    const c = calendars.find(x => x.MaLich === id);
    if(!c) return;
    document.getElementById('calModalTitle').textContent = 'Sửa lịch';
    document.getElementById('calId').value = c.MaLich;
    document.getElementById('calTen').value = c.TenLich;
    document.getElementById('calMoTa').value = c.MoTa || '';
    const colorOpt = document.querySelector(`[data-color="${c.MauSac}"]`) || document.querySelector('.color-option');
    selectColor(colorOpt, c.MauSac || COLORS[0]);
    calModal.show();
}

// ĐÃ FIX PATH: /quan-ly-lich/api/lich
async function saveCalendar() {
    const id = document.getElementById('calId').value;
    const body = {
        TenLich: document.getElementById('calTen').value.trim(),
        MauSac: document.getElementById('calColor').value,
        MoTa: document.getElementById('calMoTa').value.trim()
    };
    if(!body.TenLich) return Swal.fire('Lỗi', 'Tên lịch không được để trống', 'warning');
    
    try {
        const res = await fetch(id ? `/quan-ly-lich/api/lich/${id}` : `/quan-ly-lich/api/lich`, {
            method: id ? 'PUT' : 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if(data.success) {
            calModal.hide();
            Swal.fire('Thành công', data.message, 'success');
            loadCalendars();
        } else Swal.fire('Lỗi', data.message, 'error');
    } catch(e) { Swal.fire('Lỗi mạng', '', 'error'); }
}

// ĐÃ FIX PATH: /quan-ly-lich/api/lich
function deleteCal(id) {
    Swal.fire({ title: 'Xóa lịch?', text: 'Tất cả sự kiện trong lịch này sẽ biến mất vĩnh viễn!', icon: 'warning', showCancelButton: true, confirmButtonText: 'Xóa ngay', cancelButtonText: 'Hủy', confirmButtonColor: '#dc2626' })
    .then(async (r) => {
        if(r.isConfirmed) {
