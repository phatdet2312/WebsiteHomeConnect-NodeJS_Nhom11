function showAddEventModal() {
    if(!calendars.length) return Swal.fire('Lưu ý', 'Bạn cần tạo một Lịch trước khi thêm sự kiện', 'info');
    document.getElementById('evtModalTitle').textContent = 'Thêm sự kiện mới';
    document.getElementById('evtId').value = '';
    document.getElementById('evtTen').value = '';
    document.getElementById('evtMoTa').value = '';
    document.getElementById('evtDiaDiem').value = '';
    
    const now = new Date();
    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
    const iso = now.toISOString().slice(0, 16);
    document.getElementById('evtStart').value = iso;
    
    now.setHours(now.getHours() + 1);
    const isoEnd = now.toISOString().slice(0, 16);
    document.getElementById('evtEnd').value = isoEnd;
    
    evtModal.show();
}

function openEditEvt(id) {
    const e = events.find(x => x.MaSuKien === id);
    if(!e) return;
    document.getElementById('evtModalTitle').textContent = 'Cập nhật sự kiện';
    document.getElementById('evtId').value = e.MaSuKien;
    document.getElementById('evtLich').value = e.MaLich;
    document.getElementById('evtTen').value = e.TieuDe;
    document.getElementById('evtDiaDiem').value = e.DiaDiem || '';
    document.getElementById('evtMoTa').value = e.MoTa || '';
    
    const pad = n => String(n).padStart(2,'0');
    const fmt = dStr => {
        const d = new Date(dStr);
        return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
    };
    document.getElementById('evtStart').value = fmt(e.ThoiGianBatDau);
    document.getElementById('evtEnd').value = fmt(e.ThoiGIanKetThuc);
    
    evtModal.show();
}

// ĐÃ FIX PATH: /quan-ly-lich/api/su-kien
async function saveEvent() {
    const id = document.getElementById('evtId').value;
    const body = {
        MaLich: document.getElementById('evtLich').value,
        TieuDe: document.getElementById('evtTen').value.trim(),
        ThoiGianBatDau: document.getElementById('evtStart').value,
        ThoiGIanKetThuc: document.getElementById('evtEnd').value,
        DiaDiem: document.getElementById('evtDiaDiem').value.trim(),
        MoTa: document.getElementById('evtMoTa').value.trim()
    };
    
    if(!body.MaLich || !body.TieuDe || !body.ThoiGianBatDau || !body.ThoiGIanKetThuc) {
        return Swal.fire('Thiếu thông tin', 'Vui lòng điền các trường bắt buộc', 'warning');
    }
    if(new Date(body.ThoiGianBatDau) > new Date(body.ThoiGIanKetThuc)) return Swal.fire('Lỗi thời gian', 'Ngày kết thúc phải lớn hơn ngày bắt đầu!', 'warning');

    try {
        const res = await fetch(id ? `/quan-ly-lich/api/su-kien/${id}` : `/quan-ly-lich/api/su-kien`, {
            method: id ? 'PUT' : 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify(body)
        });
        const data = await res.json();
        if(data.success) {
            evtModal.hide();
            document.getElementById('dayEventsPanel').classList.add('d-none');
            Swal.fire({title:'Thành công', text: data.message, icon:'success', timer: 1500, showConfirmButton: false});
            loadEvents();
        } else Swal.fire('Lỗi', data.message, 'error');
    } catch(e) { Swal.fire('Lỗi mạng', '', 'error'); }
}

