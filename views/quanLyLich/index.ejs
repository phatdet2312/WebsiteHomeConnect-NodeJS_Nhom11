<script>
// ==========================================
// BỘ CHUYỂN ĐỔI NGÀY ÂM LỊCH (LUNAR CLASS)
// ==========================================
class LunarClass {
    static lunarInfo = [0x04bd8,0x04ae0,0x0a570,0x054d5,0x0d260,0x0d950,0x16554,0x056a0,0x09ad0,0x055d2,0x04ae0,0x0a5b6,0x0a4d0,0x0d250,0x1d255,0x0b540,0x0d6a0,0x0ada2,0x095b0,0x14977,0x04970,0x0a4b0,0x0b4b5,0x06a50,0x06d40,0x1ab54,0x02b60,0x09570,0x052f2,0x04970,0x06566,0x0d4a0,0x0ea50,0x06e95,0x05ad0,0x02b60,0x186e3,0x092e0,0x1c8d7,0x0c950,0x0d4a0,0x1d8a6,0x0b550,0x056a0,0x1a5b4,0x025d0,0x092d0,0x0d2b2,0x0a950,0x0b557,0x06ca0,0x0b550,0x15355,0x04da0,0x0a5b0,0x14573,0x052b0,0x0a9a8,0x0e950,0x06aa0,0x0aea6,0x0ab50,0x04b60,0x0aae4,0x0a570,0x05260,0x0f263,0x0d950,0x05b57,0x056a0,0x096d0,0x04dd5,0x04ad0,0x0a4d0,0x0d4d4,0x0d250,0x0d558,0x0b540,0x0b6a0,0x195a6,0x095b0,0x049b0,0x0a974,0x0a4b0,0x0b27a,0x06a50,0x06d40,0x0af46,0x0ab60,0x09570,0x04af5,0x04970,0x064b0,0x074a3,0x0ea50,0x06b58,0x05ac0,0x0ab60,0x096d5,0x092e0,0x0c960,0x0d954,0x0d4a0,0x0da50,0x07552,0x056a0,0x0abb7,0x025d0,0x092d0,0x0cab5,0x0a950,0x0b4a0,0x0baa4,0x0ad50,0x055d9,0x04ba0,0x0a5b0,0x15176,0x052b0,0x0a930,0x07954,0x06aa0,0x0ad50,0x05b52,0x04b60,0x0a6e6,0x0a4e0,0x0d260,0x0ea65,0x0d530,0x05aa0,0x076a3,0x096d0,0x04afb,0x04ad0,0x0a4d0,0x1d0b6,0x0d250,0x0d520,0x0dd45,0x0b5a0,0x056d0,0x055b2,0x049b0,0x0a577,0x0a4b0,0x0aa50,0x1b255,0x06d20,0x0ada0,0x14b63,0x09370,0x049f8,0x04970,0x064b0,0x168a6,0x0ea50,0x06b20,0x1a6c4,0x0aae0,0x0a2e0,0x0d2e3,0x0c960,0x0d557,0x0d4a0,0x0da50,0x05d55,0x056a0,0x0a6d0,0x055d4,0x052d0,0x0a9b8,0x0a950,0x0b4a0,0x0b6a6,0x0ad50,0x055a0,0x0aba4,0x0a5b0,0x052b0,0x0b273,0x06930,0x07337,0x06aa0,0x0ad50,0x14b55,0x04b60,0x0a570,0x054e4,0x0d160,0x0e968,0x0d520,0x0daa0,0x16aa6,0x056d0,0x04ae0,0x0a9d4,0x0a2d0,0x0d150,0x0f252,0x0d520];
    static leapMonth(y) { return this.lunarInfo[y-1900] & 0xf; }
    static leapDays(y) { return this.leapMonth(y) ? ((this.lunarInfo[y-1900] & 0x10000) ? 30 : 29) : 0; }
    static lYearDays(y) { let sum=348; for(let i=0x8000; i>0x8; i>>=1) sum+=(this.lunarInfo[y-1900]&i)?1:0; return sum+this.leapDays(y); }
    static monthDays(y, m) { return (this.lunarInfo[y-1900] & (0x10000>>m)) ? 30 : 29; }
    static solar2lunar(y, m, d) {
        let offset = (Date.UTC(y, m-1, d) - Date.UTC(1900, 0, 31))/86400000;
        let i, temp=0;
        for(i=1900; i<2101 && offset>0; i++) { temp = this.lYearDays(i); offset -= temp; }
        if(offset<0) { offset+=temp; i--; }
        let year=i, leap=this.leapMonth(i), isLeap=false;
        for(i=1; i<13 && offset>0; i++) {
            if(leap>0 && i===(leap+1) && !isLeap) { --i; isLeap=true; temp=this.leapDays(year); }
            else { temp=this.monthDays(year,i); }
            if(isLeap && i===(leap+1)) isLeap=false;
            offset-=temp;
        }
        if(offset===0 && leap>0 && i===leap+1) { if(isLeap) isLeap=false; else { isLeap=true; --i; } }
        if(offset<0) { offset+=temp; --i; }
        return { lDay: offset+1, lMonth: i, isLeap };
    }
}

// ==========================================
// STATE & INITIALIZATION
// ==========================================
let currentYear = new Date().getFullYear();
let currentMonth = new Date().getMonth();
let selectedLichId = null;
let calendars = [];
let events = [];

const COLORS = ['#0061ff','#e53935','#43a047','#fb8c00','#8e24aa','#00897b','#f4511e','#039be5'];

document.addEventListener('DOMContentLoaded', () => {
    initColorPicker();
    loadCalendars();
    renderCalendarGrid();
});

function initColorPicker() {
    const picker = document.getElementById('colorPicker');
    picker.innerHTML = COLORS.map(c => `<div class="color-option" style="background:${c};" data-color="${c}" onclick="selectColor(this,'${c}')"></div>`).join('');
    selectColor(picker.firstChild, COLORS[0]);
}

function selectColor(el, color) {
    document.querySelectorAll('.color-option').forEach(c => c.classList.remove('selected'));
    el.classList.add('selected');
    document.getElementById('calColor').value = color;
}

// ==========================================
// API GỌI LỊCH (CALENDARS) - ĐÃ FIX PATH
// ==========================================
async function loadCalendars() {
    try {
        const res = await fetch('/quan-ly-lich/api/lich');
        const json = await res.json();
        if(json.success) {
            calendars = json.data;
            document.getElementById('statLichs').textContent = calendars.length;
            renderCalendarList();
            
            const sel = document.getElementById('evtLich');
            sel.innerHTML = '<option value="">-- Chọn lịch --</option>' + calendars.map(c => `<option value="${c.MaLich}">${c.TenLich}</option>`).join('');
            
            loadEvents(); 
        }
    } catch(e) { console.error('Lỗi tải lịch', e); }
}

function renderCalendarList() {
    const el = document.getElementById('lichList');
    if(!calendars.length) {
        el.innerHTML = '<p class="text-muted text-center my-3 small">Chưa có lịch nào. Hãy tạo mới!</p>';
        return;
    }
    el.innerHTML = calendars.map(c => `
        <div class="lich-item ${selectedLichId === c.MaLich ? 'active' : ''}" onclick="filterByCalendar(${c.MaLich})">
            <div class="lich-dot" style="background:${c.MauSac}"></div>
            <div class="lich-name">${c.TenLich}</div>
            <div class="actions">
                <button class="lich-btn lich-btn-edit" onclick="event.stopPropagation(); openEditCal(${c.MaLich})"><i class="fas fa-pen"></i></button>
                <button class="lich-btn lich-btn-del" onclick="event.stopPropagation(); deleteCal(${c.MaLich})"><i class="fas fa-trash"></i></button>
            </div>
        </div>
    `).join('');
}

function filterByCalendar(id) {
    selectedLichId = (selectedLichId === id) ? null : id;
    renderCalendarList();
    loadEvents();
}

// ==========================================
// API GỌI SỰ KIỆN (EVENTS) - ĐÃ FIX PATH
// ==========================================
async function loadEvents() {
    document.getElementById('loadingCalendar').classList.remove('d-none');
    try {
        let url = `/quan-ly-lich/api/su-kien?thang=${currentMonth+1}&nam=${currentYear}`;
        if(selectedLichId) url += `&maLich=${selectedLichId}`;
        
        const res = await fetch(url);
        const json = await res.json();
        if(json.success) {
            events = json.data;
            document.getElementById('statEvents').textContent = events.length;
            renderEventsOnGrid();
        }
    } catch(e) { console.error(e); }
    document.getElementById('loadingCalendar').classList.add('d-none');
}

// ==========================================
// THUẬT TOÁN VẼ LƯỚI & RẢI SỰ KIỆN
// ==========================================
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

function parseDateStr(str) {
    if (!str) return new Date();
    const parts = str.split('T')[0].split('-');
    return new Date(parseInt(parts[0]), parseInt(parts[1])-1, parseInt(parts[2]));
}
function formatDateStr(d) {
    return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}

function renderCalendarGrid() {
    const monthNames = ['Tháng 1', 'Tháng 2', 'Tháng 3', 'Tháng 4', 'Tháng 5', 'Tháng 6', 'Tháng 7', 'Tháng 8', 'Tháng 9', 'Tháng 10', 'Tháng 11', 'Tháng 12'];
    document.getElementById('calendarTitle').textContent = `${monthNames[currentMonth]} ${currentYear}`;
    
    const firstDay = new Date(currentYear, currentMonth, 1).getDay();
    const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
    const daysInPrevMonth = new Date(currentYear, currentMonth, 0).getDate();
    const today = new Date();

    let html = '';
    let day = 1;
    let nextDay = 1;

    for (let row = 0; row < 6; row++) {
        html += '<tr>';
        for (let col = 0; col < 7; col++) {
            const idx = row * 7 + col;
            let classList = "cal-cell";
            let dNum = "";
            let dStr = "";
            let isCurrentMonth = false;

            if (idx < firstDay) {
                classList += " other-month";
                dNum = daysInPrevMonth - firstDay + idx + 1;
            } else if (day > daysInMonth) {
                classList += " other-month";
                dNum = nextDay++;
            } else {
                isCurrentMonth = true;
                dNum = day++;
                if (dNum === today.getDate() && currentMonth === today.getMonth() && currentYear === today.getFullYear()) {
                    classList += " today";
                }
            }

            const realYear = isCurrentMonth ? currentYear : (idx < firstDay ? (currentMonth === 0 ? currentYear - 1 : currentYear) : (currentMonth === 11 ? currentYear + 1 : currentYear));
            const realMonth = isCurrentMonth ? currentMonth : (idx < firstDay ? (currentMonth === 0 ? 11 : currentMonth - 1) : (currentMonth === 11 ? 0 : currentMonth + 1));
            
            const lunar = LunarClass.solar2lunar(realYear, realMonth + 1, dNum);
            const lunarText = (lunar.lDay === 1 || dNum === 1) ? `${lunar.lDay}/${lunar.lMonth}` : lunar.lDay;

            dStr = `${realYear}-${String(realMonth+1).padStart(2,'0')}-${String(dNum).padStart(2,'0')}`;

            html += `
            <td class="${classList}" onclick="showDayEvents('${dStr}', ${dNum}, ${realMonth+1})">
                <div class="cal-day-top">
                    <div class="solar-day">${dNum}</div>
                    <div class="lunar-day">${lunarText}</div>
                </div>
                <div class="event-stack" id="cell-${dStr}"></div>
            </td>`;
        }
        html += '</tr>';
        if (day > daysInMonth && row >= 4) break; 
    }
    document.getElementById('calendarBody').innerHTML = html;
}

function renderEventsOnGrid() {
    document.querySelectorAll('.event-stack').forEach(el => el.innerHTML = '');

    events.forEach(ev => {
        const sd = new Date(ev.ThoiGianBatDau);
        const ed = new Date(ev.ThoiGIanKetThuc);
        const color = ev.Lich?.MauSac || '#0061ff';

        let current = new Date(sd.getFullYear(), sd.getMonth(), sd.getDate());
        const endNormalized = new Date(ed.getFullYear(), ed.getMonth(), ed.getDate());

        while (current <= endNormalized) {
            const dStr = `${current.getFullYear()}-${String(current.getMonth()+1).padStart(2,'0')}-${String(current.getDate()).padStart(2,'0')}`;
            const cell = document.getElementById(`cell-${dStr}`);
            
            if (cell) {
                let badgeClass = "event-badge";
                let prefix = "";

                if (current.getTime() !== endNormalized.getTime() || current.getTime() !== new Date(sd.getFullYear(), sd.getMonth(), sd.getDate()).getTime()) {
                    if (current.getTime() === new Date(sd.getFullYear(), sd.getMonth(), sd.getDate()).getTime()) {
                        badgeClass += " start"; prefix = ev.TieuDe;
                    } else if (current.getTime() === endNormalized.getTime()) {
                        badgeClass += " end"; prefix = "← Kết thúc";
                    } else {
                        badgeClass += " middle"; prefix = "↔";
                    }
                } else {
                    prefix = ev.TieuDe; 
                }

                cell.innerHTML += `<div class="${badgeClass}" style="background:${color}" onclick="event.stopPropagation(); openEditEvt(${ev.MaSuKien})">${prefix}</div>`;
            }
            current.setDate(current.getDate() + 1);
        }
    });
}

// ==========================================
// CÁC HÀM TƯƠNG TÁC LỊCH
// ==========================================
function prevMonth() { if(currentMonth===0){currentMonth=11;currentYear--;}else{currentMonth--;} renderCalendarGrid(); loadEvents(); }
function nextMonth() { if(currentMonth===11){currentMonth=0;currentYear++;}else{currentMonth++;} renderCalendarGrid(); loadEvents(); }
function goToday() { currentYear=new Date().getFullYear(); currentMonth=new Date().getMonth(); renderCalendarGrid(); loadEvents(); }

function showDayEvents(dateStr, dNum, mNum) {
    const target = new Date(dateStr);
    const dayEvents = events.filter(ev => {
        const sd = new Date(new Date(ev.ThoiGianBatDau).setHours(0,0,0,0));
        const ed = new Date(new Date(ev.ThoiGIanKetThuc).setHours(0,0,0,0));
        return target >= sd && target <= ed;
    });

    document.getElementById('dayEventsTitle').innerHTML = `<i class="bi bi-calendar-event me-2"></i>Sự kiện ngày ${dNum}/${mNum}/${target.getFullYear()} <span class="badge bg-primary ms-2">${dayEvents.length}</span>`;
    
    const list = document.getElementById('dayEventsList');
    if(!dayEvents.length) {
        list.innerHTML = `<div class="text-center text-muted py-4"><i class="fas fa-mug-hot fa-2x mb-2 opacity-50"></i><br>Không có lịch trình nào. Bạn có thể nghỉ ngơi!</div>`;
    } else {
        list.innerHTML = dayEvents.map(ev => {
            const timeSpan = new Date(ev.ThoiGianBatDau).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'}) + ' - ' + new Date(ev.ThoiGIanKetThuc).toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'});
            return `
            <div class="day-event-item">
                <div class="day-event-dot" style="background:${ev.Lich?.MauSac || '#0061ff'};"></div>
                <div style="flex:1;">
                    <div style="font-weight:800;font-size:1.1rem;color:var(--text);">${esc(ev.TieuDe)}</div>
                    <div style="font-size:.85rem;font-weight:600;color:var(--primary);margin-bottom:4px;"><i class="fas fa-clock me-1"></i>${timeSpanString(ev)}</div>
                    ${ev.DiaDiem ? `<div style="font-size:.85rem;color:var(--text-muted);"><i class="fas fa-map-marker-alt me-1"></i>${esc(ev.DiaDiem)}</div>` : ''}
                    ${ev.MoTa ? `<div style="font-size:.85rem;color:var(--text-secondary);margin-top:4px;background:#f8fafc;padding:6px 10px;border-radius:6px;">${esc(ev.MoTa)}</div>` : ''}
                </div>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    <button onclick="openEditEvt(${ev.MaSuKien})" class="btn btn-sm btn-outline-primary"><i class="fas fa-pen"></i></button>
                    <button onclick="deleteEvt(${ev.MaSuKien})" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                </div>
            </div>`;
        }).join('');
    }
    document.getElementById('dayEventsPanel').classList.remove('d-none');
    document.getElementById('dayEventsPanel').scrollIntoView({behavior: 'smooth', block: 'end'});
}

function timeSpanString(ev) {
    const s = new Date(ev.ThoiGianBatDau), e = new Date(ev.ThoiGIanKetThuc);
    if(s.toDateString() === e.toDateString()) {
        return `${s.toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})} - ${e.toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})}`;
    }
    return `${s.toLocaleDateString('vi-VN')} ${s.toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})} → ${e.toLocaleDateString('vi-VN')} ${e.toLocaleTimeString('vi-VN',{hour:'2-digit',minute:'2-digit'})}`;
}

