<div class="container text-center py-5" style="max-width:560px;">
  <div class="card border-0 shadow-lg" style="border-radius:24px; overflow:hidden;">
    <% if (success) { %>
      <div style="background:linear-gradient(135deg,#10b981,#059669); padding:50px 20px;">
        <div style="width:90px;height:90px;background:rgba(255,255,255,.2);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 0 0 10px rgba(255,255,255,0.1);">
          <i class="fas fa-check fa-3x text-white"></i>
        </div>
        <h2 class="text-white fw-bold mb-1 mt-4" style="letter-spacing:1px;">THANH TOÁN THÀNH CÔNG!</h2>
      </div>
      <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
      <script>confetti({ particleCount: 150, spread: 80, origin: { y: 0.6 } });</script>
    <% } else { %>
      <div style="background:linear-gradient(135deg,#ef4444,#dc2626); padding:50px 20px;">
        <div style="width:90px;height:90px;background:rgba(255,255,255,.2);border-radius:50%;display:inline-flex;align-items:center;justify-content:center;box-shadow:0 0 0 10px rgba(255,255,255,0.1);">
          <i class="fas fa-times fa-3x text-white"></i>
        </div>
        <h2 class="text-white fw-bold mb-1 mt-4" style="letter-spacing:1px;">GIAO DỊCH THẤT BẠI</h2>
      </div>
    <% } %>

    <div class="card-body p-5 bg-white">
      <% if (typeof result !== 'undefined' && result) { %>
        <div style="background:var(--bg-soft);border-radius:16px;padding:20px;text-align:left;margin-bottom:30px;border:1px solid var(--border-light);">
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <span style="color:var(--text-muted);font-size:.9rem;">Mã giao dịch</span>
            <span style="font-weight:800;font-family:monospace;font-size:1rem;"><%= result.txnRef %></span>
          </div>
          <div style="display:flex;justify-content:space-between;margin-bottom:12px;">
            <span style="color:var(--text-muted);font-size:.9rem;">Ngân hàng</span>
            <span style="font-weight:700;"><%= result.bankCode || 'VNPAY' %></span>
          </div>
          <div style="display:flex;justify-content:space-between;border-top:1px dashed #cbd5e1;padding-top:12px;margin-top:12px;">
            <span style="color:var(--text-muted);font-size:1rem;font-weight:600;">Tổng tiền</span>
            <span style="font-weight:900;font-size:1.3rem;color:var(--primary);"><%= Number(result.amount/100).toLocaleString('vi-VN') %> ₫</span>
          </div>
        </div>
      <% } %>

      <div class="d-grid gap-3">
        <button onclick="dongCuaSo()" class="btn-hc-primary" style="justify-content:center;padding:14px;font-size:1rem;border-radius:14px;">
          <i class="fas fa-check-circle me-2"></i>Hoàn tất
        </button>
      </div>
    </div>
  </div>
</div>

<script>
// Logic của C#: Báo về cho cửa sổ mẹ (nếu có) và tự động đóng.
function dongCuaSo() {
    if (window.opener && !window.opener.closed) {
        if (typeof window.opener.vnpayCallback === 'function') {
            window.opener.vnpayCallback(<%= success ? 'true' : 'false' %>);
        }
        window.close();
    } else {
        window.location.href = '/hoa-don-dich-vu';
    }
}
// Nếu tải trên popup, tự động gọi callback sau 3s
if (window.opener && !window.opener.closed) {
    setTimeout(dongCuaSo, 3000);
}
</script>