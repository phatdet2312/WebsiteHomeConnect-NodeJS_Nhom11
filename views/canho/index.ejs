<!-- views/canho/index.ejs -->
<div style="background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:36px 0 28px;">
  <div class="container">
    <h1 style="font-size:1.6rem;font-weight:800;color:white;margin:0 0 4px;"><i class="fas fa-home me-3" style="opacity:.8;"></i>Căn hộ của tôi</h1>
    <p style="color:rgba(255,255,255,.7);margin:0;font-size:.875rem;">Danh sách hợp đồng và căn hộ bạn đang sở hữu / thuê</p>
  </div>
</div>

<div class="container py-4">
  <div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải...</p></div>
  </div>
  <div id="errorState" class="hc-toast hc-toast-danger d-none" style="position:static;margin-bottom:16px;"></div>
  <div id="contractList" class="row g-4 d-none"></div>
</div>

<style> 
.contract-card { background:var(--bg-white); border-radius:var(--radius-lg); border:1px solid var(--border-light);
  box-shadow:var(--shadow-sm); overflow:hidden; transition:transform .2s,box-shadow .2s; height:100%; display:flex; flex-direction:column; }
.contract-card:hover { transform:translateY(-3px); box-shadow:var(--shadow-md); }
.contract-img { height:180px; object-fit:cover; width:100%; display:block; }
.contract-body { padding:16px; flex:1; display:flex; flex-direction:column; gap:6px; }
.contract-name { font-size:.95rem; font-weight:700; color:var(--text); }
.contract-loc { font-size:.8rem; color:var(--text-muted); }
.contract-price { font-size:1rem; font-weight:700; color:var(--primary); }
.contract-meta { font-size:.78rem; color:var(--text-muted); }
.contract-footer { padding:12px 16px; border-top:1px solid var(--border-light); }
.status-pill { display:inline-block; padding:3px 10px; border-radius:20px; font-size:.72rem; font-weight:700; }
.status-active { background:#dcfce7; color:#15803d; }
.status-ended { background:#fee2e2; color:#b91c1c; }
.status-pending { background:#fef9c3; color:#a16207; }
</style>

<script>
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

fetch('/api/my-contracts')
  .then(r=>{ if(r.status===401){window.location.href='/auth/login';return null;} return r.json(); })
  .then(data=>{
    if(!data) return;
    document.getElementById('loadingState').classList.add('d-none');
    const el = document.getElementById('contractList');
    el.classList.remove('d-none');
    if(!data.length){
      el.innerHTML = `<div class="col-12"><div class="hc-empty"><div class="empty-icon"><i class="fas fa-home"></i></div><div class="empty-title">Bạn chưa có hợp đồng nào</div><div class="empty-desc">Khám phá và đặt căn hộ ngay hôm nay</div><a href="/kham-pha" class="btn-hc-primary mt-3" style="margin:12px auto 0;">Tìm căn hộ</a></div></div>`;
      return;
    }
    el.innerHTML = data.map(hd=>{
      const canHo = hd.CanHo||{};
      const img = canHo.DSA_CanHos&&canHo.DSA_CanHos.length>0 ? canHo.DSA_CanHos[0].UrlAnh : '/images/no-image.jpg';
      const tang = canHo.Tang ? canHo.Tang.TenTang : '';
      const toa = canHo.Tang&&canHo.Tang.ToaNha ? canHo.Tang.ToaNha.TenToaNha : '';
      const loc = [toa, tang?'Tầng '+tang:''].filter(Boolean).join(' · ');
      const loai = hd.LoaiHopDong ? hd.LoaiHopDong.TenLoai : '';
      const statusCls = hd.TrangThaiHD===true ? 'status-active' : hd.TrangThaiHD===false ? 'status-ended' : 'status-pending';
      const statusTxt = hd.TrangThaiHD===true ? 'Đang hoạt động' : hd.TrangThaiHD===false ? 'Đã kết thúc' : 'Chờ phê duyệt';
      const gia = hd.GiaThoaThuan ? Number(hd.GiaThoaThuan).toLocaleString('vi-VN')+'đ' : '';
      const ngay = hd.NgayHieuLuc ? new Date(hd.NgayHieuLuc).toLocaleDateString('vi-VN') : '';
      const ngayHet = hd.NgayHetHan ? new Date(hd.NgayHetHan).toLocaleDateString('vi-VN') : '';
      return `<div class="col-md-6 col-lg-4">
        <div class="contract-card">
          <div style="position:relative;overflow:hidden;height:180px;cursor:pointer;" onclick="location.href='/can-ho/${hd.MaHopDong}'">
            <img src="${img}" class="contract-img" alt="${esc(canHo.TenCanHo||'')}">
            <div style="position:absolute;top:12px;right:12px;"><span class="status-pill ${statusCls}">${statusTxt}</span></div>
          </div>
          <div class="contract-body">
            <div class="contract-name">${esc(canHo.TenCanHo||'')}</div>
            ${loc ? `<div class="contract-loc"><i class="fas fa-building me-1"></i>${esc(loc)}</div>` : ''}
            ${loai ? `<div class="contract-meta"><i class="fas fa-file-contract me-1"></i>${esc(loai)}</div>` : ''}
            ${gia ? `<div class="contract-price">${gia}</div>` : ''}
            ${ngay ? `<div class="contract-meta"><i class="fas fa-calendar me-1"></i>${ngay}${ngayHet?' → '+ngayHet:''}</div>` : ''}
          </div>
          <div class="contract-footer">
            <a href="/can-ho/${hd.MaHopDong}" class="btn-ghost w-100" style="justify-content:center;font-size:.82rem;">
              <i class="fas fa-eye me-2"></i>Xem chi tiết
            </a>
          </div>
        </div>
      </div>`;
    }).join('');
  })
  .catch(()=>{
    document.getElementById('loadingState').classList.add('d-none');
    const e = document.getElementById('errorState');
    e.innerHTML = '<i class="fas fa-exclamation-circle" style="color:var(--danger);"></i><span>Lỗi tải dữ liệu</span>';
    e.classList.remove('d-none');
  });
</script>
