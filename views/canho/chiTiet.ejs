<!-- views/canho/chiTiet.ejs -->
<div style="background:var(--bg-white);border-bottom:1px solid var(--border-light);padding:14px 0;">
  <div class="container">
    <nav style="font-size:.82rem;color:var(--text-muted);display:flex;align-items:center;gap:6px;">
      <a href="/" style="color:var(--text-muted);text-decoration:none;">Trang chủ</a>
      <i class="fas fa-chevron-right" style="font-size:.6rem;"></i>
      <a href="/can-ho" style="color:var(--text-muted);text-decoration:none;">Căn hộ của tôi</a>
      <i class="fas fa-chevron-right" style="font-size:.6rem;"></i>
      <span id="breadcrumbName" style="color:var(--text);font-weight:600;">Chi tiết hợp đồng</span>
    </nav>
  </div>
</div>

<div class="container py-4">
  <div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải thông tin hợp đồng...</p></div>
  </div>
  <div id="errorState" class="hc-toast hc-toast-danger d-none" style="position:static;margin-bottom:16px;"></div>
  <div id="mainContent" class="row g-4 d-none">
    <div class="col-lg-7 col-xl-8" id="leftCol"></div>
    
    <div class="col-lg-5 col-xl-4" id="rightCol"></div>
  </div>
</div>

<style>
.detail-section { background:var(--bg-white); border-radius:var(--radius-lg); border:1px solid var(--border-light);
  box-shadow:var(--shadow-sm); padding:24px; margin-bottom:20px; }
.detail-section-title { font-size:1.05rem; font-weight:800; color:var(--text); margin-bottom:16px;
  display:flex; align-items:center; gap:8px; padding-bottom:12px; border-bottom:1px solid var(--border-light); }
.detail-section-title i { color:var(--primary); }
.info-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
.info-item { display:flex; flex-direction:column; gap:4px; }
.info-lbl { font-size:.72rem; color:var(--text-muted); text-transform:uppercase; letter-spacing:.05em; font-weight:700; }
.info-val { font-size:.9rem; font-weight:700; color:var(--text); }
.nt-table { width:100%; border-collapse:collapse; font-size:.84rem; }
.nt-table th { color:var(--text-muted); font-weight:700; font-size:.72rem; text-transform:uppercase; letter-spacing:.04em; padding:10px 12px; border-bottom:2px solid var(--border-light); text-align:left; background:var(--bg-soft); }
.nt-table td { padding:12px; border-bottom:1px solid var(--border-light); color:var(--text); font-weight:600; }
.nt-table tr:last-child td { border-bottom:none; }
.nt-badge { display:inline-block; padding:4px 10px; border-radius:6px; font-size:.72rem; font-weight:700; background:var(--primary-light); color:var(--primary); }

.img-gallery-main { border-radius:var(--radius-lg); overflow:hidden; height:400px; background:var(--bg); margin-bottom:12px; box-shadow:var(--shadow-sm); }
.img-gallery-main img { width:100%; height:100%; object-fit:cover; transition:transform .3s; }
.img-gallery-main:hover img { transform:scale(1.02); }
.img-thumbs { display:flex; gap:10px; flex-wrap:wrap; }
.img-thumb { width:80px; height:60px; border-radius:8px; object-fit:cover; cursor:pointer; border:2px solid transparent; transition:all .2s; opacity:0.7; }
.img-thumb:hover { opacity:1; }
.img-thumb.active { border-color:var(--primary); opacity:1; box-shadow:0 2px 8px rgba(0,0,0,0.15); }
.dv-chip { display:flex; align-items:center; gap:10px; padding:12px; background:var(--bg-white); border:1px solid var(--border-light); border-radius:10px; box-shadow:var(--shadow-sm); }
.dv-chip i { color:var(--success); font-size:1.2rem; }

/* DESIGN THẺ HỢP ĐỒNG VIP (CỘT PHẢI) */
.contract-receipt { background:var(--bg-white); border-radius:var(--radius-lg); box-shadow:0 10px 30px rgba(0,0,0,0.08); overflow:hidden; position:sticky; top:80px; border:1px solid rgba(0,0,0,0.05); }
.cr-header { background:linear-gradient(135deg, #1e293b, #0f172a); padding:24px; position:relative; overflow:hidden; }
.cr-header::after { content:''; position:absolute; bottom:-10px; left:0; right:0; height:20px; background:var(--bg-white); border-radius:50% 50% 0 0; }
.cr-status { position:absolute; top:20px; right:20px; padding:4px 12px; border-radius:20px; font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:0.05em; z-index:2; }
.cr-status.active { background:rgba(34,197,94,0.2); color:#4ade80; border:1px solid rgba(34,197,94,0.4); }
.cr-status.ended { background:rgba(239,68,68,0.2); color:#f87171; border:1px solid rgba(239,68,68,0.4); }
.cr-status.pending { background:rgba(245,158,11,0.2); color:#fbbf24; border:1px solid rgba(245,158,11,0.4); }
.cr-body { padding:24px; }
.cr-section { margin-bottom:20px; }
.cr-label { font-size:.72rem; color:var(--text-muted); text-transform:uppercase; font-weight:700; letter-spacing:0.05em; margin-bottom:4px; }
.cr-value { font-size:.95rem; font-weight:800; color:var(--text); }
.cr-divider { border-top:2px dashed var(--border-light); margin:20px 0; }
.cr-total { background:#f8fafc; border-radius:12px; padding:16px; text-align:center; border:1px solid var(--border-light); }
.cr-total-lbl { font-size:.8rem; font-weight:700; color:var(--text-secondary); text-transform:uppercase; }
.cr-total-val { font-size:1.6rem; font-weight:900; color:var(--primary); margin-top:4px; }
</style>

<script>
const contractId = window.location.pathname.split('/').pop();
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

fetch('/can-ho/api/my-contracts/' + contractId)
  .then(r=>{ if(r.status===401){window.location.href='/auth/login';return null;} return r.json(); })
  .then(hd=>{
    if(!hd) return;
    if(hd.error){ showError(hd.error); return; }
    document.getElementById('loadingState').classList.add('d-none');
    document.getElementById('mainContent').classList.remove('d-none');
    document.getElementById('breadcrumbName').textContent = 'Hợp đồng #' + hd.MaHopDong;
    renderLeft(hd);
    renderRight(hd);
  })
  .catch(()=>showError('Lỗi tải dữ liệu. Vui lòng thử lại.'));

function showError(msg) {
  document.getElementById('loadingState').classList.add('d-none');
  const el = document.getElementById('errorState');
  el.innerHTML = `<i class="fas fa-exclamation-circle" style="color:var(--danger);"></i><span>${esc(msg)}</span>`;
  el.classList.remove('d-none');
}

function renderLeft(hd) {
  const canHo = hd.CanHo||{};
  const imgs = canHo.DSA_CanHos||[];

  let imgHtml = '';
  if(imgs.length>0){
    imgHtml = `<div class="img-gallery-main"><img id="mainImg" src="${imgs[0].UrlAnh}" alt="${esc(canHo.TenCanHo||'')}"></div>`;
    if(imgs.length>1) imgHtml += `<div class="img-thumbs mb-4">${imgs.map((img,i)=>`<img src="${img.UrlAnh}" class="img-thumb${i===0?' active':''}" onclick="selectImg(this,'${img.UrlAnh}')">`).join('')}</div>`;
    else imgHtml += '<div class="mb-4"></div>';
  }

  const tang = canHo.Tang?canHo.Tang.TenTang:'';
  const toa = canHo.Tang&&canHo.Tang.ToaNha?canHo.Tang.ToaNha.TenToaNha:'';
  let infoItems = '';
  if(canHo.TenCanHo) infoItems += `<div class="info-item"><div class="info-lbl">Tên căn hộ</div><div class="info-val">${esc(canHo.TenCanHo)}</div></div>`;
  if(tang||toa) infoItems += `<div class="info-item"><div class="info-lbl">Vị trí</div><div class="info-val">${esc(toa)}${tang?' · Tầng '+esc(tang):''}</div></div>`;
  if(canHo.Dai||canHo.Rong) infoItems += `<div class="info-item"><div class="info-lbl">Kích thước</div><div class="info-val">${canHo.Dai||'?'}×${canHo.Rong||'?'}m</div></div>`;
  if(canHo.TamNhin) infoItems += `<div class="info-item"><div class="info-lbl">Hướng nhìn</div><div class="info-val">${esc(canHo.TamNhin)}</div></div>`;
  if(canHo.HienTrang) infoItems += `<div class="info-item"><div class="info-lbl">Hiện trạng</div><div class="info-val"><span class="nt-badge">${esc(canHo.HienTrang.TenHienTrang)}</span></div></div>`;
  let canHoCard = `<div class="detail-section"><div class="detail-section-title"><i class="fas fa-home"></i>Thông tin căn hộ</div><div class="info-grid">${infoItems}</div></div>`;

  let phongHtml = '';
  if(canHo.Phongs&&canHo.Phongs.length>0){
    phongHtml = `<div class="detail-section"><div class="detail-section-title"><i class="fas fa-door-open"></i>Cấu trúc phòng <span style="font-size:.85rem;color:var(--text-muted);font-weight:600;margin-left:4px;">(${canHo.Phongs.length} phòng)</span></div>
      <div class="row g-3">${canHo.Phongs.map(p=>{
        const pImg=p.DSA_Phongs&&p.DSA_Phongs.length>0?p.DSA_Phongs[0].UrlAnh:null;
        return `<div class="col-sm-6"><div style="background:var(--bg-white);border:1px solid var(--border-light);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm);">
          ${pImg?`<img src="${pImg}" style="width:100%;height:120px;object-fit:cover;">`:``}
          <div style="padding:12px;font-size:.9rem;font-weight:700;color:var(--text);text-align:center;">${esc(p.TenPhong)}</div>
        </div></div>`;
      }).join('')}</div></div>`;
  }

  let ntHtml = '';
  if(canHo.CT_NoiThats&&canHo.CT_NoiThats.length>0){
    const rows = canHo.CT_NoiThats.map(nt=>{
      const ten=nt.NoiThat?esc(nt.NoiThat.TenNoiThat):'';
      const dm=nt.NoiThat&&nt.NoiThat.DanhMucNoiThat?esc(nt.NoiThat.DanhMucNoiThat.TenDanhMuc):'';
      const ht=nt.HienTrangCT?`<span class="nt-badge">${esc(nt.HienTrangCT.TenHienTrang)}</span>`:'';
      return `<tr><td>${ten}</td><td style="color:var(--text-secondary);">${dm}</td><td>${ht}</td><td style="text-align:center;">${nt.SoLuong||1}</td></tr>`;
    }).join('');
    ntHtml = `<div class="detail-section"><div class="detail-section-title"><i class="fas fa-couch"></i>Bàn giao nội thất</div>
      <div style="overflow-x:auto;"><table class="nt-table"><thead><tr><th>Tên trang bị</th><th>Danh mục</th><th>Tình trạng</th><th style="text-align:center;">Số lượng</th></tr></thead><tbody>${rows}</tbody></table></div></div>`;
  }

  let dvHtml = '';
  if(canHo.CT_DichVus&&canHo.CT_DichVus.filter(cd=>cd.DichVu).length>0){
    dvHtml = `<div class="detail-section"><div class="detail-section-title"><i class="fas fa-concierge-bell"></i>Dịch vụ tiêu chuẩn</div>
      <div class="row g-3">${canHo.CT_DichVus.filter(cd=>cd.DichVu).map(cd=>`<div class="col-sm-6"><div class="dv-chip"><i class="fas fa-check-circle"></i><div><div style="font-weight:700;font-size:.9rem;color:var(--text);">${esc(cd.DichVu.TenDV)}</div>${cd.DichVu.DonGia?`<div style="font-size:.75rem;color:var(--text-muted);font-weight:600;">${Number(cd.DichVu.DonGia).toLocaleString('vi-VN')} đ/tháng</div>`:''}</div></div></div>`).join('')}</div></div>`;
  }

  document.getElementById('leftCol').innerHTML = imgHtml + canHoCard + phongHtml + ntHtml + dvHtml;
}

function renderRight(hd) {
  const statusCls = hd.TrangThaiHD===true ? 'active' : hd.TrangThaiHD===false ? 'ended' : 'pending';
  const statusTxt = hd.TrangThaiHD===true ? 'Đang hiệu lực' : hd.TrangThaiHD===false ? 'Đã kết thúc' : 'Chờ phê duyệt';

  // Format Dates
  const fDate = (dStr) => dStr ? new Date(dStr).toLocaleDateString('vi-VN') : '---';

  let btns = '';
  if(hd.TrangThaiHD===true){
    // ĐÃ FIX: Điều hướng chuẩn xác về danh mục thanh toán
    btns += `<a href="/dich-vu" class="btn-hc-primary w-100" style="justify-content:center;margin-bottom:12px;text-decoration:none;padding:12px;font-size:.95rem;"><i class="fas fa-tint me-2"></i>Thanh toán Dịch vụ (Điện, Nước...)</a>`;
    btns += `<a href="/thanh-toan-hop-dong" class="w-100" style="justify-content:center;margin-bottom:12px;display:flex;align-items:center;gap:8px;padding:12px;background:#8b5cf6;color:white;border:none;border-radius:var(--radius-md);font-weight:700;font-size:.95rem;text-decoration:none;box-shadow:0 4px 10px rgba(139,92,246,0.3);"><i class="fas fa-file-invoice-dollar me-2"></i>Thanh toán Hợp đồng</a>`;
  }

  document.getElementById('rightCol').innerHTML = `
    <div class="contract-receipt">
      <div class="cr-header">
        <div class="cr-status ${statusCls}"><i class="fas fa-circle me-1" style="font-size:8px;vertical-align:middle;"></i>${statusTxt}</div>
        <div style="font-size:.8rem;color:#94a3b8;font-weight:600;letter-spacing:1px;margin-bottom:4px;">HỢP ĐỒNG ${esc(hd.LoaiHopDong?.TenLoai||'').toUpperCase()}</div>
        <div style="font-size:1.8rem;font-weight:900;color:white;letter-spacing:1px;">#${hd.MaHopDong}</div>
      </div>
      <div class="cr-body">
        
        <div class="cr-section">
            <div class="cr-label"><i class="fas fa-user-tie me-1"></i>Đại diện BQL (Bên A)</div>
            <div class="cr-value">${esc(hd.NhanVien?.TenNV || 'Chưa phân công')}</div>
        </div>

        <div class="cr-section">
            <div class="cr-label"><i class="fas fa-user me-1"></i>Khách hàng (Bên B)</div>
            <div class="cr-value text-primary">${esc(hd.KhachHang?.TenKH || '---')}</div>
            <div style="font-size:.8rem;color:var(--text-secondary);font-weight:600;margin-top:2px;">Vai trò: ${esc(hd.VaiTroHD?.TenVaiTro || 'Khách hàng')}</div>
        </div>

        <div class="cr-divider"></div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
                <div class="cr-label">Ngày Lập</div>
                <div class="cr-value" style="font-size:.85rem;">${fDate(hd.NgayLap)}</div>
            </div>
            <div>
                <div class="cr-label">Hiệu lực từ</div>
                <div class="cr-value" style="font-size:.85rem;">${fDate(hd.NgayHieuLuc)}</div>
            </div>
            <div style="grid-column: span 2;">
                <div class="cr-label text-danger">Hết hạn hợp đồng</div>
                <div class="cr-value text-danger">${fDate(hd.NgayHetHan)}</div>
            </div>
        </div>

        <div class="cr-divider"></div>

        <div class="cr-total">
            <div class="cr-total-lbl">Giá thỏa thuận</div>
            <div class="cr-total-val">${Number(hd.GiaThoaThuan || 0).toLocaleString('vi-VN')} ₫</div>
        </div>

        <div style="margin-top:24px;">
            ${btns}
            <a href="/can-ho" class="btn-ghost w-100" style="justify-content:center;text-decoration:none;font-size:.9rem;padding:12px;"><i class="fas fa-arrow-left me-2"></i>Trở về danh sách</a>
        </div>

      </div>
    </div>`;
}

function selectImg(el, src) {
  document.getElementById('mainImg').src = src;
  document.querySelectorAll('.img-thumb').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
}
</script>