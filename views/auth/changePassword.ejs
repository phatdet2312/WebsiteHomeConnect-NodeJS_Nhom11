<div class="container" style="max-width:480px; margin: 60px auto;">
  <div class="card shadow border-0" style="border-radius:16px; overflow:hidden;">
    <div style="background:linear-gradient(135deg,#1565c0,#42a5f5); padding:24px; text-align:center;">
      <h4 class="text-white mb-1"><i class="fas fa-key me-2"></i>Đổi mật khẩu</h4>
      <p class="text-white-50 mb-0 small">Bảo vệ tài khoản của bạn</p>
    </div>
    <div class="card-body p-4">
      <% if (success_msg && success_msg.length > 0) { %>
        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i><%= success_msg %></div>
      <% } %>
      <% if (error_msg && error_msg.length > 0) { %>
        <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i><%= error_msg %></div>
      <% } %>

      <form method="POST" action="/auth/change-password" id="changePwdForm">
        <div class="mb-3">
          <label class="form-label fw-semibold">Mật khẩu hiện tại</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="OldPassword" id="oldPwd" class="form-control" placeholder="Nhập mật khẩu hiện tại" required>
            <button type="button" class="btn btn-outline-secondary" onclick="toggleField('oldPwd','eyeOld')"><i class="fas fa-eye" id="eyeOld"></i></button>
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label fw-semibold">Mật khẩu mới</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock-open"></i></span>
            <input type="password" name="NewPassword" id="newPwd" class="form-control" placeholder="Ít nhất 6 ký tự" required minlength="6">
            <button type="button" class="btn btn-outline-secondary" onclick="toggleField('newPwd','eyeNew')"><i class="fas fa-eye" id="eyeNew"></i></button>
          </div>
          <div class="mt-1">
            <div id="strengthBar" style="height:4px;background:#dee2e6;border-radius:2px;">
              <div id="strengthFill" style="height:100%;width:0;border-radius:2px;transition:width .3s;"></div>
            </div>
            <small id="strengthText" class="text-muted"></small>
          </div>
        </div>
        <div class="mb-4">
          <label class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
          <div class="input-group">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <input type="password" name="ConfirmPassword" id="confirmPwd" class="form-control" placeholder="Nhập lại mật khẩu mới" required>
            <button type="button" class="btn btn-outline-secondary" onclick="toggleField('confirmPwd','eyeConf')"><i class="fas fa-eye" id="eyeConf"></i></button>
          </div>
          <div id="matchMsg" class="small mt-1"></div>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary py-2 fw-semibold" style="border-radius:10px;">
            <i class="fas fa-save me-2"></i>Cập nhật mật khẩu
          </button>
          <a href="/" class="btn btn-outline-secondary" style="border-radius:10px;">
            <i class="fas fa-arrow-left me-2"></i>Quay lại trang chủ
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function toggleField(fieldId, iconId) {
  const f = document.getElementById(fieldId);
  const e = document.getElementById(iconId);
  f.type = f.type === 'password' ? 'text' : 'password';
  e.className = f.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}

document.getElementById('newPwd').addEventListener('input', function() {
  const val = this.value;
  const fill = document.getElementById('strengthFill');
  const text = document.getElementById('strengthText');
  let strength = 0;
  if (val.length >= 6) strength++;
  if (val.length >= 10) strength++;
  if (/[A-Z]/.test(val)) strength++;
  if (/[0-9]/.test(val)) strength++;
  if (/[^A-Za-z0-9]/.test(val)) strength++;
  const pct = (strength / 5) * 100;
  fill.style.width = pct + '%';
  if (strength <= 1) { fill.style.background = '#ef5350'; text.textContent = 'Yếu'; text.className = 'text-danger small'; }
  else if (strength <= 3) { fill.style.background = '#ff9800'; text.textContent = 'Trung bình'; text.className = 'text-warning small'; }
  else { fill.style.background = '#43a047'; text.textContent = 'Mạnh'; text.className = 'text-success small'; }
});

document.getElementById('confirmPwd').addEventListener('input', function() {
  const match = document.getElementById('matchMsg');
  if (this.value === document.getElementById('newPwd').value) {
    match.innerHTML = '<span class="text-success"><i class="fas fa-check me-1"></i>Mật khẩu khớp</span>';
  } else {
    match.innerHTML = '<span class="text-danger"><i class="fas fa-times me-1"></i>Mật khẩu không khớp</span>';
  }
});

document.getElementById('changePwdForm').addEventListener('submit', function(e) {
  const np = document.getElementById('newPwd').value;
  const cp = document.getElementById('confirmPwd').value;
  if (np !== cp) {
    e.preventDefault();
    alert('Mật khẩu xác nhận không khớp!');
  }
});
</script>