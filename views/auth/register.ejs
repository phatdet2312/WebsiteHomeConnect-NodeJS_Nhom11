<div class="hc-auth-page">
  <div class="hc-auth-card" style="max-width:500px;">
    <div class="auth-header">
      <a href="/" class="auth-brand">
        <div class="auth-brand-icon"><i class="fas fa-home"></i></div>
        <span>HomeConnect</span>
      </a>
      <h2 class="auth-title">Tạo tài khoản mới</h2>
      <p class="auth-sub">Đăng ký để bắt đầu hành trình tìm kiếm nhà của bạn</p>
    </div>

    <div class="step-indicator">
      <div class="step-item active" id="s1ind">
        <div class="step-dot" id="s1dot"><span>1</span></div>
        <div class="step-label">Thông tin</div>
      </div>
      <div class="step-line" id="sline"></div>
      <div class="step-item" id="s2ind">
        <div class="step-dot inactive" id="s2dot"><span>2</span></div>
        <div class="step-label">Xác thực OTP</div>
      </div>
    </div>

    <div id="alertArea"></div>

    <div id="step1">
      <div class="auth-field">
        <label class="auth-label">Họ và tên</label>
        <div class="auth-input-wrap">
          <i class="fas fa-id-card auth-input-icon"></i>
          <input type="text" id="HoTen" class="auth-input" placeholder="Nguyễn Văn A" required>
        </div>
      </div>
      <div class="auth-field">
        <label class="auth-label">Tên đăng nhập</label>
        <div class="auth-input-wrap">
          <i class="fas fa-user auth-input-icon"></i>
          <input type="text" id="UserName" class="auth-input" placeholder="username" required>
        </div>
      </div>
      <div class="auth-field">
        <label class="auth-label">Email</label>
        <div class="auth-input-wrap">
          <i class="fas fa-envelope auth-input-icon"></i>
          <input type="email" id="Email" class="auth-input" placeholder="email@example.com" required>
        </div>
      </div>
      <div class="auth-field">
        <label class="auth-label">Mật khẩu</label>
        <div class="auth-input-wrap">
          <i class="fas fa-lock auth-input-icon"></i>
          <input type="password" id="Password" class="auth-input" placeholder="Ít nhất 6 ký tự" required minlength="6" style="padding-right:48px;">
          <button type="button" class="auth-eye-btn" onclick="togglePwd('Password','eyeP')"><i class="fas fa-eye" id="eyeP"></i></button>
        </div>
      </div>
      <div class="auth-field">
        <label class="auth-label">Xác nhận mật khẩu</label>
        <div class="auth-input-wrap">
          <i class="fas fa-lock auth-input-icon"></i>
          <input type="password" id="ConfirmPassword" class="auth-input" placeholder="Nhập lại mật khẩu" required style="padding-right:48px;">
          <button type="button" class="auth-eye-btn" onclick="togglePwd('ConfirmPassword','eyeCP')"><i class="fas fa-eye" id="eyeCP"></i></button>
        </div>
      </div>
      <button type="button" id="sendCodeBtn" class="btn-hc-primary w-100" style="justify-content:center;padding:13px;font-size:.9rem;" onclick="sendCode()">
        <span id="sendBtnText"><i class="fas fa-paper-plane me-2"></i>Gửi mã xác thực</span>
        <span id="sendBtnLoading" class="d-none"><span class="hc-spinner" style="width:16px;height:16px;margin-right:8px;"></span>Đang gửi...</span>
      </button>
    </div>

    <div id="step2" class="d-none">
      <div style="text-align:center;margin-bottom:24px;">
        <div style="width:64px;height:64px;background:var(--primary-light);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:1.5rem;color:var(--primary);">
          <i class="fas fa-envelope-open-text"></i>
        </div>
        <p style="color:var(--text-secondary);font-size:.9rem;margin:0;">Mã OTP đã được gửi đến email</p>
        <p style="font-weight:700;color:var(--text);margin:4px 0;font-size:.9rem;" id="emailDisplay"></p>
        <p style="font-size:.8rem;color:var(--text-muted);margin:0;">Mã có hiệu lực trong 10 phút</p>
      </div>
      <div class="auth-field">
        <label class="auth-label" style="text-align:center;display:block;">Nhập mã OTP (6 chữ số)</label>
        <input type="text" id="otpInput" class="auth-input" style="text-align:center;font-size:1.8rem;font-weight:700;letter-spacing:.6rem;padding:14px;padding-left:0;"
               placeholder="- - - - - -" maxlength="6">
      </div>
      <button type="button" id="verifyBtn" class="w-100" style="justify-content:center;padding:13px;font-size:.9rem;background:var(--success);color:white;border:none;border-radius:var(--radius-md);font-weight:700;cursor:pointer;display:flex;align-items:center;margin-bottom:10px;" onclick="verifyCode()">
        <span id="verifyBtnText"><i class="fas fa-check-circle me-2"></i>Xác nhận đăng ký</span>
        <span id="verifyBtnLoading" class="d-none"><span class="hc-spinner" style="width:16px;height:16px;margin-right:8px;"></span>Đang xác nhận...</span>
      </button>
      <button type="button" class="btn-ghost w-100" style="justify-content:center;" onclick="goBack()">
        <i class="fas fa-arrow-left me-2"></i>Quay lại
      </button>
    </div>

    <div class="auth-footer-link" style="margin-top:20px;">
      Đã có tài khoản? <a href="/auth/login">Đăng nhập</a>
    </div>
  </div>
</div>

<style>
.hc-auth-page { min-height:calc(100vh - var(--navbar-h)); display:flex; align-items:center; justify-content:center;
  padding:32px 16px; background:linear-gradient(135deg,#f0f4ff 0%,#e8f0fe 50%,#f4f0ff 100%); }
.hc-auth-card { background:var(--bg-white); border-radius:var(--radius-xl,24px); box-shadow:var(--shadow-lg,0 20px 60px rgba(26,32,64,.12));
  padding:36px 32px; width:100%; border:1px solid var(--border-light); }
.auth-header { text-align:center; margin-bottom:24px; }
.auth-brand { display:inline-flex; align-items:center; gap:10px; text-decoration:none; margin-bottom:16px; }
.auth-brand-icon { width:38px; height:38px; background:linear-gradient(135deg,var(--primary),#4f46e5); border-radius:10px;
  display:flex; align-items:center; justify-content:center; color:white; font-size:.95rem; }
.auth-brand span { font-size:1.05rem; font-weight:800; color:var(--text); }
.auth-title { font-size:1.3rem; font-weight:800; color:var(--text); margin:0 0 5px; }
.auth-sub { font-size:.82rem; color:var(--text-muted); margin:0; }
.step-indicator { display:flex; align-items:center; justify-content:center; margin-bottom:24px; }
.step-item { display:flex; flex-direction:column; align-items:center; gap:4px; }
.step-dot { width:36px; height:36px; border-radius:50%; background:var(--primary); color:white;
  display:flex; align-items:center; justify-content:center; font-size:.875rem; font-weight:700; }
.step-dot.inactive { background:var(--bg); color:var(--text-muted); border:2px solid var(--border); }
.step-label { font-size:.72rem; font-weight:600; color:var(--text-muted); }
.step-item.active .step-label { color:var(--primary); }
.step-line { flex:1; height:3px; background:var(--border-light); margin:0 12px 20px; min-width:60px; transition:background .3s; }
.step-line.done { background:var(--primary); }
.auth-field { margin-bottom:14px; }
.auth-label { display:block; font-size:.75rem; font-weight:600; color:var(--text-secondary); margin-bottom:5px; text-transform:uppercase; letter-spacing:.04em; }
.auth-input-wrap { position:relative; }
.auth-input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:.85rem; pointer-events:none; }
.auth-input { width:100%; padding:11px 14px 11px 40px; border:1.5px solid var(--border); border-radius:var(--radius-md);
  font-size:.875rem; color:var(--text); background:var(--bg-white); outline:none; transition:border-color .2s, box-shadow .2s; box-sizing:border-box; }
.auth-input:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(0,97,255,.1); }
.auth-eye-btn { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:var(--text-muted); cursor:pointer; padding:4px; font-size:.85rem; }
.auth-alert { padding:11px 16px; border-radius:var(--radius-md); font-size:.86rem; margin-bottom:14px; display:flex; align-items:center; }
.auth-alert-danger { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
.auth-alert-success { background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; }
.auth-footer-link { text-align:center; font-size:.84rem; color:var(--text-muted); }
.auth-footer-link a { color:var(--primary); font-weight:600; text-decoration:none; }
</style>

<script>
function togglePwd(fieldId, iconId) {
  const f = document.getElementById(fieldId);
  const e = document.getElementById(iconId);
  f.type = f.type === 'password' ? 'text' : 'password';
  e.className = f.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}

function showAlert(msg, type) {
  document.getElementById('alertArea').innerHTML =
    `<div class="auth-alert auth-alert-${type}"><i class="fas fa-${type==='success'?'check':'exclamation'}-circle me-2"></i>${msg}</div>`;
}

async function sendCode() {
  const HoTen = document.getElementById('HoTen').value.trim();
  const UserName = document.getElementById('UserName').value.trim();
  const Email = document.getElementById('Email').value.trim();
  const Password = document.getElementById('Password').value;
  const ConfirmPassword = document.getElementById('ConfirmPassword').value;

  if (!HoTen || !UserName || !Email || !Password)
    return showAlert('Vui lòng điền đầy đủ thông tin', 'danger');
  if (Password !== ConfirmPassword)
    return showAlert('Mật khẩu xác nhận không khớp', 'danger');
  if (Password.length < 6)
    return showAlert('Mật khẩu phải có ít nhất 6 ký tự', 'danger');

  document.getElementById('sendBtnText').classList.add('d-none');
  document.getElementById('sendBtnLoading').classList.remove('d-none');
  document.getElementById('sendCodeBtn').disabled = true;
  document.getElementById('alertArea').innerHTML = '';

  try {
    // FIX ĐƯỜNG DẪN FETCH CHUẨN API
    const res = await fetch('/auth/api/register/send-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ HoTen, UserName, Email, Password, ConfirmPassword })
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById('step1').classList.add('d-none');
      document.getElementById('step2').classList.remove('d-none');
      document.getElementById('emailDisplay').textContent = Email;
      document.getElementById('s2dot').className = 'step-dot';
      document.getElementById('s2ind').className = 'step-item active';
      document.getElementById('sline').className = 'step-line done';
      showAlert(data.message, 'success');
    } else {
      showAlert(data.message, 'danger');
    }
  } catch (e) {
    showAlert('Lỗi kết nối. Vui lòng thử lại.', 'danger');
  } finally {
    document.getElementById('sendBtnText').classList.remove('d-none');
    document.getElementById('sendBtnLoading').classList.add('d-none');
    document.getElementById('sendCodeBtn').disabled = false;
  }
}

async function verifyCode() {
  const Code = document.getElementById('otpInput').value.trim();
  if (!Code || Code.length !== 6)
    return showAlert('Vui lòng nhập mã OTP 6 chữ số', 'danger');

  document.getElementById('verifyBtnText').classList.add('d-none');
  document.getElementById('verifyBtnLoading').classList.remove('d-none');
  document.getElementById('verifyBtn').disabled = true;

  try {
    // FIX ĐƯỜNG DẪN FETCH CHUẨN API
    const res = await fetch('/auth/api/register/verify-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ Code })
    });
    const data = await res.json();
    if (data.success) {
      showAlert(data.message, 'success');
      setTimeout(() => { window.location.href = '/auth/login'; }, 1500);
    } else {
      showAlert(data.message, 'danger');
    }
  } catch (e) {
    showAlert('Lỗi kết nối. Vui lòng thử lại.', 'danger');
  } finally {
    document.getElementById('verifyBtnText').classList.remove('d-none');
    document.getElementById('verifyBtnLoading').classList.add('d-none');
    document.getElementById('verifyBtn').disabled = false;
  }
}

function goBack() {
  document.getElementById('step2').classList.add('d-none');
  document.getElementById('step1').classList.remove('d-none');
  document.getElementById('alertArea').innerHTML = '';
  document.getElementById('s2dot').className = 'step-dot inactive';
  document.getElementById('s2ind').className = 'step-item';
  document.getElementById('sline').className = 'step-line';
}

document.addEventListener('DOMContentLoaded', () => {
  const otp = document.getElementById('otpInput');
  if (otp) {
    otp.addEventListener('input', () => { otp.value = otp.value.replace(/\D/g,'').slice(0,6); });
    otp.addEventListener('keydown', e => { if(e.key==='Enter') verifyCode(); });
  }
});
</script>