<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div class="hc-auth-page">
  <div class="hc-auth-card">
    <div class="auth-header">
      <a href="/" class="auth-brand">
        <div class="auth-brand-icon"><i class="fas fa-home"></i></div>
        <span>HomeConnect</span>
      </a>
      <h2 class="auth-title">Chào mừng trở lại</h2>
      <p class="auth-sub">Đăng nhập để tiếp tục khám phá căn hộ</p>
    </div>

    <div id="loginAlertArea"></div>

    <form id="loginForm" class="auth-form" onsubmit="submitLogin(event)">
      <div class="auth-field">
        <label class="auth-label">Email / Tên đăng nhập / SĐT</label>
        <div class="auth-input-wrap">
          <i class="fas fa-user auth-input-icon"></i>
          <input type="text" id="email" name="email" class="auth-input" placeholder="Nhập email hoặc tên đăng nhập" required autofocus>
        </div>
      </div>
      <div class="auth-field">
        <label class="auth-label">Mật khẩu</label>
        <div class="auth-input-wrap">
          <i class="fas fa-lock auth-input-icon"></i>
          <input type="password" id="password" name="password" class="auth-input" placeholder="Nhập mật khẩu" required style="padding-right:48px;">
          <button type="button" class="auth-eye-btn" onclick="togglePwd()" tabindex="-1"><i class="fas fa-eye" id="eyeIcon"></i></button>
        </div>
      </div>
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;">
        <label style="display:flex;align-items:center;gap:8px;font-size:.82rem;color:var(--text-secondary);cursor:pointer;">
          <input type="checkbox" style="accent-color:var(--primary);width:14px;height:14px;"> Ghi nhớ đăng nhập
        </label>
        <a href="/auth/forgot-password" style="font-size:.82rem;color:var(--primary);text-decoration:none;">Quên mật khẩu?</a>
      </div>
      <button type="submit" id="btnLogin" class="btn-hc-primary w-100" style="justify-content:center;padding:13px;font-size:.9rem;">
        <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
      </button>
    </form>

    <div class="auth-divider"><span>hoặc</span></div>

    <a href="/auth/google" class="auth-social-btn">
      <img src="https://www.google.com/favicon.ico" width="18" alt="Google"> Đăng nhập với Google
    </a>

    <div class="auth-footer-link">
      Chưa có tài khoản? <a href="/auth/register">Đăng ký miễn phí</a>
    </div>
  </div>
</div>

<style>
.hc-auth-page { min-height:calc(100vh - var(--navbar-h)); display:flex; align-items:center; justify-content:center;
  padding:32px 16px; background:linear-gradient(135deg,#f0f4ff 0%,#e8f0fe 50%,#f4f0ff 100%); }
.hc-auth-card { background:var(--bg-white); border-radius:var(--radius-xl,24px); box-shadow:var(--shadow-lg,0 20px 60px rgba(26,32,64,.12));
  padding:40px 36px; width:100%; max-width:440px; border:1px solid var(--border-light); }
.auth-header { text-align:center; margin-bottom:28px; }
.auth-brand { display:inline-flex; align-items:center; gap:10px; text-decoration:none; margin-bottom:20px; }
.auth-brand-icon { width:40px; height:40px; background:linear-gradient(135deg,var(--primary),#4f46e5); border-radius:10px;
  display:flex; align-items:center; justify-content:center; color:white; font-size:1rem; }
.auth-brand span { font-size:1.1rem; font-weight:800; color:var(--text); }
.auth-title { font-size:1.4rem; font-weight:800; color:var(--text); margin:0 0 6px; }
.auth-sub { font-size:.85rem; color:var(--text-muted); margin:0; }
.auth-alert { padding:12px 16px; border-radius:var(--radius-md); font-size:.875rem; margin-bottom:16px; display:flex; align-items:center; }
.auth-alert-danger { background:#fef2f2; color:#b91c1c; border:1px solid #fecaca; }
.auth-form { display:flex; flex-direction:column; }
.auth-field { margin-bottom:16px; }
.auth-label { display:block; font-size:.78rem; font-weight:600; color:var(--text-secondary); margin-bottom:6px; text-transform:uppercase; letter-spacing:.04em; }
.auth-input-wrap { position:relative; }
.auth-input-icon { position:absolute; left:14px; top:50%; transform:translateY(-50%); color:var(--text-muted); font-size:.85rem; pointer-events:none; }
.auth-input { width:100%; padding:12px 14px 12px 40px; border:1.5px solid var(--border); border-radius:var(--radius-md);
  font-size:.875rem; color:var(--text); background:var(--bg-white); outline:none; transition:border-color .2s, box-shadow .2s; }
.auth-input:focus { border-color:var(--primary); box-shadow:0 0 0 3px rgba(0,97,255,.1); }
.auth-eye-btn { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none;
  color:var(--text-muted); cursor:pointer; padding:4px; font-size:.85rem; }
.auth-divider { display:flex; align-items:center; gap:12px; color:var(--text-muted); font-size:.8rem; margin:20px 0; }
.auth-divider::before, .auth-divider::after { content:''; flex:1; height:1px; background:var(--border-light); }
.auth-social-btn { display:flex; align-items:center; justify-content:center; gap:10px; width:100%; padding:12px;
  border:1.5px solid var(--border); border-radius:var(--radius-md); background:var(--bg-white); color:var(--text);
  font-size:.875rem; font-weight:600; text-decoration:none; transition:border-color .2s, box-shadow .2s; }
.auth-social-btn:hover { border-color:var(--primary); box-shadow:0 2px 8px rgba(0,97,255,.1); }
.auth-footer-link { text-align:center; margin-top:20px; font-size:.85rem; color:var(--text-muted); }
.auth-footer-link a { color:var(--primary); font-weight:600; text-decoration:none; }
.auth-footer-link a:hover { text-decoration:underline; }
</style>

<script>
function togglePwd() {
  const f = document.getElementById('password');
  const e = document.getElementById('eyeIcon');
  f.type = f.type === 'password' ? 'text' : 'password';
  e.className = f.type === 'password' ? 'fas fa-eye' : 'fas fa-eye-slash';
}

// XỬ LÝ ĐĂNG NHẬP QUA FETCH API
async function submitLogin(e) {
    e.preventDefault();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;
    const btn = document.getElementById('btnLogin');
    const alertArea = document.getElementById('loginAlertArea');

    if(!email || !password) return;

    btn.innerHTML = '<i class="fas fa-circle-notch fa-spin me-2"></i>Đang đăng nhập...';
    btn.disabled = true;
    alertArea.innerHTML = '';

    try {
        const res = await fetch('/auth/api/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
        });
        
        const data = await res.json();

        if (data.success) {
            Swal.fire({ toast: true, position: 'top-end', icon: 'success', title: data.message, showConfirmButton: false, timer: 1500 });
            setTimeout(() => { window.location.href = data.redirectUrl || '/'; }, 1000);
        } else {
            alertArea.innerHTML = `<div class="auth-alert auth-alert-danger"><i class="fas fa-exclamation-circle me-2"></i>${data.message}</div>`;
            btn.innerHTML = '<i class="fas fa-sign-in-alt me-2"></i>Đăng nhập';
            btn.disabled = false;
        }
    } catch(err) {
        alertArea.innerHTML = `<div class="auth-alert auth-alert-danger"><i class="fas fa-exclamation-circle me-2"></i>Lỗi kết nối máy chủ!</div>`;
        btn.innerHTML = '<i class="fas fa-sign-in-alt me-2"></i>Đăng nhập';
        btn.disabled = false;
    }
}
</script>