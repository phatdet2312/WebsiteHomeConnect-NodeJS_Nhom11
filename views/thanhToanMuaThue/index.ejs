<!-- views/thanhToanMuaThue/index.ejs -->
<div style="background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:36px 0 28px;">
  <div class="container" style="max-width:960px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <h1 style="font-size:1.5rem;font-weight:800;color:white;margin:0 0 4px;"><i class="fas fa-credit-card me-3" style="opacity:.8;"></i>Thanh toán đặt hàng</h1>
        <p style="color:rgba(255,255,255,.7);margin:0;font-size:.875rem;">Xác nhận và hoàn tất đặt mua/thuê căn hộ</p>
      </div>
      <a href="/gio-hang" class="btn-ghost" style="color:white;border-color:rgba(255,255,255,.4);font-size:.82rem;">
        <i class="fas fa-arrow-left me-2"></i>Giỏ hàng
      </a>
    </div>
  </div>
</div>

<div class="container py-4" style="max-width:960px;">
  <div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải...</p></div>
  </div>
  <div id="errorState" class="hc-toast hc-toast-danger d-none" style="position:static;margin-bottom:16px;"></div>
  <div id="emptyState" class="d-none">
    <div class="hc-empty">
      <div class="empty-icon"><i class="fas fa-shopping-cart"></i></div>
      <div class="empty-title">Giỏ hàng trống</div>
      <div class="empty-desc">Chưa có căn hộ nào trong giỏ hàng</div>
      <a href="/kham-pha" class="btn-hc-primary mt-3" style="margin:12px auto 0;">Khám phá căn hộ</a>
    </div>
  </div>
  <div id="mainContent" class="row g-4 d-none">
    <!-- Order list -->
    <div class="col-lg-7">
      <div class="table-card">
        <div class="table-card-header">
          <div class="table-card-title"><i class="fas fa-list me-2" style="color:var(--primary);"></i>Đơn hàng của bạn</div>
        </div>
        <div style="padding:20px;" id="cartItems"></div>
        <div style="padding:14px 20px;border-top:2px solid var(--border-light);background:var(--bg-soft);display:flex;justify-content:space-between;align-items:center;">
          <span style="font-size:.875rem;font-weight:700;color:var(--text);" id="cartSummary">Tổng cộng (0 căn hộ)</span>
          <span style="font-size:1.2rem;font-weight:800;color:var(--primary);" id="cartTotal"></span>
        </div>
      </div>
    </div>
    <!-- Payment sidebar -->
    <div class="col-lg-5">
      <div style="background:var(--bg-white);border-radius:var(--radius-lg);border:1px solid var(--border-light);box-shadow:var(--shadow-md);padding:24px;position:sticky;top:80px;">
        <div style="font-size:.95rem;font-weight:700;color:var(--text);margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border-light);">
          <i class="fas fa-wallet me-2" style="color:var(--primary);"></i>Phương thức thanh toán
        </div>
        <div id="ptttList" style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;"></div>
        <div style="background:#fffbeb;border:1px solid #fde68a;border-radius:var(--radius-md);padding:12px;font-size:.8rem;color:#92400e;margin-bottom:16px;display:flex;align-items:flex-start;gap:8px;">
          <i class="fas fa-info-circle" style="margin-top:1px;flex-shrink:0;"></i>
          Hợp đồng sẽ được tạo sau khi thanh toán được xác nhận.
        </div>
        <div id="alertArea" style="margin-bottom:12px;"></div>
        <button class="btn-hc-primary w-100" style="justify-content:center;padding:13px;font-size:.9rem;" onclick="doCheckout()">
          <i class="fas fa-check-circle me-2"></i>Xác nhận đặt hàng
        </button>
      </div>
    </div>
  </div>
</div>

<style>
.table-card { background:var(--bg-white); border-radius:var(--radius-lg); border:1px solid var(--border-light); box-shadow:var(--shadow-sm); overflow:hidden; }
.table-card-header { padding:16px 20px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border-light); background:var(--bg-soft); }
.table-card-title { font-size:.92rem; font-weight:700; color:var(--text); }
.order-item { display:flex; align-items:center; gap:14px; padding-bottom:14px; margin-bottom:14px; border-bottom:1px solid var(--border-light); }
.order-item:last-child { border-bottom:none; padding-bottom:0; margin-bottom:0; }
.order-img { width:70px; height:52px; object-fit:cover; border-radius:8px; flex-shrink:0; }
.order-img-ph { width:70px; height:52px; background:var(--bg); border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--border); flex-shrink:0; }
.order-badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.7rem; font-weight:700; }
.pt-option { display:flex; align-items:center; gap:12px; padding:12px 14px; border-radius:var(--radius-md); border:1.5px solid var(--border); cursor:pointer; transition:var(--transition-fast); }
.pt-option:has(input:checked) { border-color:var(--primary); background:var(--primary-light); }
.pt-option:hover { border-color:var(--primary); }
</style>

<script>
let cartItems = [];
function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

fetch('/thanh-toan-mua-thue/api/items')
  .then(r=>{ if(r.status===401){window.location.href='/auth/login';return null;} return r.json(); })
  .then(data=>{
    if(!data) return;
    document.getElementById('loadingState').classList.add('d-none');
    if(!data.cart||!data.cart.length){ document.getElementById('emptyState').classList.remove('d-none'); return; }
    cartItems = data.cart;
    let total = 0;
    document.getElementById('cartItems').innerHTML = data.cart.map(item=>{
      total += (item.Gia||0);
      const imgHtml = item.UrlAnh
        ? `<img src="${esc(item.UrlAnh)}" class="order-img" alt="">`
        : `<div class="order-img-ph"><i class="fas fa-home"></i></div>`;
      const badge = item.loai==='mua'
        ? `<span class="order-badge" style="background:var(--primary-light);color:var(--primary);">Mua</span>`
        : `<span class="order-badge" style="background:#dcfce7;color:#15803d;">Thuê</span>`;
      const gia = item.Gia ? Number(item.Gia).toLocaleString('vi-VN')+'đ' : 'Liên hệ';
      return `<div class="order-item">
        ${imgHtml}
        <div style="flex:1;min-width:0;">
          <div style="font-weight:600;font-size:.875rem;margin-bottom:4px;">${esc(item.TenCanHo)}</div>
          <div style="font-size:.78rem;color:var(--text-muted);">${item.ToaNha?'<i class="fas fa-building me-1"></i>'+esc(item.ToaNha):''}${item.Tang?' · Tầng '+esc(item.Tang):''}</div>
        </div>
        <div style="text-align:right;flex-shrink:0;">${badge}<div style="font-size:.9rem;font-weight:700;color:var(--primary);margin-top:4px;">${gia}</div></div>
      </div>`;
    }).join('');
    document.getElementById('cartSummary').textContent = 'Tổng cộng ('+data.cart.length+' căn hộ)';
    document.getElementById('cartTotal').textContent = total ? Number(total).toLocaleString('vi-VN')+'đ' : '';
    document.getElementById('ptttList').innerHTML = data.pttts.map(pt=>{
      const name = (pt.TenPT||'').toLowerCase();
      const icon = name.includes('vnpay') ? 'fa-qrcode' : name.includes('tiền mặt')||name.includes('cash') ? 'fa-money-bill-wave' : 'fa-credit-card';
      const sub = name.includes('vnpay') ? 'Thanh toán trực tuyến an toàn' : name.includes('cash')||name.includes('tiền mặt') ? 'Thanh toán tại quầy' : '';
      return `<label class="pt-option"><input type="radio" name="paymentMethod" value="${pt.MaPT}" data-name="${esc(pt.TenPT)}" style="accent-color:var(--primary);flex-shrink:0;"><i class="fas ${icon}" style="color:var(--primary);font-size:1.1rem;flex-shrink:0;"></i><div><div style="font-weight:600;font-size:.875rem;">${esc(pt.TenPT)}</div>${sub?`<div style="font-size:.72rem;color:var(--text-muted);">${sub}</div>`:''}</div></label>`;
    }).join('');
    document.getElementById('mainContent').classList.remove('d-none');
  })
  .catch(()=>{
    document.getElementById('loadingState').classList.add('d-none');
    const e = document.getElementById('errorState');
    e.innerHTML = '<i class="fas fa-exclamation-circle" style="color:var(--danger);"></i><span>Lỗi tải dữ liệu</span>';
    e.classList.remove('d-none');
  });

async function doCheckout(){
  const ptEl = document.querySelector('[name=paymentMethod]:checked');
  if(!ptEl) return alert('Vui lòng chọn phương thức thanh toán!');
  const isVnpay = ptEl.dataset.name&&ptEl.dataset.name.toLowerCase().includes('vnpay');
  try{
    const res = await fetch('/thanh-toan-mua-thue/xac-nhan',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({MaPT:ptEl.value,items:cartItems,paymentMethod:isVnpay?'vnpay':'direct'})});
    const data = await res.json();
    if(data.success){
      if(data.redirect){ window.location.href=data.redirect; return; }
      location.href='/gio-hang/order-completed';
    } else {
      document.getElementById('alertArea').innerHTML=`<div class="hc-toast hc-toast-danger" style="position:static;"><i class="fas fa-exclamation-circle" style="color:var(--danger);"></i><span>${esc(data.error||'Lỗi xảy ra!')}</span></div>`;
    }
  }catch(e){ alert('Lỗi kết nối!'); }
}
</script>
