<div style="background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:48px 0 36px;">
  <div class="container text-center">
    <div style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);border-radius:20px;padding:5px 16px;color:rgba(255,255,255,.9);font-size:.78rem;font-weight:700;margin-bottom:16px;letter-spacing:.04em;">
      <i class="fas fa-file-contract"></i> QUẢN LÝ HỢP ĐỒNG
    </div>
    <h1 style="font-size:2.2rem;font-weight:800;color:white;margin:0 0 16px;">Hợp đồng & Thanh toán</h1>
    
    <div style="margin-top: 24px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
        <a href="/hoa-don-hop-dong" class="btn btn-light px-4 py-2" style="border-radius: 12px; font-weight: 800; color: #0061ff; box-shadow: 0 4px 15px rgba(0,0,0,0.15); text-decoration: none; display: inline-flex; align-items: center; font-size: 1rem;">
            <i class="fas fa-history me-2"></i> Lịch sử & Hóa đơn Hợp đồng
        </a>
    </div>
  </div>
</div>

<div class="container py-5">
  <div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải dữ liệu...</p></div>
  </div>
  <div id="contractList" class="row g-4 d-none"></div>
</div>

<style>
.svc-card { background:var(--bg-white); border-radius:var(--radius-lg); border:1px solid var(--border-light); box-shadow:var(--shadow-sm); padding:28px 24px; transition:all .3s ease; height:100%; display:flex; flex-direction:column; position:relative; cursor:pointer; text-decoration:none; color:inherit; }
.svc-card:hover { transform:translateY(-5px); box-shadow:var(--shadow-lg); border-color:var(--primary); }
.svc-icon { width:64px; height:64px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:1.8rem; margin-bottom:18px; flex-shrink:0; background:var(--primary-light); color:var(--primary); }
.svc-icon img { width:100%; height:100%; object-fit:cover; border-radius:16px; }
.svc-name { font-size:1.1rem; font-weight:800; color:var(--text); margin-bottom:8px; }
.svc-action { display:inline-flex; align-items:center; gap:6px; color:var(--primary); font-size:.85rem; font-weight:700; margin-top:auto; padding-top:16px; }
.badge-pulse { position:absolute; top:20px; right:20px; background:#ef4444; color:white; font-size:.75rem; font-weight:800; padding:4px 12px; border-radius:20px; animation: pulse 2s infinite; box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
@keyframes pulse { 0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); } 70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); } 100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); } }
</style>

<script>
fetch('/hoa-don-hop-dong/api/danh-sach')
  .then(r => { if(r.status===401 || r.status===403) window.location.href='/auth/login'; return r.json(); })
  .then(res => {
    document.getElementById('loadingState').classList.add('d-none');
    const el = document.getElementById('contractList');
    el.classList.remove('d-none');
    
    if(!res.data || !res.data.length){
      el.innerHTML = `<div class="col-12"><div class="hc-empty"><div class="empty-icon"><i class="fas fa-file-contract"></i></div><div class="empty-title">Chưa có loại thanh toán hợp đồng nào được kích hoạt.</div></div></div>`;
      return;
    }

    el.innerHTML = res.data.map(loai => `
      <div class="col-sm-6 col-lg-4">
        <a href="/hoa-don-hop-dong/thanh-toan?maLoaiTT=${loai.maLoaiTT}" class="svc-card">
          ${loai.soKyNo > 0 ? `<div class="badge-pulse">${loai.soKyNo} khoản chưa thanh toán</div>` : ''}
          <div class="svc-icon">
            ${loai.urlIcon ? `<img src="${loai.urlIcon}" alt="icon">` : `<i class="fas fa-file-invoice"></i>`}
          </div>
          <div class="svc-name">${loai.tenLoaiTT}</div>
          <div class="svc-action">
             ${loai.soKyNo > 0 ? '<span style="color:#ef4444;"><i class="fas fa-exclamation-circle me-1"></i>Thanh toán ngay</span>' : '<i class="fas fa-arrow-right me-1"></i>Xem chi tiết'}
          </div>
        </a>
      </div>
    `).join('');
  })
  .catch(() => {
    document.getElementById('loadingState').innerHTML = `<div class="hc-empty"><div class="empty-icon"><i class="fas fa-exclamation-triangle text-danger"></i></div><div class="empty-title">Lỗi kết nối máy chủ</div></div>`;
  });
</script>