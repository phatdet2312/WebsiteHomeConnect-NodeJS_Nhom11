<!-- views/home/lienHe.ejs -->
<div class="container py-5" style="max-width:700px;">
  <div class="text-center mb-5">
    <h2 class="fw-bold"><i class="fas fa-envelope text-primary me-2"></i>Li&#234;n h&#7879; v&#7899;i ch&#250;ng t&#244;i</h2>
    <p class="text-muted">Ch&#250;ng t&#244;i lu&#244;n s&#7861;n s&#224;ng h&#7895; tr&#7907; b&#7841;n</p>
  </div>

  <% if (typeof sent !== 'undefined' && sent) { %>
    <div class="alert alert-success text-center p-4 mb-4" style="border-radius:14px;">
      <i class="fas fa-check-circle fa-3x text-success mb-3 d-block"></i>
      <h5 class="fw-bold mb-1">G&#7917;i th&#224;nh c&#244;ng!</h5>
      <p class="mb-3">C&#7843;m &#417;n b&#7841;n &#273;&#227; li&#234;n h&#7879;. Ch&#250;ng t&#244;i s&#7869; ph&#7843;n h&#7891;i trong v&#242;ng 24 gi&#7901;.</p>
      <a href="/" class="btn btn-primary">V&#7873; trang ch&#7911;</a>
    </div>
  <% } else { %>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
    <% } %> 

    <div class="card border-0 shadow" style="border-radius:16px;">
      <div class="card-body p-4">
        <form method="POST" action="/lien-he">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label fw-semibold">H&#7885; v&#224; T&#234;n <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user"></i></span>
                <input type="text" name="HoTen" class="form-control" placeholder="Nguy&#7877;n V&#259;n A" required>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                <input type="email" name="Email" class="form-control" placeholder="email@example.com" required>
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">S&#7889; &#273;i&#7879;n tho&#7841;i</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                <input type="tel" name="SDT" class="form-control" placeholder="0912 345 678">
              </div>
            </div>
            <div class="col-md-6">
              <label class="form-label fw-semibold">Ti&#234;u &#273;&#7873; <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                <input type="text" name="TieuDe" class="form-control" placeholder="Ch&#7911; &#273;&#7873; tin nh&#7855;n" required>
              </div>
            </div>
            <div class="col-12">
              <label class="form-label fw-semibold">N&#7897;i dung <span class="text-danger">*</span></label>
              <textarea name="NoiDung" class="form-control" rows="5" placeholder="Nh&#7853;p n&#7897;i dung c&#7847;n h&#7895; tr&#7907;..." required style="border-radius:10px;"></textarea>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold" style="border-radius:10px;">
                <i class="fas fa-paper-plane me-2"></i>G&#7917;i tin nh&#7855;n
              </button>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Contact info -->
    <div class="row g-3 mt-3">
      <div class="col-md-4">
        <div class="card border-0 bg-light text-center p-3" style="border-radius:12px;">
          <i class="fas fa-map-marker-alt text-primary fa-2x mb-2"></i>
          <h6 class="fw-bold">&#272;&#7883;a ch&#7881;</h6>
          <p class="small text-muted mb-0">123 &#272;&#432;&#7901;ng ABC, Q.1, TP.HCM</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 bg-light text-center p-3" style="border-radius:12px;">
          <i class="fas fa-phone text-primary fa-2x mb-2"></i>
          <h6 class="fw-bold">Hotline</h6>
          <p class="small text-muted mb-0">1800 xxxx (mi&#7877;n ph&#237;)</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="card border-0 bg-light text-center p-3" style="border-radius:12px;">
          <i class="fas fa-envelope text-primary fa-2x mb-2"></i>
          <h6 class="fw-bold">Email</h6>
          <p class="small text-muted mb-0">support@homeconnect.vn</p>
        </div>
      </div>
    </div>
  <% } %>
</div>
