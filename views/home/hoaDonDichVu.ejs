<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<div style="background:linear-gradient(135deg,var(--primary-dark),var(--primary));padding:36px 0 28px;">
  <div class="container" style="max-width:1100px;">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
      <div>
        <h1 style="font-size:1.6rem;font-weight:800;color:white;margin:0 0 4px;"><i class="fas fa-file-invoice-dollar me-3" style="opacity:.8;"></i>Hóa đơn dịch vụ</h1>
        <p style="color:rgba(255,255,255,.7);margin:0;font-size:.875rem;">Lịch sử giao dịch thanh toán dịch vụ của bạn</p>
      </div>
      <a href="/dich-vu" class="btn-hc-primary" style="font-size:.875rem;padding:10px 20px;">
        <i class="fas fa-search me-2"></i>Khám phá thêm dịch vụ
      </a>
    </div>
  </div>
</div>

<div class="container py-4" style="max-width:1100px;">
  <div id="loadingState" class="text-center py-5">
    <div class="hc-loading"><div class="hc-spinner"></div><p>Đang tải lịch sử hóa đơn...</p></div>
  </div>
  
  <div id="invoiceList" class="d-none" style="display:flex;flex-direction:column;gap:20px;"></div>
</div>

<style>
.invoice-card { background:var(--bg-white); border-radius:var(--radius-lg); border:1px solid var(--border-light); box-shadow:var(--shadow-sm); overflow:hidden; transition:var(--transition-fast); }
.invoice-card:hover { box-shadow:var(--shadow-md); border-color:var(--primary); }
.invoice-header { padding:20px 24px; display:flex; align-items:center; justify-content:space-between; border-bottom:1px solid var(--border-light); background:var(--bg-soft); flex-wrap:wrap; gap:10px; cursor:pointer; }
.invoice-id { font-size:1.1rem; font-weight:800; color:var(--primary); margin-bottom:4px; }
.invoice-date { font-size:.85rem; color:var(--text-muted); font-weight:500; }
.status-pill { display:inline-block; padding:4px 12px; border-radius:20px; font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.02em; }
.status-ok { background:#dcfce7; color:#15803d; }
.status-wait { background:#fef9c3; color:#a16207; }
.status-fail { background:#fee2e2; color:#b91c1c; }
.invoice-body { padding:24px; display:none; } /* Ẩn mặc định, dùng JS slideDown */
.invoice-table { width:100%; border-collapse:collapse; font-size:.9rem; }
.invoice-table th { font-weight:700; color:var(--text-muted); padding:10px; border-bottom:2px solid var(--border-light); text-align:left; }
.invoice-table td { padding:12px 10px; border-bottom:1px solid var(--border-light); color:var(--text); font-weight:500; }
.timeline-item { position:relative; padding-left:24px; margin-bottom:16px; }
.timeline-item::before { content:''; position:absolute; left:0; top:6px; width:12px; height:12px; border-radius:50%; background:var(--primary); border:2px solid var(--primary-light); }
.timeline-item::after { content:''; position:absolute; left:5px; top:20px; bottom:-16px; width:2px; background:var(--border-light); }
.timeline-item:last-child::after { display:none; }
.timeline-time { font-size:.75rem; color:var(--text-muted); margin-bottom:2px; font-weight:600; }
.timeline-status { font-weight:800; color:var(--text); font-size:.9rem; }
.timeline-note { font-size:.8rem; color:var(--text-secondary); margin-top:2px; }
</style>

<script>
fetch('/hoa-don-dich-vu/api/history')
  .then(r => r.json())
  .then(res => {
    document.getElementById('loadingState').classList.add('d-none');
    const el = document.getElementById('invoiceList');
    el.classList.remove('d-none');

    if(!res.success || !res.data.length){
      el.innerHTML = `<div class="hc-empty"><div class="empty-icon"><i class="fas fa-file-invoice"></i></div><div class="empty-title">Bạn chưa có hóa đơn dịch vụ nào.</div></div>`;
      return;
    }

    el.innerHTML = res.data.map((hd, idx) => {
        let statusClass = 'status-wait';
        if(hd.trangThaiHienTai.toLowerCase().includes('đã thanh toán')) statusClass = 'status-ok';
        else if(hd.trangThaiHienTai.toLowerCase().includes('hủy') || hd.trangThaiHienTai.toLowerCase().includes('thất bại')) statusClass = 'status-fail';

        const trs = hd.chiTiet.map(ct => `
            <tr>
                <td>${ct.tenDV} <br><small style="color:#64748b">${hd.viTriDaiDien}</small></td>
                <td>${ct.tenKy}</td>
                <td style="text-align:center;">${ct.sl}</td>
                <td style="text-align:right;font-weight:700;">${Number(ct.donGia).toLocaleString('vi-VN')} ₫</td>
            </tr>
        `).join('');

        const timeline = hd.lichSu.map(ls => `
            <div class="timeline-item">
                <div class="timeline-time">${new Date(ls.thoiGian).toLocaleString('vi-VN')}</div>
                <div class="timeline-status">${ls.trangThai}</div>
                ${ls.ghiChu ? `<div class="timeline-note"><i class="fas fa-comment-dots me-1"></i>${ls.ghiChu}</div>` : ''}
            </div>
        `).join('');

        return `
        <div class="invoice-card">
            <div class="invoice-header" onclick="$('#body_${idx}').slideToggle()">
                <div style="display:flex;align-items:center;gap:20px;">
                    <div>
                        <div class="invoice-id">HÓA ĐƠN #${hd.maHDDV}</div>
                        <div class="invoice-date"><i class="fas fa-clock me-2"></i>Lập lúc: ${new Date(hd.ngayThanhToan).toLocaleString('vi-VN')}</div>
                    </div>
                </div>
                <div style="text-align:right;">
                    <div style="font-size:1.3rem;font-weight:900;color:var(--text);margin-bottom:6px;">${hd.tongTien.toLocaleString('vi-VN')} ₫</div>
                    <span class="status-pill ${statusClass}">${hd.trangThaiHienTai}</span>
                </div>
            </div>
            
            <div class="invoice-body" id="body_${idx}">
                <div class="row">
                    <div class="col-md-8 border-end">
                        <h6 style="font-weight:800;margin-bottom:16px;color:var(--primary);"><i class="fas fa-list-ul me-2"></i>Chi tiết thanh toán</h6>
                        <table class="invoice-table">
                            <thead><tr><th>Dịch vụ</th><th>Kỳ</th><th style="text-align:center;">SL</th><th style="text-align:right;">Thành tiền</th></tr></thead>
                            <tbody>${trs}</tbody>
                        </table>
                        <div style="margin-top:16px;font-size:.85rem;color:var(--text-muted);">
                            <strong>Phương thức thanh toán:</strong> ${hd.phuongThuc}
                        </div>
                    </div>
                    <div class="col-md-4 ps-md-4 mt-4 mt-md-0">
                        <h6 style="font-weight:800;margin-bottom:16px;color:var(--primary);"><i class="fas fa-history me-2"></i>Tiến trình</h6>
                        ${timeline}
                    </div>
                </div>
            </div>
        </div>
        `;
    }).join('');
  });
</script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>