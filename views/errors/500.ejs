
<!-- views/errors/500.ejs -->

<div class="container text-center" style="margin-top: 80px; margin-bottom: 80px;">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <div style="font-size: 8rem; font-weight: 900; color: #c62828; line-height:1; opacity:.12;">500</div>
